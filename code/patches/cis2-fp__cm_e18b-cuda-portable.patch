+                  $(GPU)/cis2_fpenv.h $(GPU)/cis2_sha256.h $(GPU)/cis2_consts.inc
 	$(LOCK) $(NVCC) $(NVCCFLAGS) -o $(GPU)/cis2_cuda $(GPU)/cis2_host.cpp
 
+## §1.4 device analogue of `nofma` — NOT a whole-binary zero count. Unlike
+## x86 SSE (DIVSS/SQRTSS are single correctly-rounded hardware
+## instructions), NVIDIA GPUs have no correctly-rounded divide or sqrt
+## instruction at all: -prec-div=true/-prec-sqrt=true (which this port
+## requires — see cis2_math.h §6.1) make nvcc emit a software
+## Newton-Raphson refinement (MUFU.RCP/RCP64H seed + FFMA/DFMA correction
+## steps) to get there. That FMA is load-bearing precision machinery
+## *inside a single correctly-rounded primitive*, not contraction of this
+## port's own two-step "multiply, then separately-rounded add" statements
+## (cis2_dot_seq, the Horner loops in exp/ln, rmsnorm's (x*inv)*w). Verified
+## by inspection (gpu/README.md "device build" section): FFMA/DFMA appear
+## ONLY inside the four kernels that call a division or cis2_rsqrt_cr
+## (cis2_rmsnorm's reduction kernel, cis2_k_softmax, cis2_k_silu_mul,
+## cis2_k_rope via reduce_pi_2's f64 divide) — never in cis2_k_matvec,
+## cis2_k_scores, cis2_k_attn_weighted_sum, cis2_k_add, cis2_k_add_bias,
+## cis2_k_embed or cis2_k_store_kv, which is where source-level contraction
+## would show up if -fmad=false were not doing its job. This target checks
+## exactly that: those 7 division/sqrt-free kernels must have ZERO
+## FFMA/DFMA, in both target architectures' SASS.
+NOFMA_CUDA_KERNELS := cis2_k_matvec cis2_k_scores cis2_k_attn_weighted_sum \
+                      cis2_k_add cis2_k_add_bias cis2_k_embed cis2_k_store_kv
+nofma-cuda: $(GPU)/cis2_cuda
+	@for a in sm_60 sm_75; do \
+	  cuobjdump --dump-sass -arch $$a $(GPU)/cis2_cuda 2>/dev/null > $(SCRATCH)/sass-$$a.txt; \
+	  for k in $(NOFMA_CUDA_KERNELS); do \
+	    n=$$(awk -v pat="$$k" '/Function :/{f=($$0 ~ pat)} f && /FFMA|DFMA/{c++} END{print c+0}' $(SCRATCH)/sass-$$a.txt); \
+	    echo "$$a $$k: FMA instructions = $$n"; \
+	    if [ "$$n" != "0" ]; then echo "GATE FAIL: FMA contraction in $$k ($$a)"; exit 1; fi; \
+	  done; \
+	done
+	@echo "no-FMA (device, contraction-only) gate: PASS"
+
 test_math: $(GPU)/test_math
 $(GPU)/test_math: $(GPU)/test_math.cpp $(GPU)/cis2_math.h $(GPU)/cis2_fpenv.h \
