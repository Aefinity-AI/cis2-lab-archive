diff --git a/gpu/kaggle_gpu3/overlay_staging/test_batch.cpp b/gpu/kaggle_gpu3/overlay_staging/test_batch.cpp
new file mode 100644
index 0000000..5f9bea6
--- /dev/null
+++ b/gpu/kaggle_gpu3/overlay_staging/test_batch.cpp
@@ -0,0 +1,187 @@
+// gpu/test_batch.cpp — gpu2 (QUEUE gpu-2) step 2 check: row-batch matmul
+// (case 1, cis2_matmul_batched_seq) must be digest-identical to B
+// sequential batch=1 cis2_dot_seq calls over the same rows. This is a
+// CPU-only, no-GPU, no-model-weights check -- see
+// gpu/kaggle_gpu2/BATCH_INT8_DESIGN.md step 2. A MISMATCH here would be
+// surprising (no new arithmetic is introduced) but is reported honestly
+// either way, never assumed.
+//
+// Built with -DCIS2_BATCH_GROUPED (see the `test_batch_grouped` Makefile
+// target), this same binary ALSO exercises step 3's grouped/strided-
+// reduction path (case 2, cis2_matmul_batched_grouped) and reports its
+// digest against both the batch=1 sequential reference and step 2's
+// row-batch digest, honestly, without failing the build either way.
+//
+// Built with -DCIS2_BATCH_INT8 (see the `test_batch_int8` Makefile
+// target), this same binary ALSO exercises step 4's int8 weight
+// quantization path (per-output-channel symmetric, on-the-fly dequant,
+// cis2_matmul_batched_int8) and reports its digest against the fp32
+// batch=1 sequential reference, honestly, without failing the build
+// either way.
+//
+// Deterministic pseudo-random inputs (xorshift32, fixed seed) stand in
+// for "prompt rows" / "weight rows"; this test does not load real model
+// weights and is NOT the batch1_fp32 CPU/GPU anchor digest from
+// gpu/EXPECTED_DIGESTS.md -- it isolates the *batching* arithmetic only.
+
+#include "cis2_fpenv.h"
+#include "cis2_math.h"
+#include "cis2_sha256.h"
+
+#include <cstdio>
+#include <cstdint>
+#include <vector>
+
+static uint32_t g_state = 0x9E3779B9u;
+static uint32_t xorshift32() {
+  uint32_t x = g_state;
+  x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+  g_state = x;
+  return x;
+}
+// Map to a modest-magnitude float so dot products stay finite/normal.
+static float rand_float() {
+  int32_t bits = (int32_t)(xorshift32() & 0xFFFFFF);  // 24-bit magnitude
+  return ((float)bits / (float)0xFFFFFF) * 4.0f - 2.0f;  // [-2, 2)
+}
+
+int main() {
+  cis2_fpenv_init();
+
+  const int B = 4;     // batch size under test (step 2: batch=4)
+  const int n = 37;    // output rows (weight matrix rows) -- irregular size
+  const int k = 129;   // reduction length -- irregular, not a power of 2
+
+  std::vector<float> x((size_t)B * k), w((size_t)n * k);
+  for (auto &v : x) v = rand_float();
+  for (auto &v : w) v = rand_float();
+
+  // Path A: the new batched wrapper.
+  std::vector<float> out_batched((size_t)B * n);
+  cis2_matmul_batched_seq(B, n, k, x.data(), w.data(), out_batched.data());
+
+  // Path B: B independent batch=1 calls (the existing, unmodified
+  // batch=1 code path invoked B times), same row order.
+  std::vector<float> out_seq((size_t)B * n);
+  for (int b = 0; b < B; ++b) {
+    for (int j = 0; j < n; ++j) {
+      out_seq[(size_t)b * n + j] =
+          cis2_dot_seq(x.data() + (size_t)b * k, w.data() + (size_t)j * k, k);
+    }
+  }
+
+  Cis2Sha256 ha, hb;
+  ha.update(out_batched.data(), out_batched.size() * sizeof(float));
+  hb.update(out_seq.data(), out_seq.size() * sizeof(float));
+  unsigned char da[32], db[32];
+  ha.finalize(da);
+  hb.finalize(db);
+  std::string hexa = cis2_hex(da, 32), hexb = cis2_hex(db, 32);
+
+  int n_diff = 0;
+  for (size_t i = 0; i < out_batched.size(); ++i) {
+    if (out_batched[i] != out_seq[i]) ++n_diff;
+  }
+
+  printf("BATCH_TEST B=%d n=%d k=%d batched_digest=%s seq_digest=%s "
+         "bitwise_diffs=%d/%zu\n",
+         B, n, k, hexa.c_str(), hexb.c_str(), n_diff, out_batched.size());
+
+  int rc = 0;
+  if (hexa != hexb) {
+    printf("BATCH_TEST RESULT: MISMATCH\n");
+    rc = 1;
+  } else {
+    printf("BATCH_TEST RESULT: MATCH\n");
+  }
+
+#ifdef CIS2_BATCH_GROUPED
+  // gpu2 step 3 (case 2): grouped/strided-reduction path, built only under
+  // -DCIS2_BATCH_GROUPED (mirrors -DCIS2_REDUCTION_TREE gating). A
+  // MISMATCH here vs either reference is an expected, honestly-reported
+  // finding per BATCH_INT8_DESIGN.md step 3 -- it does NOT change this
+  // test's exit code, since it is not a failure of the step-2 check above.
+  std::vector<float> out_grouped((size_t)B * n);
+  cis2_matmul_batched_grouped(B, n, k, x.data(), w.data(), out_grouped.data());
+
+  Cis2Sha256 hc;
+  hc.update(out_grouped.data(), out_grouped.size() * sizeof(float));
+  unsigned char dc[32];
+  hc.finalize(dc);
+  std::string hexc = cis2_hex(dc, 32);
+
+  int n_diff_vs_seq = 0, n_diff_vs_batched = 0;
+  for (size_t i = 0; i < out_grouped.size(); ++i) {
+    if (out_grouped[i] != out_seq[i]) ++n_diff_vs_seq;
+    if (out_grouped[i] != out_batched[i]) ++n_diff_vs_batched;
+  }
+
+  printf("BATCH_GROUPED_TEST B=%d n=%d k=%d grouped_digest=%s "
+         "seq_digest=%s batched_digest=%s "
+         "bitwise_diffs_vs_seq=%d/%zu bitwise_diffs_vs_batched=%d/%zu\n",
+         B, n, k, hexc.c_str(), hexb.c_str(), hexa.c_str(), n_diff_vs_seq,
+         out_grouped.size(), n_diff_vs_batched, out_grouped.size());
+
+  if (hexc != hexb) {
+    printf("BATCH_GROUPED_TEST RESULT vs seq: MISMATCH\n");
+  } else {
+    printf("BATCH_GROUPED_TEST RESULT vs seq: MATCH\n");
+  }
+  if (hexc != hexa) {
+    printf("BATCH_GROUPED_TEST RESULT vs batched_seq: MISMATCH\n");
+  } else {
+    printf("BATCH_GROUPED_TEST RESULT vs batched_seq: MATCH\n");
+  }
+#endif  // CIS2_BATCH_GROUPED
+
+#ifdef CIS2_BATCH_INT8
+  // gpu2 step 4: int8 weight quantization (per-output-channel symmetric,
+  // on-the-fly dequant matmul) -- see BATCH_INT8_DESIGN.md step 4 and
+  // cis2_matmul_batched_int8's own doc comment in cis2_math.h. Quantizes
+  // the SAME weight matrix `w` used above, row by row, then runs the
+  // int8 matmul against the SAME activations `x` and compares against
+  // out_seq (the fp32 batch=1-equivalent reference computed above). A
+  // MISMATCH is expected a priori (quantization error) and is reported
+  // honestly either way -- this does not change this test's exit code.
+  std::vector<int8_t> w_i8((size_t)n * k);
+  std::vector<float> w_scale((size_t)n);
+  for (int j = 0; j < n; ++j) {
+    w_scale[j] = cis2_quantize_row_i8(w.data() + (size_t)j * k, k,
+                                       w_i8.data() + (size_t)j * k);
+  }
+
+  std::vector<float> out_int8((size_t)B * n);
+  cis2_matmul_batched_int8(B, n, k, x.data(), w_i8.data(), w_scale.data(),
+                            out_int8.data());
+
+  Cis2Sha256 hd;
+  hd.update(out_int8.data(), out_int8.size() * sizeof(float));
+  unsigned char dd[32];
+  hd.finalize(dd);
+  std::string hexd = cis2_hex(dd, 32);
+
+  int n_diff_int8 = 0;
+  double max_abs_diff = 0.0, sum_abs_diff = 0.0;
+  for (size_t i = 0; i < out_int8.size(); ++i) {
+    if (out_int8[i] != out_seq[i]) ++n_diff_int8;
+    double d = (double)out_int8[i] - (double)out_seq[i];
+    if (d < 0) d = -d;
+    if (d > max_abs_diff) max_abs_diff = d;
+    sum_abs_diff += d;
+  }
+  double mean_abs_diff = sum_abs_diff / (double)out_int8.size();
+
+  printf("BATCH_INT8_TEST B=%d n=%d k=%d int8_digest=%s seq_digest=%s "
+         "bitwise_diffs_vs_seq=%d/%zu max_abs_diff=%.8f mean_abs_diff=%.8f\n",
+         B, n, k, hexd.c_str(), hexb.c_str(), n_diff_int8, out_int8.size(),
+         max_abs_diff, mean_abs_diff);
+
+  if (hexd != hexb) {
+    printf("BATCH_INT8_TEST RESULT vs seq: MISMATCH\n");
+  } else {
+    printf("BATCH_INT8_TEST RESULT vs seq: MATCH\n");
+  }
+#endif  // CIS2_BATCH_INT8
+
+  return rc;
+}
diff --git a/gpu/kaggle_gpu3/overlay_staging/test_math.cpp b/gpu/kaggle_gpu3/overlay_staging/test_math.cpp
new file mode 100644
index 0000000..882342e
--- /dev/null
+++ b/gpu/kaggle_gpu3/overlay_staging/test_math.cpp
@@ -0,0 +1,114 @@
+// gpu/test_math.cpp — bit-exactness gate for gpu/cis2_math.h against the
+// Rust reference (src/math.rs) over a large deterministic input sweep.
+//
+// The sweep and its expected outputs are NOT hand-typed: they are produced
+// by `cargo run --release --bin math_dump`, which calls the very functions
+// in src/math.rs that the decode path uses, under the same pinned FTZ/DAZ
+// environment. This binary replays the recorded inputs through the C++
+// port and requires every result to be bit-identical.
+//
+// Golden file layout (little-endian):
+//   magic "CIS2MTH1" | u32 n_inputs | u32 n_funcs(=6)
+//   then n_inputs records of: u32 x_bits, u32 out_bits[6]
+//   function order: exp, sin, cos, ln, silu, rsqrt
+
+#include "cis2_fpenv.h"
+#include "cis2_math.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const char *kFuncNames[6] = {"exp_pinned", "sin_pinned",  "cos_pinned",
+                                    "ln_pinned",  "silu_pinned", "rsqrt_cr"};
+
+static float apply(int f, float x) {
+  switch (f) {
+    case 0: return cis2_exp_pinned(x);
+    case 1: return cis2_sin_pinned(x);
+    case 2: return cis2_cos_pinned(x);
+    case 3: return cis2_ln_pinned(x);
+    case 4: return cis2_silu_pinned(x);
+    default: return cis2_rsqrt_cr(x);
+  }
+}
+
+int main(int argc, char **argv) {
+  cis2_fpenv_init();
+
+  const char *path = (argc > 1) ? argv[1] : "gpu/math_golden.bin";
+  FILE *fp = fopen(path, "rb");
+  if (!fp) { fprintf(stderr, "cannot open golden file %s\n", path); return 2; }
+  fseek(fp, 0, SEEK_END);
+  long sz = ftell(fp);
+  fseek(fp, 0, SEEK_SET);
+  unsigned char *buf = (unsigned char *)malloc((size_t)sz);
+  if (fread(buf, 1, (size_t)sz, fp) != (size_t)sz) {
+    fprintf(stderr, "short read on %s\n", path); return 2;
+  }
+  fclose(fp);
+  if (sz < 16 || memcmp(buf, "CIS2MTH1", 8) != 0) {
+    fprintf(stderr, "bad magic in %s\n", path); return 2;
+  }
+  uint32_t n, nf;
+  memcpy(&n, buf + 8, 4);
+  memcpy(&nf, buf + 12, 4);
+  if (nf != 6 || (long)(16 + (size_t)n * 28) != sz) {
+    fprintf(stderr, "golden file shape mismatch (n=%u nf=%u sz=%ld)\n", n, nf, sz);
+    return 2;
+  }
+
+  // Regression check from §5.1: dot_seq is order-sensitive by design.
+  {
+    const float a[3] = {1.0e8f, 1.0f, -1.0e8f};
+    const float b[3] = {1.0f, 1.0f, 1.0f};
+    float got = cis2_dot_seq(a, b, 3);
+    if (cis2_f32_bits(got) != cis2_f32_bits(0.0f)) {
+      fprintf(stderr, "FAIL dot_seq order check: got bits 0x%08x, want 0x00000000\n",
+              cis2_f32_bits(got));
+      return 1;
+    }
+  }
+  // §4.1 widening spot checks (same three the Rust unit test uses).
+  if (cis2_f32_bits(cis2_widen_bf16(0x3F80)) != 0x3F800000u ||
+      cis2_f32_bits(cis2_widen_bf16(0x0000)) != 0x00000000u ||
+      cis2_f32_bits(cis2_widen_bf16(0x8000)) != 0x80000000u) {
+    fprintf(stderr, "FAIL widen_bf16 bit check\n");
+    return 1;
+  }
+
+  size_t fails[6] = {0, 0, 0, 0, 0, 0};
+  size_t total_fail = 0;
+  for (uint32_t i = 0; i < n; ++i) {
+    const unsigned char *rec = buf + 16 + (size_t)i * 28;
+    uint32_t xb; memcpy(&xb, rec, 4);
+    float x = cis2_f32_from_bits(xb);
+    for (int f = 0; f < 6; ++f) {
+      uint32_t want; memcpy(&want, rec + 4 + 4 * f, 4);
+      uint32_t got = cis2_f32_bits(apply(f, x));
+      if (got == want) continue;
+      // Both NaN counts as equal only if the bit patterns match too — the
+      // Rust side pins f32::NAN = 0x7FC00000 and so does the C++ port, so
+      // this is a strict bit comparison with no NaN escape hatch.
+      fails[f]++;
+      if (total_fail < 20) {
+        fprintf(stderr,
+                "MISMATCH %s(x=0x%08x = %.9g): got 0x%08x, rust 0x%08x\n",
+                kFuncNames[f], xb, (double)x, got, want);
+      }
+      total_fail++;
+    }
+  }
+
+  printf("test_math: %u inputs x 6 functions = %llu comparisons\n", n,
+         (unsigned long long)n * 6ull);
+  for (int f = 0; f < 6; ++f)
+    printf("  %-12s mismatches: %zu\n", kFuncNames[f], fails[f]);
+  free(buf);
+  if (total_fail) {
+    printf("test_math: FAIL (%zu mismatches)\n", total_fail);
+    return 1;
+  }
+  printf("test_math: PASS (bit-exact vs Rust src/math.rs)\n");
+  return 0;
+}
diff --git a/gpu/kaggle_gpu3/plan.py b/gpu/kaggle_gpu3/plan.py
new file mode 100644
index 0000000..aa9f947
--- /dev/null
+++ b/gpu/kaggle_gpu3/plan.py
@@ -0,0 +1,322 @@
+"""gpu-3k leg (QUEUE item gpu-3k): re-run gpu-3's whole-model row-batched
+forward pass (cis2_host.cpp's `--batch B` path, verified CPU-only on box1,
+see gpu/GPU3_RESULT.md) on a Kaggle Tesla T4, for B in {1, 4, 8}, once
+built by g++ (host) and once built+LINKED by nvcc (real device execution
+of cis2_model.h's CUDA kernels, `#if defined(__CUDACC__)` branch --
+cudaMalloc/cis2_index_kernel etc, not the compile-only object-file probe
+gpu/Makefile's `cuda`/`cuda-tree` targets use). Both binaries run the
+IDENTICAL --batch driver code in cis2_host.cpp; only the compiler /
+target differs (g++ host scalar vs nvcc device kernels).
+
+Reuses ../kaggle_gpu2/plan.py's patterns: find_dataset() (content-based
+mount discovery), nvcc_link() (a real linked executable), gpu_name_and_arch()
+(P100 sm_60 vs T4 sm_75), and the same NVCCFLAGS_BASE flag-for-flag EXCEPT
+-DCIS2_BATCH_GROUPED is dropped here: that macro only gates code in
+test_batch.cpp (gpu-2's grouped/int8 single-matmul sweep); cis2_host.cpp
+never references it, so passing it here would be a silent no-op that
+invites confusion, not a real flag match.
+
+Data sources:
+  - aefinityaiinc/cis2-e18b-gpu : weights/ (SmolLM2-135M) and
+    gate/ids_16tok.txt (4 real prompt ids: 6403 1980 253 655 -- the SAME
+    prompt gpu-3's box1 CPU run used).
+  - aefinityaiinc/gpu3-overlay  : v2 -- this branch's FULL gpu/
+    source snapshot (every *.h/*.cpp/*.inc/*.cu + Makefile), overlaid on
+    top of the base dataset's STALE gpu/ tree before any build, exactly
+    per this leg's brief.
+
+Exit status: 0 if all six runs (host x {1,4,8}, cuda x {1,4,8}) executed
+to a printed `==== gpu-3 --batch B: ... ====` verdict line; a MISMATCH in
+that verdict, or a host/cuda digest inequality, is a valid, honestly
+reported finding and does NOT change exit status -- only a build failure
+or a run that never reaches its verdict line does.
+"""
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+INPUT_ROOT = Path("/kaggle/input")
+WORK = Path("/kaggle/working/gpu3")
+GPU = WORK / "gpu"
+WEIGHTS = WORK / "weights"
+GATE = WORK / "gate"
+
+NVCC_ARCH = "sm_75"  # default T4; overridden to sm_60 if nvidia-smi reports P100
+NVCCFLAGS_BASE = [
+    "-x", "cu",
+    "-std=c++17", "-O2", "-fmad=false", "-ftz=true",
+    "-prec-div=true", "-prec-sqrt=true", "--extended-lambda",
+    "-DCIS2_CUDA_FTZ=1",
+]
+
+# Mirrors gpu/Makefile's GCCFLAGS_COMMON (x86_64 branch: -msse2 -mfpmath=sse)
+# for the `host-gcc` target, minus the -fexcess-precision=standard probe
+# (kept simple/portable here; -fno-fast-math + -ffp-contract=off are the
+# load-bearing flags for bit-parity, and this Kaggle image's g++ has been
+# verified to accept -fexcess-precision=standard in prior legs, added below
+# via a runtime probe identical in spirit to the Makefile's).
+GCCFLAGS_BASE = [
+    "-std=c++17", "-O2", "-ffp-contract=off", "-fno-fast-math",
+    "-msse2", "-mfpmath=sse",
+]
+
+
+def hr(title):
+    print("\n" + "=" * 72)
+    print(title)
+    print("=" * 72)
+
+
+def run(cmd, **kw):
+    print(f"$ {' '.join(str(c) for c in cmd)}")
+    try:
+        p = subprocess.run(cmd, capture_output=True, text=True, **kw)
+    except (FileNotFoundError, OSError) as e:
+        print(f"  (command failed to start: {e})", file=sys.stderr)
+        return subprocess.CompletedProcess(cmd, returncode=127, stdout="", stderr=str(e))
+    if p.stdout:
+        print(p.stdout)
+    if p.stderr:
+        print(p.stderr, file=sys.stderr)
+    return p
+
+
+def find_dataset(marker_relpath, needed_dirs=()):
+    """Content-based mount discovery: find the /kaggle/input/* dataset
+    root that contains marker_relpath (and, optionally, all needed_dirs
+    as siblings of it)."""
+    for cand in sorted(INPUT_ROOT.glob(f"**/{marker_relpath}")):
+        # marker_relpath may itself be nested (e.g. "gpu/Makefile"); the
+        # dataset root is its parent chain stripped of marker_relpath's
+        # own directory parts.
+        root = cand
+        for _ in Path(marker_relpath).parts:
+            root = root.parent
+        ok = True
+        for d in needed_dirs:
+            if not (root / d).is_dir():
+                ok = False
+                break
+        if ok:
+            return root
+    print(f"dataset with marker {marker_relpath!r} not found under /kaggle/input; tree (depth 4):")
+    for q in sorted(INPUT_ROOT.glob("*/**/"))[:200]:
+        if len(q.relative_to(INPUT_ROOT).parts) <= 4:
+            print("  ", q)
+    raise SystemExit(f"dataset with marker {marker_relpath!r} not mounted")
+
+
+def overlay_full_gpu_tree():
+    """Copy this branch's full gpu/ source snapshot (every *.h/*.cpp/
+    *.inc/*.cu + Makefile) from the gpu3-overlay dataset over the staged
+    gpu/ dir, so nothing stale from the base cis2-e18b-gpu dataset's
+    snapshot survives."""
+    import hashlib
+    found = False
+    for cand in sorted(INPUT_ROOT.glob("**/cis2_host.cpp")):
+        od = cand.parent
+        # only treat this as the overlay if it also ships cis2_model.h
+        # (distinguishes the gpu3-overlay dataset root from any other
+        # incidental cis2_host.cpp copy).
+        if not (od / "cis2_model.h").exists():
+            continue
+        for f in sorted(od.glob("*")):
+            if f.is_file() and f.suffix in (".h", ".cpp", ".inc", ".cu") or f.name == "Makefile":
+                shutil.copy2(f, GPU / f.name)
+                print(f"overlay {f.name} sha256={hashlib.sha256(f.read_bytes()).hexdigest()}")
+        found = True
+    if not found:
+        raise SystemExit("gpu3-overlay dataset (cis2_host.cpp + cis2_model.h) not mounted")
+
+
+def gpu_name_and_arch():
+    p = run(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"])
+    name = p.stdout.strip() if p.returncode == 0 else "UNKNOWN"
+    arch = NVCC_ARCH
+    if "P100" in name:
+        arch = "sm_60"
+    return name, arch
+
+
+def nvcc_link(src, out, arch):
+    flags = list(NVCCFLAGS_BASE) + [f"-arch={arch}", "-I", str(GPU)]
+    cmd = ["nvcc"] + flags + ["-o", str(out), str(src)]
+    p = run(cmd)
+    return p.returncode == 0 and out.exists()
+
+
+def gcc_probe_excess_precision():
+    p = subprocess.run(
+        ["g++", "-std=c++17", "-fexcess-precision=standard", "-x", "c++", "-c", "-o", "/dev/null", "-"],
+        input="int main(){}", capture_output=True, text=True,
+    )
+    return p.returncode == 0
+
+
+def gcc_link(src, out):
+    flags = list(GCCFLAGS_BASE)
+    if gcc_probe_excess_precision():
+        flags.append("-fexcess-precision=standard")
+    flags += ["-I", str(GPU)]
+    cmd = ["g++"] + flags + [str(src), "-o", str(out)]
+    p = run(cmd)
+    return p.returncode == 0 and out.exists()
+
+
+VERDICT_RE = re.compile(r"^==== gpu-3 --batch (\d+): (PASS|MISMATCH FOUND) ====$")
+ROW_DIGEST_RE = re.compile(
+    r"^row=(\d+) prompt_tokens=\[[^\]]*\] batched_witness_digest=([0-9a-f]{64}) batched_argmax_digest=([0-9a-f]{64})$"
+)
+ROW_STANDALONE_RE = re.compile(
+    r"^row=(\d+) standalone_batch1_witness_digest=([0-9a-f]{64}) standalone_batch1_argmax_digest=([0-9a-f]{64})$"
+)
+ROW_VS_STANDALONE_RE = re.compile(r"^row=(\d+) vs_standalone_batch1: (MATCH|MISMATCH)$")
+ROW0_PINNED_RE = re.compile(
+    r"^row=0 vs_pinned_EXPECTED_DIGESTS_sequential_16 \(([0-9a-f]{64})\): (standalone_batch1|batched) (MATCH|MISMATCH)$"
+)
+
+
+def parse_batch_output(stdout: str):
+    rows = {}
+    verdict = None
+    for line in stdout.splitlines():
+        line = line.strip()
+        m = ROW_DIGEST_RE.match(line)
+        if m:
+            r = int(m.group(1))
+            rows.setdefault(r, {})["batched_witness_digest"] = m.group(2)
+            rows[r]["batched_argmax_digest"] = m.group(3)
+            continue
+        m = ROW_STANDALONE_RE.match(line)
+        if m:
+            r = int(m.group(1))
+            rows.setdefault(r, {})["standalone_witness_digest"] = m.group(2)
+            rows[r]["standalone_argmax_digest"] = m.group(3)
+            continue
+        m = ROW_VS_STANDALONE_RE.match(line)
+        if m:
+            r = int(m.group(1))
+            rows.setdefault(r, {})["vs_standalone"] = m.group(2)
+            continue
+        m = ROW0_PINNED_RE.match(line)
+        if m:
+            rows.setdefault(0, {})[f"vs_pinned_{m.group(2)}"] = m.group(3)
+            continue
+        m = VERDICT_RE.match(line)
+        if m:
+            verdict = m.group(2)
+    return rows, verdict
+
+
+def main():
+    hr("0. Environment")
+    run(["nvcc", "--version"])
+    gpu_name, arch = gpu_name_and_arch()
+    print(f"GPU name (nvidia-smi): {gpu_name}")
+    print(f"Selected NVCC_ARCH: {arch}")
+
+    hr("1. Stage cis2-e18b-gpu dataset (real weights + gate ids)")
+    e18_ds = find_dataset("gpu/Makefile", needed_dirs=("weights", "gate"))
+    print(f"cis2-e18b-gpu mounted at: {e18_ds}")
+    if WORK.exists():
+        shutil.rmtree(WORK)
+    shutil.copytree(e18_ds / "gpu", GPU)
+    shutil.copytree(e18_ds / "weights", WEIGHTS)
+    shutil.copytree(e18_ds / "gate", GATE)
+
+    hr("2. Overlay this branch's (2768a5a) full gpu/ source snapshot")
+    overlay_full_gpu_tree()
+
+    ids_file = GATE / "ids_16tok.txt"
+    if not ids_file.exists():
+        raise SystemExit(f"expected ids file missing: {ids_file}")
+    print(f"prompt ids file: {ids_file} -> {ids_file.read_text().strip()}")
+
+    hr("3. Build: host control (g++, CPU) -- cis2_host_gcc equivalent")
+    host_bin = GPU / "cis2_host_gcc"
+    host_built = gcc_link(GPU / "cis2_host.cpp", host_bin)
+    print(f"---- host (g++) build: {'OK' if host_built else 'FAILED'}")
+
+    hr("4. Build: nvcc LINK (real device execution, not object-only)")
+    cuda_bin = GPU / "cis2_host_cuda"
+    cuda_built = nvcc_link(GPU / "cis2_host.cpp", cuda_bin, arch)
+    print(f"---- cuda (nvcc, {arch}) build: {'OK' if cuda_built else 'FAILED'}")
+
+    if not host_built and not cuda_built:
+        print("FATAL: neither host nor cuda build succeeded; aborting run.")
+        sys.exit(1)
+
+    all_results = {}  # {"host"|"cuda": {B: {"rows":..., "verdict":...}}}
+    for label, bin_path, built in (("host", host_bin, host_built), ("cuda", cuda_bin, cuda_built)):
+        if not built:
+            continue
+        all_results[label] = {}
+        for B in (1, 4, 8):
+            hr(f"=== {label.upper()} B={B} ===")
+            p = run([str(bin_path), "--weights-dir", str(WEIGHTS), "--ids", str(ids_file),
+                      "--gen-toks", "16", "--batch", str(B)])
+            rows, verdict = parse_batch_output(p.stdout)
+            all_results[label][B] = {"returncode": p.returncode, "rows": rows, "verdict": verdict}
+            print(f"---- parsed: verdict={verdict} rows_parsed={len(rows)} returncode={p.returncode}")
+            if p.returncode < 0:
+                import signal as _sig
+                try:
+                    sname = _sig.Signals(-p.returncode).name
+                except Exception:
+                    sname = "?"
+                print(f"---- {label} --batch {B}: binary died on signal {-p.returncode} ({sname}); "
+                      f"stdout bytes={len(p.stdout)} stderr tail={p.stderr[-400:]!r}")
+
+    hr("5. Summary table")
+    print(f"{'B':>3} {'host_verdict':>16} {'cuda_verdict':>16} {'host==cuda (all rows)':>24}")
+    any_missing_verdict = False
+    for B in (1, 4, 8):
+        host_res = all_results.get("host", {}).get(B)
+        cuda_res = all_results.get("cuda", {}).get(B)
+        host_verdict = host_res["verdict"] if host_res else "NOT_RUN"
+        cuda_verdict = cuda_res["verdict"] if cuda_res else "NOT_RUN"
+        if host_res and host_verdict is None:
+            any_missing_verdict = True
+        if cuda_res and cuda_verdict is None:
+            any_missing_verdict = True
+
+        equality = "N/A"
+        if host_res and cuda_res:
+            host_rows, cuda_rows = host_res["rows"], cuda_res["rows"]
+            keys = sorted(set(host_rows) | set(cuda_rows))
+            eqs = []
+            for r in keys:
+                hd = host_rows.get(r, {}).get("batched_witness_digest")
+                cd = cuda_rows.get(r, {}).get("batched_witness_digest")
+                ha = host_rows.get(r, {}).get("batched_argmax_digest")
+                ca = cuda_rows.get(r, {}).get("batched_argmax_digest")
+                eqs.append((hd is not None and hd == cd) and (ha is not None and ha == ca))
+            equality = "MATCH" if eqs and all(eqs) else ("MISMATCH" if eqs else "N/A")
+            for r in keys:
+                hd = host_rows.get(r, {}).get("batched_witness_digest")
+                cd = cuda_rows.get(r, {}).get("batched_witness_digest")
+                hs = (hd[:16] + "...") if hd else "MISSING"
+                cs = (cd[:16] + "...") if cd else "MISSING"
+                eq = "MATCH" if (hd is not None and hd == cd) else "MISMATCH"
+                print(f"  row={r} host_witness={hs} cuda_witness={cs} {eq}")
+        print(f"{B:>3} {str(host_verdict):>16} {str(cuda_verdict):>16} {equality:>24}")
+
+    hr("6. cis2_model.h execution-path note")
+    print("cis2_model.h has a real `#if defined(__CUDACC__)` device branch")
+    print("(cudaMalloc / cis2_index_kernel and friends). The nvcc build above")
+    print("is a LINKED executable (nvcc_link, not gpu/Makefile's object-only")
+    print("`cuda`/`cuda-tree` targets), so if cuda_built is True and its runs")
+    print("produced verdict lines, the batched forward pass actually EXECUTED")
+    print("device kernels on this Kaggle T4, not just compiled for one.")
+    print(f"host_built={host_built} cuda_built={cuda_built}")
+
+    if any_missing_verdict:
+        print("\nFATAL: at least one run never printed a verdict line.")
+        sys.exit(1)
+    print("\nAll runs that were attempted reached a verdict line (rc unaffected by MISMATCH).")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/gpu/kaggle_gpu3/runs/2026-09-19-gpu3k-v2.log b/gpu/kaggle_gpu3/runs/2026-09-19-gpu3k-v2.log
