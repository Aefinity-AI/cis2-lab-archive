+  witness.finalize(wdig);
+  Cis2Sha256 ah;
+  for (size_t i = 0; i < all_token_ids.size(); ++i) ah.update_u32le(all_token_ids[i]);
+  unsigned char adig[32];
+  ah.finalize(adig);
+
+  if (trace.fp) fclose(trace.fp);
+
+  printf("weights_sha256=%s\n", cis2_hex(weights_sha, 32).c_str());
+  printf("tokenizer_sha256=%s\n", cis2_hex(tokenizer_sha, 32).c_str());
+  printf("config_sha256=%s\n", cis2_hex(config_sha, 32).c_str());
+  printf("table_digest=%s\n", cis2_hex(table_dig, 32).c_str());
+  printf("inv_freq_table_digest=%s\n",
+         cis2_hex(model.inv_freq_table_digest, 32).c_str());
+  printf("prompt_idx=%d prompt_tokens=%s\n", prompt_idx, ids_debug(prompt_ids).c_str());
+  printf("prompt_idx=%d run1_tokens=%s\n", prompt_idx, ids_debug(all_token_ids).c_str());
+  printf("prompt_idx=%d run1_witness_digest=%s\n", prompt_idx, cis2_hex(wdig, 32).c_str());
+  printf("prompt_idx=%d run1_argmax_digest=%s\n", prompt_idx, cis2_hex(adig, 32).c_str());
+  // v0.4 CANDIDATE (E18c): reduction_mode is receipt metadata mirroring
+  // main.rs's printed field, selected at compile time by
+  // -DCIS2_REDUCTION_TREE (gpu/README.md / design doc §4-§5). It is not
+  // folded into the witness above, so it cannot change wdig/adig either
+  // way.
+#ifdef CIS2_REDUCTION_TREE
+  printf("prompt_idx=%d reduction_mode=tree\n", prompt_idx);
+  printf("CIS2_REF digest=%s prompt_idx=%d prompt_toks=%zu gen_toks=%d dtype=fp32 reduction_mode=tree\n",
+         cis2_hex(wdig, 32).c_str(), prompt_idx, prompt_ids.size(), gen_toks);
+#else
+  printf("prompt_idx=%d reduction_mode=sequential\n", prompt_idx);
+  printf("CIS2_REF digest=%s prompt_idx=%d prompt_toks=%zu gen_toks=%d dtype=fp32 reduction_mode=sequential\n",
+         cis2_hex(wdig, 32).c_str(), prompt_idx, prompt_ids.size(), gen_toks);
+#endif
+
+  ws.free_all();
+  return 0;
+}
diff --git a/gpu/kaggle_gpu3/overlay_staging/cis2_math.h b/gpu/kaggle_gpu3/overlay_staging/cis2_math.h
new file mode 100644
index 0000000..10c8d99
--- /dev/null
+++ b/gpu/kaggle_gpu3/overlay_staging/cis2_math.h
@@ -0,0 +1,625 @@
+// gpu/cis2_math.h — CIS-2 v0.3b §6 pinned transcendentals, single-source
+// CUDA-portable C++17. Ported line-for-line from src/math.rs (the normative
+// Rust reference on this branch): identical operation order, identical
+// intermediate types, identical constants (as exact hex-float literals
+// generated by `cargo run --release --bin math_dump`).
+//
+// PORTABILITY CONTRACT
+//   * Every arithmetic function is marked CIS2_FN, which expands to
+//     `__host__ __device__` under nvcc and to nothing on the host, so the
+//     SAME source is both the host reference and the CUDA device code.
+//   * No libm is called from the arithmetic path: floor, round, trunc,
+//     copysign, ldexp and frexp are all open-coded from bit manipulation
+//     or exact integer arithmetic. `sqrt` is the hardware IEEE-754
+//     correctly-rounded instruction (SSE2 `sqrtss` on the host,
+//     `-prec-sqrt=true` `sqrt.rn.f32` under nvcc), mirroring what Rust's
+//     `f32::sqrt` lowers to — see §6.1 / src/math.rs `rsqrt_cr`.
+//   * No FMA: every multiply-then-add is two separately-rounded statements
+//     (§1.4). Build with -ffp-contract=off (host) / -fmad=false (nvcc).
+//
+// NON-OBVIOUS EVALUATION-ORDER POINTS mirrored from the Rust (see
+// gpu/README.md for the full table):
+//   * `k as i32` / `k_f64 as i64` in Rust are SATURATING float->int casts,
+//     not C's undefined-on-overflow conversion. cis2_f32_to_i32_sat /
+//     cis2_f64_to_i64_sat reproduce the saturating semantics exactly.
+//   * `f64::round()` is ties-AWAY-from-zero and preserves the sign of a
+//     zero input; `cis2_round_f64` reproduces both.
+//   * reduce_pi_2 does its arithmetic in f64 and narrows ONCE at the end;
+//     everything else in this file is f32 throughout.
+//   * `m = m + m - 1.0` in ln_pinned is `(m + m) - 1.0` (left-assoc).
+
+#ifndef CIS2_MATH_H
+#define CIS2_MATH_H
+
+#include <stdint.h>
+
+// --- single-source host/device function marker ------------------------
+#if defined(__CUDACC__)
+#define CIS2_FN __host__ __device__
+#define CIS2_CONST __device__ __constant__ const
+#else
+#define CIS2_FN
+#define CIS2_CONST static const
+#endif
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <emmintrin.h>
+#define CIS2_HAVE_SSE2 1
+#elif defined(__aarch64__) || defined(_M_ARM64)
+#define CIS2_HAVE_AARCH64_FSQRT 1
+#endif
+
+// --- pinned constants (generated; see gpu/cis2_consts.inc) ------------
+#include "cis2_consts.inc"
+
+// Host-visible mirror of the same constants, so the host can fold them
+// into the table digest (§6.6). Under nvcc the CIS2_CONST copies live in
+// __constant__ memory and are not addressable from the host, hence the
+// duplicate `static const` block guarded to the host translation unit.
+#if defined(__CUDACC__)
+#define CIS2_CONST_HOSTMIRROR 1
+namespace cis2_hostconst {
+#undef CIS2_CONST
+#define CIS2_CONST static const
+#include "cis2_consts.inc"
+#undef CIS2_CONST
+#define CIS2_CONST __device__ __constant__ const
+} // namespace cis2_hostconst
+#else
+namespace cis2_hostconst {
+using ::COS_C0; using ::COS_C1; using ::COS_C2;
+using ::EXP_C1; using ::EXP_C2; using ::EXP_LOG2E;
+using ::EXP_P0; using ::EXP_P1; using ::EXP_P2;
+using ::EXP_P3; using ::EXP_P4; using ::EXP_P5;
+using ::LOG_P0; using ::LOG_P1; using ::LOG_P2; using ::LOG_P3;
+using ::LOG_P4; using ::LOG_P5; using ::LOG_P6; using ::LOG_P7;
+using ::LOG_P8;
+using ::LOG_Q1; using ::LOG_Q2; using ::LOG_SQRTHF;
+using ::PI_2_F64;
+using ::SIN_C0; using ::SIN_C1; using ::SIN_C2;
+} // namespace cis2_hostconst
+#endif
+
+// --- bit reinterpretation (C++17: no std::bit_cast) -------------------
+CIS2_FN inline uint32_t cis2_f32_bits(float x) {
+  union { float f; uint32_t u; } c; c.f = x; return c.u;
+}
+CIS2_FN inline float cis2_f32_from_bits(uint32_t u) {
+  union { float f; uint32_t u; } c; c.u = u; return c.f;
+}
+CIS2_FN inline uint64_t cis2_f64_bits(double x) {
+  union { double f; uint64_t u; } c; c.f = x; return c.u;
+}
+CIS2_FN inline double cis2_f64_from_bits(uint64_t u) {
+  union { double f; uint64_t u; } c; c.u = u; return c.f;
+}
+
+CIS2_FN inline bool cis2_isnan_f32(float x) { return x != x; }
+CIS2_FN inline bool cis2_isnan_f64(double x) { return x != x; }
+CIS2_FN inline bool cis2_signbit_f32(float x) {
+  return (cis2_f32_bits(x) >> 31) != 0u;
+}
+
+CIS2_FN inline float cis2_inf_f32() { return cis2_f32_from_bits(0x7F800000u); }
+CIS2_FN inline float cis2_neg_inf_f32() { return cis2_f32_from_bits(0xFF800000u); }
+// Rust's `f32::NAN` is the positive quiet NaN 0x7FC00000; pin the same bits
+// so NaN-returning paths are bit-comparable, not merely "some NaN".
+CIS2_FN inline float cis2_nan_f32() { return cis2_f32_from_bits(0x7FC00000u); }
+
+// --- no-libm integer/rounding helpers ---------------------------------
+
+// Rust `f32 as i32`: saturating (NaN -> 0, out of range -> clamp).
+CIS2_FN inline int32_t cis2_f32_to_i32_sat(float x) {
+  if (cis2_isnan_f32(x)) return 0;
+  if (x >= 2147483648.0f) return INT32_MAX;   // 2^31
+  if (x <= -2147483648.0f) return INT32_MIN;  // -2^31 is exactly representable
+  return (int32_t)x;
+}
+
+// Rust `f64 as i64`: saturating (NaN -> 0, out of range -> clamp).
+CIS2_FN inline int64_t cis2_f64_to_i64_sat(double x) {
+  if (cis2_isnan_f64(x)) return 0;
+  if (x >= 9223372036854775808.0) return INT64_MAX;   // 2^63
+  if (x <= -9223372036854775808.0) return INT64_MIN;  // -2^63 exact
+  return (int64_t)x;
+}
+
+// Rust `f32::floor()` without libm. Exact for every finite f32: values with
+// |x| >= 2^23 are already integers, and below that the truncating i32 cast
+// is exact.
+CIS2_FN inline float cis2_floor_f32(float x) {
+  const float TWO23 = 8388608.0f;
+  float a = x < 0.0f ? -x : x;
+  if (!(a < TWO23)) return x;  // inf, NaN, and |x| >= 2^23 pass through
+  float t = (float)(int32_t)x; // truncate toward zero (exact here)
+  if (x < t) t = t - 1.0f;
+  return t;
+}
+
+// Copy the sign bit of `s` onto the magnitude of `m` (no libm copysign).
+CIS2_FN inline double cis2_copysign_f64(double m, double s) {
+  uint64_t mb = cis2_f64_bits(m) & 0x7FFFFFFFFFFFFFFFull;
+  uint64_t sb = cis2_f64_bits(s) & 0x8000000000000000ull;
+  return cis2_f64_from_bits(mb | sb);
+}
+
+// Rust `f64::round()` without libm: round half AWAY from zero, and preserve
+// the sign of a zero/negative-zero input (round(-0.0) == -0.0, which
+// matters because the sign then propagates through `k * PI_2_F64`).
+CIS2_FN inline double cis2_round_f64(double x) {
+  const double TWO52 = 4503599627370496.0;
+  double a = x < 0.0 ? -x : x;
+  if (!(a < TWO52)) return x;  // inf, NaN, and |x| >= 2^52 are integers
+  double t = (double)(int64_t)a;  // exact: a < 2^52 < 2^63
+  double frac = a - t;
+  if (frac >= 0.5) t = t + 1.0;
+  return cis2_copysign_f64(t, x);
+}
+
+// IEEE-754 correctly-rounded sqrt, as a single hardware instruction, no
+// libm call and no errno path. §6.1 / §1.6: this is the one operation the
+// spec does not need to pin, because IEEE-754 mandates correct rounding.
+CIS2_FN inline float cis2_sqrt_f32(float x) {
+#if defined(__CUDA_ARCH__)
+  return __fsqrt_rn(x);  // IEEE round-to-nearest sqrt (== -prec-sqrt=true)
+#elif defined(CIS2_HAVE_SSE2)
+  return _mm_cvtss_f32(_mm_sqrt_ss(_mm_set_ss(x)));
+#elif defined(CIS2_HAVE_AARCH64_FSQRT)
+  // AArch64's scalar FSQRT is a single IEEE-754 correctly-rounded
+  // instruction, the exact device-side equivalent of x86-64's sqrtss.
+  // Inline asm (not __builtin_sqrtf) so the emitted instruction is
+  // guaranteed regardless of libm/errno codegen choices.
+  float result;
+  __asm__("fsqrt %s0, %s1" : "=w"(result) : "w"(x));
+  return result;
+#else
+#error "CIS-2 requires a correctly-rounded hardware sqrt with no libm call"
+#endif
+}
+
+// --- §4.1 bf16 -> fp32 exact bit-shift widening -----------------------
+CIS2_FN inline float cis2_widen_bf16(uint16_t bits) {
+  return cis2_f32_from_bits(((uint32_t)bits) << 16);
+}
+
+// --- §5.1 strict left-to-right sequential dot product -----------------
+CIS2_FN inline float cis2_dot_seq(const float *a, const float *b, int n) {
+  float acc = 0.0f;
+  for (int i = 0; i < n; ++i) {
+    float p = a[i] * b[i];  // separate mul; never fused with the add below
+    acc = acc + p;          // separate add
+  }
+  return acc;
+}
+
+// --- §5.3 strict left-to-right sequential sum -------------------------
+CIS2_FN inline float cis2_sum_seq(const float *a, int n) {
+  float acc = 0.0f;
+  for (int i = 0; i < n; ++i) acc = acc + a[i];
+  return acc;
+}
+
+// --- gpu2 (QUEUE gpu-2) step 2: row-batch matmul, case 1 -------------
+// Batches B independent rows through the *unmodified* cis2_dot_seq, one
+// call per (row, output-column) pair, in the same order batch=1 would
+// produce if invoked B times. This introduces no new arithmetic and no
+// new reduction order -- see BATCH_INT8_DESIGN.md step 2. It is expected,
+// a priori, to be digest-identical to B sequential batch=1 calls; that
+// expectation is verified by gpu/test_batch.cpp, not assumed here.
+//
+// x:  [B][k]      row-major, B rows of length k
+// w:  [n][k]      row-major, n output rows (weight matrix), each length k
+// out:[B][n]      row-major, out[b*n+j] = dot(x[b], w[j])
+CIS2_FN inline void cis2_matmul_batched_seq(int B, int n, int k,
+                                             const float *x, const float *w,
+                                             float *out) {
+  for (int b = 0; b < B; ++b) {
+    for (int j = 0; j < n; ++j) {
+      out[b * n + j] = cis2_dot_seq(x + (size_t)b * k, w + (size_t)j * k, k);
+    }
+  }
+}
+
+// --- v0.4 CANDIDATE (E18c): pinned tree reduction ----------------------
+// Mirrors src/math.rs's tree_sum/tree_dot line-for-line (see
+// docs/design/CIS2_V04_TREE_REDUCTION.md for the full derivation).
+// `cis2_dot_seq`/`cis2_sum_seq` above are NOT called and NOT modified by
+// anything below; this is new, additive code, selected only through the
+// CIS2_DOT/CIS2_SUM/CIS2_SOFTMAX macros at the very bottom of this
+// section, which in turn are used only at cis2_model.h's kernel call
+// sites (never inside cis2_dot_seq/cis2_sum_seq/cis2_softmax_seq
+// themselves).
+
+#define CIS2_TREE_BLOCK 32
+
+// One fixed 32-slot block, five-round pairwise halving, strictly in
+// place. Ragged/missing leaves must already be zero-padded by the caller
+// (§2 of the design doc) — this function has no notion of "how many are
+// real."
+CIS2_FN inline float cis2_tree_block_reduce(float leaf[CIS2_TREE_BLOCK]) {
+  int width = CIS2_TREE_BLOCK;
+  while (width > 1) {
+    int half = width / 2;
+    for (int i = 0; i < half; ++i) {
+      leaf[i] = leaf[2 * i] + leaf[2 * i + 1];
+    }
+    width = half;
+  }
+  return leaf[0];
+}
+
+// Split 0..n into CIS2_TREE_BLOCK-sized blocks (last one zero-padded if
+// ragged), reduce each with cis2_tree_block_reduce, combine the
+// per-block partials strictly left-to-right. `leaf_at(i)` is the same
+// `[=] CIS2_FN(...)` extended-lambda idiom cis2_for_each already uses
+// elsewhere in this header, so the identical source compiles under both
+// the host build and nvcc's --extended-lambda.
+template <typename F>
+CIS2_FN inline float cis2_tree_reduce_indexed(int n, F leaf_at) {
+  if (n <= 0) return 0.0f;
+  int num_blocks = (n + CIS2_TREE_BLOCK - 1) / CIS2_TREE_BLOCK;
+  float acc = 0.0f;
+  for (int blk = 0; blk < num_blocks; ++blk) {
+    int start = blk * CIS2_TREE_BLOCK;
+    int len = n - start;
+    if (len > CIS2_TREE_BLOCK) len = CIS2_TREE_BLOCK;
+    float leaf[CIS2_TREE_BLOCK];
+    for (int i = 0; i < CIS2_TREE_BLOCK; ++i) leaf[i] = 0.0f;  // §2 zero-pad
+    for (int i = 0; i < len; ++i) leaf[i] = leaf_at(start + i);
+    float partial = cis2_tree_block_reduce(leaf);
+    acc = acc + partial;  // block-partial combine: strict left-to-right
+  }
+  return acc;
+}
+
+// Sibling of cis2_sum_seq; that function is untouched.
+CIS2_FN inline float cis2_tree_sum(const float *a, int n) {
+  return cis2_tree_reduce_indexed(n, [=] CIS2_FN(int i) { return a[i]; });
+}
+
+// Sibling of cis2_dot_seq; that function is untouched. The multiply is a
+// separate, separately-rounded operation computed once per leaf as it is
+// gathered — never fused with an add.
+CIS2_FN inline float cis2_tree_dot(const float *a, const float *b, int n) {
+  return cis2_tree_reduce_indexed(
+      n, [=] CIS2_FN(int i) { return a[i] * b[i]; });
+}
+
+// --- gpu2 (QUEUE gpu-2) step 3: grouped/strided-reduction batched matmul
+// (case 2) ---------------------------------------------------------------
+// Behind -DCIS2_BATCH_GROUPED, mirroring exactly how -DCIS2_REDUCTION_TREE
+// gates the CANDIDATE tree-reduction path above (same precedent, reused
+// deliberately per BATCH_INT8_DESIGN.md step 3). This is the design doc's
+// "case 2" arm: the B*n independent (row, output-column) dot products are
+// scheduled in fixed-width lockstep groups of CIS2_GROUP_WIDTH (mirroring
+// how a real grouped/strided-GEMM kernel assigns a warp/wave of output
+// elements together), and EACH dot product is reduced with the existing
+// cis2_tree_dot tree-block reduction rather than the strictly sequential
+// cis2_dot_seq. This changes the per-dot-product reduction order/tree
+// shape relative to both the batch=1 reference and step 2's
+// cis2_matmul_batched_seq, so it is expected, a priori, to risk a digest
+// MISMATCH against both (fp32 addition is non-associative) — see the
+// design doc's own framing: a MISMATCH here is a valid, interesting
+// finding, not a bug to fix quietly. cis2_dot_seq/cis2_tree_dot themselves
+// are untouched by this addition; this is new, additive code only reached
+// through cis2_matmul_batched_grouped.
+#ifdef CIS2_BATCH_GROUPED
+
+#define CIS2_GROUP_WIDTH 4
+
+// x:  [B][k]      row-major, B rows of length k
+// w:  [n][k]      row-major, n output rows (weight matrix), each length k
+// out:[B][n]      row-major, out[b*n+j] = tree_dot(x[b], w[j])
+CIS2_FN inline void cis2_matmul_batched_grouped(int B, int n, int k,
+                                                 const float *x,
+                                                 const float *w, float *out) {
+  int total = B * n;
+  for (int base = 0; base < total; base += CIS2_GROUP_WIDTH) {
+    int width = total - base;
+    if (width > CIS2_GROUP_WIDTH) width = CIS2_GROUP_WIDTH;
+    for (int lane = 0; lane < width; ++lane) {
+      int idx = base + lane;
+      int b = idx / n;
+      int j = idx % n;
+      out[idx] = cis2_tree_dot(x + (size_t)b * k, w + (size_t)j * k, k);
+    }
+  }
+}
+
+#endif  // CIS2_BATCH_GROUPED
+
+// --- gpu2 (QUEUE gpu-2) step 4: int8 weight quantization --------------
+// Scheme (BATCH_INT8_DESIGN.md step 4, decided per its own step-1
+// recommendation): per-output-channel (per-row of the weight matrix)
+// SYMMETRIC int8, scale = max(abs(row)) / 127, matching common
+// llama.cpp-style Q8_0 for easy cross-checking. Dequant is done
+// ON-THE-FLY inside the matmul (not on-load to fp32 buffers), per the
+// design doc's explicit preference: on-the-fly is more representative
+// of a real int8 inference path because it changes the actual matmul
+// arithmetic, whereas on-load dequant to fp32 would only exercise I/O.
+//
+// Quantize one row of length k into int8 + a single fp32 scale.
+// q[i] = round(row[i] / scale), clamped to [-127, 127] (symmetric,
+// -128 deliberately unused so the range is exactly symmetric around 0,
+// same convention as Q8_0). scale == 0 (all-zero row) is defined as
+// scale = 1.0f to avoid division by zero; all q[i] are then 0 anyway.
+CIS2_FN inline float cis2_quantize_row_i8(const float *row, int k,
+                                           int8_t *q_out) {
+  float max_abs = 0.0f;
+  for (int i = 0; i < k; ++i) {
+    float a = row[i] < 0.0f ? -row[i] : row[i];
+    if (a > max_abs) max_abs = a;
+  }
+  float scale = (max_abs == 0.0f) ? 1.0f : (max_abs / 127.0f);
+  for (int i = 0; i < k; ++i) {
+    float v = row[i] / scale;
+    // round-half-away-from-zero via the existing f64 round helper, then
+    // saturate to the int8 symmetric range.
+    float r = (float)cis2_round_f64((double)v);
+    if (r > 127.0f) r = 127.0f;
+    if (r < -127.0f) r = -127.0f;
+    q_out[i] = (int8_t)r;
+  }
+  return scale;
+}
+
+// Batched matmul with the weight matrix stored as int8 + one scale per
+// output row (per BATCH_INT8_DESIGN.md step 4), dequantized ON-THE-FLY
+// per element inside the dot-product loop -- this is genuinely different
+// arithmetic from cis2_dot_seq's fp32*fp32 multiply, not just an I/O
+// change, so it is expected, a priori, to risk a digest MISMATCH against
+// the fp32 reference (quantization error, not merely reduction-order
+// non-associativity). The activation row x stays fp32 (weight-only
+// quantization, the common inference case); dequantized weight values
+// are computed with a single fp32 multiply (int8 -> float widening is
+// exact, then `w_i8[i] * scale` is one separately-rounded fp32 op,
+// consistent with this file's no-FMA rule), and the running dot product
+// uses the same strict left-to-right sequential accumulation as
+// cis2_dot_seq (acc = acc + p, separate mul then separate add) so that
+// any MISMATCH vs the fp32 reference is attributable to quantization
+// only, not to a second, independent reduction-order change.
+//
+// x:       [B][k]      row-major fp32 activations
+// w_i8:    [n][k]      row-major int8 quantized weights
+// w_scale: [n]         one fp32 scale per weight row (per-output-channel)
+// out:     [B][n]      row-major, out[b*n+j] = dot(x[b], dequant(w_i8[j]))
+CIS2_FN inline void cis2_matmul_batched_int8(int B, int n, int k,
+                                              const float *x,
+                                              const int8_t *w_i8,
+                                              const float *w_scale,
+                                              float *out) {
+  for (int b = 0; b < B; ++b) {
+    for (int j = 0; j < n; ++j) {
+      const float *xr = x + (size_t)b * k;
+      const int8_t *wr = w_i8 + (size_t)j * k;
+      float scale = w_scale[j];
+      float acc = 0.0f;
+      for (int i = 0; i < k; ++i) {
+        float wf = (float)wr[i] * scale;  // separate mul, exact int->float
+        float p = xr[i] * wf;             // separate mul
+        acc = acc + p;                    // separate add
+      }
+      out[b * n + j] = acc;
+    }
+  }
+}
+
+// --- §6.1 rsqrt, route (a): correctly-rounded by construction ---------
+CIS2_FN inline float cis2_rsqrt_cr(float x) { return 1.0f / cis2_sqrt_f32(x); }
+
+// --- §6.2 exp, route (b): pinned Cephes-pattern polynomial ------------
+
+// Exact scale-by-power-of-two via exponent-field bit manipulation
+// (src/math.rs `ldexp_exact`). Note: the underflow branch returns POSITIVE
+// zero regardless of the sign of x — mirrored literally.
+CIS2_FN inline float cis2_ldexp_exact(float x, int32_t k) {
+  if (x == 0.0f) return x;
+  uint32_t bits = cis2_f32_bits(x);
+  int32_t exp_bits = (int32_t)((bits >> 23) & 0xFFu);
+  int32_t new_exp = exp_bits + k;
+  if (new_exp <= 0) return 0.0f;
+  if (new_exp >= 0xFF)
+    return cis2_signbit_f32(x) ? cis2_neg_inf_f32() : cis2_inf_f32();
+  uint32_t new_bits = (bits & ~(0xFFu << 23)) | (((uint32_t)new_exp) << 23);
+  return cis2_f32_from_bits(new_bits);
+}
+
+CIS2_FN inline float cis2_exp_pinned(float x) {
+  if (cis2_isnan_f32(x)) return cis2_nan_f32();
+  if (x > 88.0f) return cis2_inf_f32();
+  if (x < -88.0f) return 0.0f;
+  float t = x * EXP_LOG2E;  // separate mul
+  float z0 = t + 0.5f;
+  float k = cis2_floor_f32(z0);
+  // r = x - k*C1 - k*C2 (two-step Cephes split reduction, no fma)
+  float kc1 = k * EXP_C1;
+  float r0 = x - kc1;
+  float kc2 = k * EXP_C2;
+  float r = r0 - kc2;
+
+  float r2 = r * r;
+  // Horner, strict sequential, no fma.
+  const float EXP_P[6] = {EXP_P0, EXP_P1, EXP_P2, EXP_P3, EXP_P4, EXP_P5};
+  float poly = EXP_P[0];
+  for (int i = 1; i < 6; ++i) {
+    float m = poly * r;
+    poly = m + EXP_P[i];
+  }
+  float m1 = poly * r2;
+  float poly2 = m1 + r;         // + r
+  float result = poly2 + 1.0f;  // + 1
+
+  return cis2_ldexp_exact(result, cis2_f32_to_i32_sat(k));
+}
+
+// --- §6.3 sin/cos, route (b): octant reduction + minimax polynomials --
+
+// Reduce x to r in [-pi/4, pi/4] plus a quadrant index k. f64-staged: exact
+// f32->f64 widening, correctly-rounded f64 div/mul/sub, ties-away round,
+// then a SINGLE correctly-rounded f64->f32 narrowing.
+CIS2_FN inline void cis2_reduce_pi_2(float x, float *r_out, int64_t *k_out) {
+  double xd = (double)x;                   // exact widening, no rounding
+  double k_f64 = cis2_round_f64(xd / PI_2_F64);  // f64 div + ties-away round
+  double khi = k_f64 * PI_2_F64;           // f64 mul (correctly rounded)
+  double r64 = xd - khi;                   // f64 sub (correctly rounded)
+  *r_out = (float)r64;                     // single correctly-rounded narrow
+  *k_out = cis2_f64_to_i64_sat(k_f64);     // Rust `as i64` is saturating
+}
+
+// sin(r) for r in [-pi/4, pi/4], strict left-to-right, no FMA.
+CIS2_FN inline float cis2_sin_poly(float r) {
+  float r2 = r * r;
+  float inner = SIN_C2;
+  float m0 = inner * r2;
+  inner = m0 + SIN_C1;
+  float m1 = inner * r2;
+  inner = m1 + SIN_C0;
+  float r3 = r2 * r;
+  float term = inner * r3;
+  return r + term;
+}
+
+// cos(r) for r in [-pi/4, pi/4], strict left-to-right, no FMA.
+CIS2_FN inline float cis2_cos_poly(float r) {
+  float r2 = r * r;
+  float inner = COS_C2;
+  float m0 = inner * r2;
+  inner = m0 + COS_C1;
+  float m1 = inner * r2;
+  inner = m1 + COS_C0;
+  float r4 = r2 * r2;
+  float term = inner * r4;
+  float half_r2 = 0.5f * r2;
+  float step1 = 1.0f - half_r2;
+  return step1 + term;
+}
+
+// Reduce k mod 4 into [0, 4) for arbitrary-sign k. Rust's `%` on i64 is
+// truncated division, the same as C++'s, so this transcribes directly.
+CIS2_FN inline int64_t cis2_quadrant(int64_t k) { return ((k % 4) + 4) % 4; }
+
+CIS2_FN inline float cis2_sin_pinned(float x) {
+  float r; int64_t k;
+  cis2_reduce_pi_2(x, &r, &k);
+  float sr = cis2_sin_poly(r);
+  float cr = cis2_cos_poly(r);
+  switch ((int)cis2_quadrant(k)) {
+    case 0: return sr;
+    case 1: return cr;
+    case 2: return -sr;
+    default: return -cr;  // quadrant 3
+  }
+}
+
+CIS2_FN inline float cis2_cos_pinned(float x) {
+  float r; int64_t k;
+  cis2_reduce_pi_2(x, &r, &k);
+  float sr = cis2_sin_poly(r);
+  float cr = cis2_cos_poly(r);
+  switch ((int)cis2_quadrant(k)) {
+    case 0: return cr;
+    case 1: return -sr;
+    case 2: return -cr;
+    default: return sr;  // quadrant 3
+  }
+}
+
+// --- §6.5 ln, route (b): pinned Cephes-pattern polynomial -------------
+
+// Exact frexp via bit manipulation: x = mantissa * 2^exp, mantissa in
+// [0.5, 1.0). No library call, bit reinterpretation only.
+CIS2_FN inline void cis2_frexp_exact(float x, float *m_out, int32_t *e_out) {
+  uint32_t bits = cis2_f32_bits(x);
+  int32_t exp_bits = (int32_t)((bits >> 23) & 0xFFu);
+  uint32_t mantissa_bits = (bits & 0x807FFFFFu) | (126u << 23);
+  *m_out = cis2_f32_from_bits(mantissa_bits);
+  *e_out = exp_bits - 126;
+}
+
+CIS2_FN inline float cis2_ln_pinned(float x) {
+  if (cis2_isnan_f32(x) || x < 0.0f) return cis2_nan_f32();
+  if (x == 0.0f) return cis2_neg_inf_f32();
+  float m; int32_t e;
+  cis2_frexp_exact(x, &m, &e);
+  if (m < LOG_SQRTHF) {
+    e -= 1;
+    m = m + m - 1.0f;  // (m + m) - 1.0, left-associative
+  } else {
+    m = m - 1.0f;
+  }
+  float z = m * m;
+  const float LOG_P[9] = {LOG_P0, LOG_P1, LOG_P2, LOG_P3, LOG_P4,
+                          LOG_P5, LOG_P6, LOG_P7, LOG_P8};
+  float poly = LOG_P[0];
+  for (int i = 1; i < 9; ++i) {
+    float t = poly * m;
+    poly = t + LOG_P[i];
+  }
+  float y = poly * m;  // y = poly(m) * m
+  y = y * z;
+  float fe = (float)e;
+  float t1 = fe * LOG_Q1;
+  y = y + t1;
+  float half_z = 0.5f * z;
+  y = y - half_z;
+  float result = m + y;
+  float t2 = fe * LOG_Q2;
+  result = result + t2;
+  return result;
+}
+
+// --- §6.4 SiLU --------------------------------------------------------
+CIS2_FN inline float cis2_silu_pinned(float x) {
+  float neg = -x;
+  float e = cis2_exp_pinned(neg);
+  float denom = 1.0f + e;
+  return x / denom;
+}
+
+// --- §10/§11 softmax in place ----------------------------------------
+// Sequential max scan (first occurrence wins on ties), pinned exp, §5.3
+// sequential-sum denominator, then elementwise divide.
+CIS2_FN inline void cis2_softmax_seq(float *logits, int n) {
+  if (n == 0) return;
+  float max_v = logits[0];
+  for (int i = 1; i < n; ++i) {
+    float v = logits[i];
+    if (v > max_v) max_v = v;
+  }
+  for (int i = 0; i < n; ++i) logits[i] = cis2_exp_pinned(logits[i] - max_v);
+  float denom = cis2_sum_seq(logits, n);
+  for (int i = 0; i < n; ++i) logits[i] = logits[i] / denom;
+}
+
+// v0.4 CANDIDATE — sibling of cis2_softmax_seq above, identical in every
+// step except the denominator, which uses cis2_tree_sum instead of
+// cis2_sum_seq. cis2_softmax_seq is not called and not modified here.
+CIS2_FN inline void cis2_softmax_tree(float *logits, int n) {
+  if (n == 0) return;
+  float max_v = logits[0];
+  for (int i = 1; i < n; ++i) {
+    float v = logits[i];
+    if (v > max_v) max_v = v;
+  }
+  for (int i = 0; i < n; ++i) logits[i] = cis2_exp_pinned(logits[i] - max_v);
+  float denom = cis2_tree_sum(logits, n);
+  for (int i = 0; i < n; ++i) logits[i] = logits[i] / denom;
+}
+
+// --- v0.4 CANDIDATE: compile-time reduction-mode dispatch --------------
+// Building without -DCIS2_REDUCTION_TREE preprocesses CIS2_DOT/CIS2_SUM/
+// CIS2_SOFTMAX to exactly the prior cis2_dot_seq/cis2_sum_seq/
+// cis2_softmax_seq call at cis2_model.h's kernel call sites -- the
+// literal same tokens reach the compiler, which is why the sequential
+// build is unchanged, not merely "produces the same result."
+#ifdef CIS2_REDUCTION_TREE
+#define CIS2_DOT(a, b, n) cis2_tree_dot((a), (b), (n))
+#define CIS2_SUM(a, n) cis2_tree_sum((a), (n))
+#define CIS2_SOFTMAX(scores, n) cis2_softmax_tree((scores), (n))
+#else
+#define CIS2_DOT(a, b, n) cis2_dot_seq((a), (b), (n))
+#define CIS2_SUM(a, n) cis2_sum_seq((a), (n))
+#define CIS2_SOFTMAX(scores, n) cis2_softmax_seq((scores), (n))
+#endif
+
+#endif  // CIS2_MATH_H
