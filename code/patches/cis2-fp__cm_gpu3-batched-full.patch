+static std::vector<uint32_t> read_ids(const std::string &path) {
+  std::string text = cis2_read_file(path);
+  std::vector<uint32_t> ids;
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && (text[i] == '\n' || text[i] == '\r' ||
+                               text[i] == ' ' || text[i] == '\t' || text[i] == ','))
+      ++i;
+    if (i >= text.size()) break;
+    size_t j = i;
+    while (j < text.size() && text[j] >= '0' && text[j] <= '9') ++j;
+    if (j == i) { fprintf(stderr, "FATAL: %s: bad token id byte %zu\n", path.c_str(), i); exit(2); }
+    ids.push_back((uint32_t)strtoul(text.substr(i, j - i).c_str(), nullptr, 10));
+    i = j;
+  }
+  if (ids.empty()) { fprintf(stderr, "FATAL: %s: no token ids\n", path.c_str()); exit(2); }
+  return ids;
+}
+
+// int8 device buffer helpers -- mirror cis2_dev_alloc/cis2_upload's
+// CIS2_DEVICE_IS_HOST split (cis2_model.h) but for int8_t, which that
+// file does not provide (it only ever moves float buffers).
+#if CIS2_DEVICE_IS_HOST
+static int8_t *cis2_dev_alloc_i8(size_t n) {
+  int8_t *p = (int8_t *)malloc(n);
+  if (!p) { fprintf(stderr, "FATAL: malloc(%zu i8) failed\n", n); exit(2); }
+  return p;
+}
+static void cis2_upload_i8(int8_t *d, const int8_t *h, size_t n) { if (d != h) memcpy(d, h, n); }
+static void cis2_download_f(float *h, const float *d, size_t n) { if (h != d) memcpy(h, d, n * sizeof(float)); }
+#else
+static int8_t *cis2_dev_alloc_i8(size_t n) {
+  int8_t *p = nullptr;
+  if (cudaMalloc(&p, n) != cudaSuccess) { fprintf(stderr, "FATAL: cudaMalloc(%zu i8) failed\n", n); exit(2); }
+  return p;
+}
+static void cis2_upload_i8(int8_t *d, const int8_t *h, size_t n) { cudaMemcpy(d, h, n, cudaMemcpyHostToDevice); }
+static void cis2_download_f(float *h, const float *d, size_t n) { cudaMemcpy(h, d, n * sizeof(float), cudaMemcpyDeviceToHost); }
+#endif
+
+static void report(const char *config, const float *out, size_t total,
+                    const float *anchor_row0, int n, int rowstride,
+                    unsigned char anchor_dig[32]) {
+  Cis2Sha256 h;
+  h.update(out, total * sizeof(float));
+  unsigned char dig[32];
+  h.finalize(dig);
+  std::string hex = cis2_hex(dig, 32);
+
+  int diffs = 0;
+  for (int j = 0; j < n; ++j) {
+    if (out[j] != anchor_row0[j]) ++diffs;  // row 0 is out[0*rowstride + j]
+  }
+  bool full_match = (memcmp(dig, anchor_dig, 32) == 0);
+  printf("SWEEP config=%s digest=%s vs_cpu_batch1=%s diffs=%d/%d\n",
+         config, hex.c_str(), (diffs == 0 ? "MATCH" : "MISMATCH"), diffs, n);
+  (void)full_match; (void)rowstride;
+}
+
+int main(int argc, char **argv) {
+  cis2_fpenv_init();
+
+  std::string weights_dir = "weights";
+  std::string ids_path;
+  int layer = 0;
+  for (int i = 1; i < argc; ++i) {
+    std::string a = argv[i];
+    if (a == "--weights-dir" && i + 1 < argc) weights_dir = argv[++i];
+    else if (a == "--ids" && i + 1 < argc) ids_path = argv[++i];
+    else if (a == "--layer" && i + 1 < argc) layer = atoi(argv[++i]);
+    else { fprintf(stderr, "FATAL: unknown arg %s\n", a.c_str()); return 2; }
+  }
+  if (ids_path.empty()) { fprintf(stderr, "FATAL: --ids required\n"); return 2; }
+
+  const std::string weights_path = weights_dir + "/model.safetensors";
+  const std::string config_path = weights_dir + "/config.json";
+
+  Cis2Json cfg = cis2_json_parse(cis2_read_file(config_path));
+  auto need = [&](const char *k) -> const Cis2Json & {
+    const Cis2Json *v = cfg.get(k);
+    if (!v) { fprintf(stderr, "FATAL: config.json missing %s\n", k); exit(2); }
+    return *v;
+  };
+  const int H = (int)need("hidden_size").num;
+  const int V = (int)need("vocab_size").num;
+  const int n = H, k = H;  // q_proj is [H,H]
+
+  fprintf(stderr, "gpu2 sweep: real weights, layer=%d hidden_size=%d vocab=%d "
+                   "(CIS2_DEVICE_IS_HOST=%d)\n", layer, H, V, CIS2_DEVICE_IS_HOST);
+
+  Cis2SafeTensors st;
+  st.open(weights_path);
+  char qname[128];
+  snprintf(qname, sizeof(qname), "model.layers.%d.self_attn.q_proj.weight", layer);
+  float *w_dev = st.load_bf16(qname, {(size_t)H, (size_t)H});
+  float *embed_dev = st.load_bf16("model.embed_tokens.weight", {(size_t)V, (size_t)H});
+
+  std::vector<uint32_t> ids = read_ids(ids_path);
+  const int B_MAX = 8;
+  if ((int)ids.size() < B_MAX) {
+    fprintf(stderr, "FATAL: need >=%d token ids in %s, got %zu\n", B_MAX, ids_path.c_str(), ids.size());
+    return 2;
+  }
+
+  // Gather B_MAX real embedding rows (row-major x[B][k]) from the real
+  // embed_tokens tensor at the real token ids -- one cis2_download per
+  // row (cheap: H floats each), no full-vocab download needed.
+  std::vector<float> x_host((size_t)B_MAX * k);
+  for (int b = 0; b < B_MAX; ++b) {
+    uint32_t tid = ids[(size_t)b];
+    if ((int)tid >= V) { fprintf(stderr, "FATAL: token id %u out of vocab %d\n", tid, V); return 2; }
+    cis2_download_f(x_host.data() + (size_t)b * k, embed_dev + (size_t)tid * H, (size_t)H);
+  }
+
+  // Real weight matrix, downloaded to host once for int8 quantization
+  // (quantization itself runs host-side, deterministic; the arithmetic
+  // under test is the on-the-fly dequant matmul, not this step -- see
+  // module docstring).
+  std::vector<float> w_host((size_t)n * k);
+  cis2_download_f(w_host.data(), w_dev, (size_t)n * k);
+  std::vector<int8_t> w_i8_host((size_t)n * k);
+  std::vector<float> w_scale_host((size_t)n);
+  for (int j = 0; j < n; ++j) {
+    w_scale_host[(size_t)j] = cis2_quantize_row_i8(
+        w_host.data() + (size_t)j * k, k, w_i8_host.data() + (size_t)j * k);
+  }
+
+  float *x_dev = cis2_dev_alloc((size_t)B_MAX * k);
+  cis2_upload(x_dev, x_host.data(), (size_t)B_MAX * k);
+  int8_t *w_i8_dev = cis2_dev_alloc_i8((size_t)n * k);
+  cis2_upload_i8(w_i8_dev, w_i8_host.data(), (size_t)n * k);
+  float *w_scale_dev = cis2_dev_alloc((size_t)n);
+  cis2_upload(w_scale_dev, w_scale_host.data(), (size_t)n);
+
+  // ---- Anchor: batch1_fp32 (independent cis2_dot_seq, row 0 only) -----
+  float *anchor_dev = cis2_dev_alloc((size_t)n);
+  cis2_for_each(1, [=] CIS2_FN (int) {
+    for (int j = 0; j < n; ++j)
+      anchor_dev[j] = cis2_dot_seq(x_dev, w_dev + (size_t)j * k, k);
+  });
+  std::vector<float> anchor_host((size_t)n);
+  cis2_download_f(anchor_host.data(), anchor_dev, (size_t)n);
+  Cis2Sha256 ah; ah.update(anchor_host.data(), anchor_host.size() * sizeof(float));
+  unsigned char anchor_dig[32]; ah.finalize(anchor_dig);
+  {
+    std::string hexa = cis2_hex(anchor_dig, 32);
+    printf("SWEEP config=host_control_batch1_fp32 digest=%s vs_cpu_batch1=MATCH diffs=0/%d\n",
+           hexa.c_str(), n);
+  }
+
+  // ---- 9 configs: batch in {1,4,8} x kernel in {seq, grouped, int8} ---
+  const int batches[3] = {1, 4, 8};
+  for (int bi = 0; bi < 3; ++bi) {
+    int B = batches[bi];
+
+    float *out_seq_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_seq(B, n, k, x_dev, w_dev, out_seq_dev);
+    });
+    std::vector<float> out_seq_host((size_t)B * n);
+    cis2_download_f(out_seq_host.data(), out_seq_dev, (size_t)B * n);
+    char label[64];
+    snprintf(label, sizeof(label), "batch%d_fp32_seq", B);
+    report(label, out_seq_host.data(), out_seq_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    float *out_grp_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_grouped(B, n, k, x_dev, w_dev, out_grp_dev);
+    });
+    std::vector<float> out_grp_host((size_t)B * n);
+    cis2_download_f(out_grp_host.data(), out_grp_dev, (size_t)B * n);
+    snprintf(label, sizeof(label), "batch%d_fp32_grouped", B);
+    report(label, out_grp_host.data(), out_grp_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    float *out_i8_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_int8(B, n, k, x_dev, w_i8_dev, w_scale_dev, out_i8_dev);
+    });
+    std::vector<float> out_i8_host((size_t)B * n);
+    cis2_download_f(out_i8_host.data(), out_i8_dev, (size_t)B * n);
+    snprintf(label, sizeof(label), "batch%d_int8", B);
+    report(label, out_i8_host.data(), out_i8_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    cis2_dev_free(out_seq_dev);
+    cis2_dev_free(out_grp_dev);
+    cis2_dev_free(out_i8_dev);
+  }
+
+  printf("SWEEP_DONE weights=%s ids=%s layer=%d hidden_size=%d n_ids=%zu\n",
+         weights_path.c_str(), ids_path.c_str(), layer, H, ids.size());
+  return 0;
+}
