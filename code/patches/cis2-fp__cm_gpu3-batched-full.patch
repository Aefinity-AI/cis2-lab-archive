+++ b/gpu/kaggle_gpu2/plan.py
@@ -0,0 +1,272 @@
+"""gpu2 leg (QUEUE item gpu-2), BATCH_INT8_DESIGN.md steps 5-6: build
+gpu/cis2_sweep.cpp with nvcc and run it on a Kaggle GPU, sweeping
+batch={1,4,8} x {fp32-seq, fp32-grouped, int8} against a single REAL
+weight matrix (SmolLM2-135M layer 0's self_attn.q_proj, [576,576]) and
+REAL token embeddings, printing one `SWEEP config=... digest=...
+vs_cpu_batch1=MATCH|MISMATCH diffs=n/total` line per config (9 total) --
+see gpu/cis2_sweep.cpp's module docstring for the exact scope statement
+(one real weight matrix, not a full forward pass) and the row-0 anchor
+design.
+
+Reuses ../kaggle/e18b_gpu.py's patterns: find_dataset() (content-based
+mount discovery), nvcc_link() (a real LINKED executable, not `make ...
+cuda`'s object-only target), gpu_name_and_arch() (P100 sm_60 vs T4
+sm_75), and the same NVCCFLAGS_BASE (kept flag-for-flag identical --
+this is what previously reproduced host fp32 bit-for-bit on Kaggle's
+CUDA path).
+
+Data sources (both already-existing Kaggle datasets, no new weights
+upload):
+  - aefinityaiinc/cis2-e18b-gpu      : weights/ (SmolLM2-135M
+    config.json + model.safetensors + tokenizer.json) and
+    gate/ids_16tok.txt (Rust --dump-ids output: 4 real prompt ids
+    ONLY). This script builds+runs the real cis2_host driver against
+    those 4 prompt ids with --gen-toks 16, captures its 16 real
+    greedy-generated ids from stderr, and writes gate/ids_sweep20.txt
+    = 4 prompt ids + 16 generated ids (20 total, of which this sweep
+    uses the first 8) -- see step "2b" below.
+  - aefinityaiinc/gpu2-sweep-overlay : v2 -- this branch's FULL gpu/
+    source snapshot (cis2_fpenv.h, cis2_math.h, cis2_model.h,
+    cis2_sha256.h, cis2_sweep.cpp, cis2_host.cpp), not just
+    cis2_sweep.cpp/cis2_math.h. v1 shipped only those two files, so the
+    cuda build pulled a STALE cis2_fpenv.h from the base
+    cis2-e18b-gpu dataset (predates commit 8b81095's CIS2_CUDA_FTZ
+    guard) and always hit its old, differently-worded #error. Shipping
+    every repo gpu/*.h + *.cpp this branch touches or depends on avoids
+    any base-dataset/branch source-version mismatch, mirroring how
+    cis2-e18b-gpu-overlay/-overlay2 fully override E18's sources.
+
+This intentionally does NOT reach for a bigger/real forward-pass vector
+set: the task is "wire the batched/int8 functions ... so the sweep runs
+against the real cis2 test vectors/model weights already used by E18";
+this dataset (weights + gate ids) is exactly what E18/E18c already used
+and is already reachable from Kaggle at ~215 MB, comfortably inside the
+20 GB working cap, so no new upload was needed.
+
+Exit status: 0 if the build+run completed and every SWEEP line was
+printed; the run's build failing is the only thing that fails the leg.
+A MISMATCH in the grouped/int8 arms is an a-priori expected, honestly
+reported finding (fp32 non-associativity / quantization error) and does
+NOT affect exit status -- same convention as ../kaggle/e18b_gpu.py's
+CANDIDATE(tree) checks.
+"""
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+INPUT_ROOT = Path("/kaggle/input")
+WORK = Path("/kaggle/working/gpu2")
+GPU = WORK / "gpu"
+WEIGHTS = WORK / "weights"
+GATE = WORK / "gate"
+
+NVCC_ARCH = "sm_75"  # default T4; overridden to sm_60 if nvidia-smi reports P100
+NVCCFLAGS_BASE = [
+    "-x", "cu",
+    "-std=c++17", "-O2", "-fmad=false", "-ftz=true",
+    "-prec-div=true", "-prec-sqrt=true", "--extended-lambda",
+    "-DCIS2_CUDA_FTZ=1",
+    "-DCIS2_BATCH_GROUPED",
+]
+
+
+def hr(title):
+    print("\n" + "=" * 72)
+    print(title)
+    print("=" * 72)
+
+
+def run(cmd, **kw):
+    print(f"$ {' '.join(str(c) for c in cmd)}")
+    try:
+        p = subprocess.run(cmd, capture_output=True, text=True, **kw)
+    except (FileNotFoundError, OSError) as e:
+        print(f"  (command failed to start: {e})", file=sys.stderr)
+        return subprocess.CompletedProcess(cmd, returncode=127, stdout="", stderr=str(e))
+    if p.stdout:
+        print(p.stdout)
+    if p.stderr:
+        print(p.stderr, file=sys.stderr)
+    return p
+
+
+def find_e18_dataset():
+    fixed = INPUT_ROOT / "cis2-e18b-gpu"
+    cands = [fixed] + [m.parent.parent for m in INPUT_ROOT.glob("**/gpu/Makefile")]
+    for c in cands:
+        if (c / "gpu" / "Makefile").exists() and (c / "weights").is_dir() \
+                and (c / "gate").is_dir():
+            return c
+    print("cis2-e18b-gpu dataset not found under /kaggle/input; tree (depth 4):")
+    for q in sorted(INPUT_ROOT.glob("*/**/"))[:200]:
+        if len(q.relative_to(INPUT_ROOT).parts) <= 4:
+            print("  ", q)
+    raise SystemExit("cis2-e18b-gpu dataset not mounted")
+
+
+def overlay_sweep_sources():
+    """Copy this branch's full gpu/ source snapshot (cis2_fpenv.h,
+    cis2_math.h, cis2_model.h, cis2_sha256.h, cis2_sweep.cpp,
+    cis2_host.cpp) over the staged gpu/ dir, so nothing stale from the
+    base cis2-e18b-gpu dataset's snapshot survives. Looks for any
+    mounted dataset that contains cis2_sweep.cpp (normally
+    aefinityaiinc/gpu2-sweep-overlay)."""
+    import hashlib
+    found = False
+    for cand in sorted(INPUT_ROOT.glob("**/cis2_sweep.cpp")):
+        od = cand.parent
+        for f in sorted(od.glob("*")):
+            if f.is_file() and f.suffix in (".h", ".cpp"):
+                shutil.copy2(f, GPU / f.name)
+                print(f"overlay {f.name} sha256={hashlib.sha256(f.read_bytes()).hexdigest()}")
+        found = True
+    if not found:
+        raise SystemExit("gpu2-sweep-overlay dataset (cis2_sweep.cpp) not mounted")
+
+
+def gpu_name_and_arch():
+    p = run(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"])
+    name = p.stdout.strip() if p.returncode == 0 else "UNKNOWN"
+    arch = NVCC_ARCH
+    if "P100" in name:
+        arch = "sm_60"
+    return name, arch
+
+
+def nvcc_link(src, out, arch):
+    flags = list(NVCCFLAGS_BASE) + [f"-arch={arch}", "-I", str(GPU)]
+    cmd = ["nvcc"] + flags + ["-o", str(out), str(src)]
+    p = run(cmd)
+    return p.returncode == 0 and out.exists()
+
+
+def host_link(src, out):
+    flags = ["-std=c++17", "-O2", "-DCIS2_BATCH_GROUPED"]
+    cmd = ["g++"] + flags + [str(src), "-o", str(out)]
+    p = run(cmd)
+    return p.returncode == 0 and out.exists()
+
+
+SWEEP_RE = re.compile(
+    r"^SWEEP config=(\S+) digest=([0-9a-f]{64}) vs_cpu_batch1=(MATCH|MISMATCH) diffs=(\d+)/(\d+)$"
+)
+
+
+def parse_sweep_lines(stdout: str):
+    rows = []
+    for line in stdout.splitlines():
+        m = SWEEP_RE.match(line.strip())
+        if m:
+            rows.append({
+                "config": m.group(1),
+                "digest": m.group(2),
+                "vs_cpu_batch1": m.group(3),
+                "diffs": int(m.group(4)),
+                "total": int(m.group(5)),
+            })
+    return rows
+
+
+def main():
+    hr("0. Environment")
+    run(["nvcc", "--version"])
+    gpu_name, arch = gpu_name_and_arch()
+    print(f"GPU name (nvidia-smi): {gpu_name}")
+    print(f"Selected NVCC_ARCH: {arch}")
+
+    hr("1. Stage cis2-e18b-gpu dataset (real weights + gate ids)")
+    e18_ds = find_e18_dataset()
+    print(f"cis2-e18b-gpu mounted at: {e18_ds}")
+    if WORK.exists():
+        shutil.rmtree(WORK)
+    shutil.copytree(e18_ds / "gpu", GPU)
+    shutil.copytree(e18_ds / "weights", WEIGHTS)
+    shutil.copytree(e18_ds / "gate", GATE)
+
+    hr("2. Overlay this branch's full gpu/ source snapshot")
+    overlay_sweep_sources()
+
+    prompt_ids_file = GATE / "ids_16tok.txt"
+    if not prompt_ids_file.exists():
+        raise SystemExit(f"expected ids file missing: {prompt_ids_file}")
+    print(f"prompt ids file: {prompt_ids_file} -> {prompt_ids_file.read_text().strip()}")
+
+    hr("2b. Build + run real cis2_host driver to get the 16 generated ids")
+    # ids_16tok.txt (Rust --dump-ids output) holds ONLY the 4 prompt token
+    # ids -- --dump-ids never emits generated ids. The 16 greedy-generated
+    # ids used by this sweep must come from an actual host decode run.
+    import hashlib
+    host_gate_bin = GPU / "cis2_host_gcc"
+    host_gate_built = host_link(GPU / "cis2_host.cpp", host_gate_bin)
+    print(f"---- cis2_host build: {'OK' if host_gate_built else 'FAILED'}")
+    if not host_gate_built:
+        raise SystemExit("cis2_host (gate driver) failed to build")
+    p = run([str(host_gate_bin), "--weights-dir", str(WEIGHTS),
+             "--ids", str(prompt_ids_file), "--gen-toks", "16"])
+    gen_ids = [int(m.group(1)) for m in
+               re.finditer(r"\[run1\] step \d+: token_id=(\d+)", p.stderr)]
+    if len(gen_ids) != 16:
+        raise SystemExit(f"expected 16 generated ids from cis2_host stderr, got {len(gen_ids)}")
+    prompt_ids = [int(x) for x in prompt_ids_file.read_text().split()]
+    sweep_ids = prompt_ids + gen_ids
+    ids_file = GATE / "ids_sweep20.txt"
+    ids_file.write_text("\n".join(str(x) for x in sweep_ids) + "\n")
+    print(f"ids_sweep20.txt ({len(sweep_ids)} ids):")
+    print(ids_file.read_text())
+    print(f"ids_sweep20.txt sha256={hashlib.sha256(ids_file.read_bytes()).hexdigest()}")
+
+    host_digest_m = re.search(r"run1_witness_digest=([0-9a-f]{64})", p.stdout)
+    host_digest = host_digest_m.group(1) if host_digest_m else None
+    expected_path = GATE / "expected_digests.json"
+    expected_digest = None
+    if expected_path.exists():
+        import json
+        try:
+            expected_digest = json.loads(expected_path.read_text())["sequential"]["16"]["digest"]
+        except Exception as e:
+            print(f"(could not read expected_digests.json: {e})")
+    verdict = "MATCH" if (host_digest and expected_digest and host_digest == expected_digest) else "MISMATCH"
+    print(f"HOST_GATE digest={host_digest} expected={expected_digest} {verdict}")
+
+    hr("3. Build: host control (g++, CPU)")
+    host_bin = GPU / "cis2_sweep_host"
+    host_built = host_link(GPU / "cis2_sweep.cpp", host_bin)
+    print(f"---- host build: {'OK' if host_built else 'FAILED'}")
+
+    hr("4. Build: nvcc link (real GPU execution via cis2_for_each)")
+    cuda_bin = GPU / "cis2_sweep_cuda"
+    cuda_built = nvcc_link(GPU / "cis2_sweep.cpp", cuda_bin, arch)
+    print(f"---- cuda build ({arch}): {'OK' if cuda_built else 'FAILED'}")
+
+    if not host_built and not cuda_built:
+        print("FATAL: neither host nor cuda build succeeded; aborting run.")
+        sys.exit(1)
+
+    all_rows = {}
+
+    if host_built:
+        hr("5. Run: host control (CPU)")
+        p = run([str(host_bin), "--weights-dir", str(WEIGHTS), "--ids", str(ids_file), "--layer", "0"])
+        all_rows["host"] = {"returncode": p.returncode, "rows": parse_sweep_lines(p.stdout)}
+
+    if cuda_built:
+        hr("6. Run: cuda (real GPU, T4/P100 via nvidia-smi detection above)")
+        p = run([str(cuda_bin), "--weights-dir", str(WEIGHTS), "--ids", str(ids_file), "--layer", "0"])
+        all_rows["cuda"] = {"returncode": p.returncode, "rows": parse_sweep_lines(p.stdout)}
+
+    hr("7. Results table")
+    for mode, res in all_rows.items():
+        print(f"-- {mode}: returncode={res['returncode']}, {len(res['rows'])} SWEEP lines parsed")
+        for r in res["rows"]:
+            print(f"   {mode:5s} config={r['config']:24s} digest={r['digest'][:16]}... "
+                  f"vs_cpu_batch1={r['vs_cpu_batch1']:9s} diffs={r['diffs']}/{r['total']}")
+
+    n_match = sum(1 for res in all_rows.values() for r in res["rows"] if r["vs_cpu_batch1"] == "MATCH")
+    n_total = sum(len(res["rows"]) for res in all_rows.values())
+    print(f"\nSWEEP_SUMMARY matched={n_match}/{n_total}")
+
+
+if __name__ == "__main__":
+    main()
