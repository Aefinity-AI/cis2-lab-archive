+// gpu/cis2_sha256.h — self-contained SHA-256 (FIPS 180-4), host-only.
+// Used for the CIS-2 §12 witness/receipt digests and the §6.6 table digest.
+// Plain integer arithmetic; not part of the pinned fp32 path.
+
+#ifndef CIS2_SHA256_H
+#define CIS2_SHA256_H
+
+#include <stdint.h>
+#include <string.h>
+#include <string>
+
+struct Cis2Sha256 {
+  uint32_t h[8];
+  uint64_t len;
+  unsigned char buf[64];
+  size_t buflen;
+
+  Cis2Sha256() { reset(); }
+  void reset() {
+    h[0] = 0x6a09e667; h[1] = 0xbb67ae85; h[2] = 0x3c6ef372; h[3] = 0xa54ff53a;
+    h[4] = 0x510e527f; h[5] = 0x9b05688c; h[6] = 0x1f83d9ab; h[7] = 0x5be0cd19;
+    len = 0; buflen = 0;
+  }
+  static uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+
+  void block(const unsigned char *p) {
+    static const uint32_t K[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,
+        0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,
+        0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,
+        0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,
+        0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,
+        0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,
+        0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,
+        0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,
+        0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    uint32_t w[64];
+    for (int i = 0; i < 16; ++i)
+      w[i] = ((uint32_t)p[4*i] << 24) | ((uint32_t)p[4*i+1] << 16) |
+             ((uint32_t)p[4*i+2] << 8) | (uint32_t)p[4*i+3];
+    for (int i = 16; i < 64; ++i) {
+      uint32_t s0 = rotr(w[i-15],7) ^ rotr(w[i-15],18) ^ (w[i-15] >> 3);
+      uint32_t s1 = rotr(w[i-2],17) ^ rotr(w[i-2],19) ^ (w[i-2] >> 10);
+      w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    uint32_t a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],hh=h[7];
+    for (int i = 0; i < 64; ++i) {
+      uint32_t S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
+      uint32_t ch = (e & f) ^ ((~e) & g);
+      uint32_t t1 = hh + S1 + ch + K[i] + w[i];
+      uint32_t S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
+      uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+      uint32_t t2 = S0 + maj;
+      hh=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d; h[4]+=e; h[5]+=f; h[6]+=g; h[7]+=hh;
+  }
+
+  void update(const void *data, size_t n) {
+    const unsigned char *p = (const unsigned char *)data;
+    len += n;
+    while (n) {
+      size_t take = 64 - buflen;
+      if (take > n) take = n;
+      memcpy(buf + buflen, p, take);
+      buflen += take; p += take; n -= take;
+      if (buflen == 64) { block(buf); buflen = 0; }
+    }
+  }
+  void update_u32le(uint32_t v) {
+    unsigned char b[4] = {(unsigned char)(v & 0xFF), (unsigned char)((v >> 8) & 0xFF),
+                          (unsigned char)((v >> 16) & 0xFF), (unsigned char)((v >> 24) & 0xFF)};
+    update(b, 4);
+  }
+  void finalize(unsigned char out[32]) {
+    uint64_t bits = len * 8;
+    unsigned char pad = 0x80;
+    update(&pad, 1);
+    unsigned char z = 0;
+    while (buflen != 56) update(&z, 1);
+    unsigned char lb[8];
+    for (int i = 0; i < 8; ++i) lb[i] = (unsigned char)((bits >> (56 - 8 * i)) & 0xFF);
+    update(lb, 8);
+    for (int i = 0; i < 8; ++i) {
+      out[4*i]   = (unsigned char)((h[i] >> 24) & 0xFF);
+      out[4*i+1] = (unsigned char)((h[i] >> 16) & 0xFF);
+      out[4*i+2] = (unsigned char)((h[i] >> 8) & 0xFF);
+      out[4*i+3] = (unsigned char)(h[i] & 0xFF);
+    }
+  }
+};
+
+inline std::string cis2_hex(const unsigned char *b, size_t n) {
+  static const char *d = "0123456789abcdef";
+  std::string s;
+  s.reserve(n * 2);
+  for (size_t i = 0; i < n; ++i) { s.push_back(d[b[i] >> 4]); s.push_back(d[b[i] & 15]); }
+  return s;
+}
+
+// SHA-256 over the raw little-endian f32 BIT PATTERNS of a slice — the
+// per-(layer, op) trace hash and the inv_freq table digest both use this.
+inline void cis2_sha256_f32_bits(const float *xs, size_t n, unsigned char out[32]) {
+  Cis2Sha256 h;
+  for (size_t i = 0; i < n; ++i) {
+    union { float f; uint32_t u; } c; c.f = xs[i];
+    h.update_u32le(c.u);
+  }
+  h.finalize(out);
+}
+
+#endif  // CIS2_SHA256_H
diff --git a/gpu/kaggle_gpu2/overlay_staging/cis2_sweep.cpp b/gpu/kaggle_gpu2/overlay_staging/cis2_sweep.cpp
new file mode 100644
index 0000000..e6e5f3a
--- /dev/null
+++ b/gpu/kaggle_gpu2/overlay_staging/cis2_sweep.cpp
@@ -0,0 +1,255 @@
+// gpu/cis2_sweep.cpp -- gpu2 (QUEUE gpu-2) BATCH_INT8_DESIGN.md steps 5-6:
+// batch={1,4,8} x {fp32-seq, fp32-grouped, int8} digest sweep run against
+// REAL cis2 model weights + real token embeddings already used by
+// E18/E18c (gpu/EXPECTED_DIGESTS.md's SmolLM2-135M checkpoint), not
+// synthetic xorshift32 data (that was steps 2-4's gpu/test_batch.cpp,
+// unchanged and still passing -- see BATCH_INT8_DESIGN.md).
+//
+// SCOPE, stated honestly up front: this is NOT a full forward pass /
+// generation run. It exercises ONE real weight matrix -- layer 0's
+// `self_attn.q_proj.weight`, shape [hidden_size, hidden_size]
+// (576x576 for SmolLM2-135M, BF16 widened to fp32 exactly as
+// cis2_host.cpp's own load_bf16 does, no new widening code) -- against
+// up to 8 REAL `model.embed_tokens.weight` rows selected by the ACTUAL
+// token ids in gate/ids_sweep20.txt, which plan.py builds at run time
+// by running the real cis2_host binary against the gate's
+// ids_16tok.txt (4 real prompt ids only -- the Rust --dump-ids file
+// never contains generated ids) with --gen-toks 16 and capturing its
+// stderr `[run1] step N: token_id=U` lines: 4 real prompt ids + 16 real
+// greedy-generated ids = 20 available ids, of which the first 8 are
+// used here. A full multi-layer batched forward
+// pass (attention, RoPE, softmax, MLP, KV-cache, all batched) is real
+// kernel-engineering work this branch's remaining budget does not cover;
+// BATCH_INT8_DESIGN.md's own next-steps list this as future work.
+// Reusing exactly one real weight tensor + real embeddings (rather than
+// synthetic data) is the given task's step-5 instruction: "wire the
+// batched/int8 functions into plan.py's digest table so the sweep runs
+// against the real cis2 test vectors/model weights already used by
+// E18" -- and it is within the 20 GB Kaggle working-directory cap (the
+// existing cis2-e18b-gpu dataset is ~215 MB total, see
+// gpu/kaggle/make_dataset.sh).
+//
+// Anchor ("vs_cpu_batch1" in every SWEEP line): row 0's output, computed
+// directly by the unmodified `cis2_dot_seq` for each of the n=hidden_size
+// output columns -- independent of any of the three batched kernels
+// below, and independent of B. Every other config's row-0 output slice
+// (n elements, the only row present at every tested batch size) is
+// compared against this same anchor; diffs=<k>/<n> counts bitwise
+// float-inequal elements in that row-0 slice.
+//
+// Device execution: when built with nvcc (CIS2_DEVICE_IS_HOST==0, see
+// cis2_model.h), every config below (including the anchor) runs inside a
+// single cis2_for_each(1, ...) device-lambda launch -- a real kernel
+// launch executing cis2_dot_seq / cis2_matmul_batched_{seq,grouped,int8}
+// (unmodified, same source as the CPU-only gpu/test_batch*.cpp checks)
+// on the GPU, with the same -fmad=false -ftz=true -prec-div=true
+// -prec-sqrt=true flags gpu/kaggle/e18b_gpu.py already established
+// reproduce host fp32 arithmetic bit-for-bit on this repo's CUDA path.
+// On a host build (g++/clang++, no __CUDACC__) cis2_for_each(1, f) is
+// just `f(0)` -- this is the CPU control this file reports as
+// host_control_batch1_fp32.
+
+#include "cis2_fpenv.h"
+#include "cis2_math.h"
+#include "cis2_model.h"
+#include "cis2_sha256.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <string>
+#include <vector>
+
+static std::vector<uint32_t> read_ids(const std::string &path) {
+  std::string text = cis2_read_file(path);
+  std::vector<uint32_t> ids;
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && (text[i] == '\n' || text[i] == '\r' ||
+                               text[i] == ' ' || text[i] == '\t' || text[i] == ','))
+      ++i;
+    if (i >= text.size()) break;
+    size_t j = i;
+    while (j < text.size() && text[j] >= '0' && text[j] <= '9') ++j;
+    if (j == i) { fprintf(stderr, "FATAL: %s: bad token id byte %zu\n", path.c_str(), i); exit(2); }
+    ids.push_back((uint32_t)strtoul(text.substr(i, j - i).c_str(), nullptr, 10));
+    i = j;
+  }
+  if (ids.empty()) { fprintf(stderr, "FATAL: %s: no token ids\n", path.c_str()); exit(2); }
+  return ids;
+}
+
+// int8 device buffer helpers -- mirror cis2_dev_alloc/cis2_upload's
+// CIS2_DEVICE_IS_HOST split (cis2_model.h) but for int8_t, which that
+// file does not provide (it only ever moves float buffers).
+#if CIS2_DEVICE_IS_HOST
+static int8_t *cis2_dev_alloc_i8(size_t n) {
+  int8_t *p = (int8_t *)malloc(n);
+  if (!p) { fprintf(stderr, "FATAL: malloc(%zu i8) failed\n", n); exit(2); }
+  return p;
+}
+static void cis2_upload_i8(int8_t *d, const int8_t *h, size_t n) { if (d != h) memcpy(d, h, n); }
+static void cis2_download_f(float *h, const float *d, size_t n) { if (h != d) memcpy(h, d, n * sizeof(float)); }
+#else
+static int8_t *cis2_dev_alloc_i8(size_t n) {
+  int8_t *p = nullptr;
+  if (cudaMalloc(&p, n) != cudaSuccess) { fprintf(stderr, "FATAL: cudaMalloc(%zu i8) failed\n", n); exit(2); }
+  return p;
+}
+static void cis2_upload_i8(int8_t *d, const int8_t *h, size_t n) { cudaMemcpy(d, h, n, cudaMemcpyHostToDevice); }
+static void cis2_download_f(float *h, const float *d, size_t n) { cudaMemcpy(h, d, n * sizeof(float), cudaMemcpyDeviceToHost); }
+#endif
+
+static void report(const char *config, const float *out, size_t total,
+                    const float *anchor_row0, int n, int rowstride,
+                    unsigned char anchor_dig[32]) {
+  Cis2Sha256 h;
+  h.update(out, total * sizeof(float));
+  unsigned char dig[32];
+  h.finalize(dig);
+  std::string hex = cis2_hex(dig, 32);
+
+  int diffs = 0;
+  for (int j = 0; j < n; ++j) {
+    if (out[j] != anchor_row0[j]) ++diffs;  // row 0 is out[0*rowstride + j]
+  }
+  bool full_match = (memcmp(dig, anchor_dig, 32) == 0);
+  printf("SWEEP config=%s digest=%s vs_cpu_batch1=%s diffs=%d/%d\n",
+         config, hex.c_str(), (diffs == 0 ? "MATCH" : "MISMATCH"), diffs, n);
+  (void)full_match; (void)rowstride;
+}
+
+int main(int argc, char **argv) {
+  cis2_fpenv_init();
+
+  std::string weights_dir = "weights";
+  std::string ids_path;
+  int layer = 0;
+  for (int i = 1; i < argc; ++i) {
+    std::string a = argv[i];
+    if (a == "--weights-dir" && i + 1 < argc) weights_dir = argv[++i];
+    else if (a == "--ids" && i + 1 < argc) ids_path = argv[++i];
+    else if (a == "--layer" && i + 1 < argc) layer = atoi(argv[++i]);
+    else { fprintf(stderr, "FATAL: unknown arg %s\n", a.c_str()); return 2; }
+  }
+  if (ids_path.empty()) { fprintf(stderr, "FATAL: --ids required\n"); return 2; }
+
+  const std::string weights_path = weights_dir + "/model.safetensors";
+  const std::string config_path = weights_dir + "/config.json";
+
+  Cis2Json cfg = cis2_json_parse(cis2_read_file(config_path));
+  auto need = [&](const char *k) -> const Cis2Json & {
+    const Cis2Json *v = cfg.get(k);
+    if (!v) { fprintf(stderr, "FATAL: config.json missing %s\n", k); exit(2); }
+    return *v;
+  };
+  const int H = (int)need("hidden_size").num;
+  const int V = (int)need("vocab_size").num;
+  const int n = H, k = H;  // q_proj is [H,H]
+
+  fprintf(stderr, "gpu2 sweep: real weights, layer=%d hidden_size=%d vocab=%d "
+                   "(CIS2_DEVICE_IS_HOST=%d)\n", layer, H, V, CIS2_DEVICE_IS_HOST);
+
+  Cis2SafeTensors st;
+  st.open(weights_path);
+  char qname[128];
+  snprintf(qname, sizeof(qname), "model.layers.%d.self_attn.q_proj.weight", layer);
+  float *w_dev = st.load_bf16(qname, {(size_t)H, (size_t)H});
+  float *embed_dev = st.load_bf16("model.embed_tokens.weight", {(size_t)V, (size_t)H});
+
+  std::vector<uint32_t> ids = read_ids(ids_path);
+  const int B_MAX = 8;
+  if ((int)ids.size() < B_MAX) {
+    fprintf(stderr, "FATAL: need >=%d token ids in %s, got %zu\n", B_MAX, ids_path.c_str(), ids.size());
+    return 2;
+  }
+
+  // Gather B_MAX real embedding rows (row-major x[B][k]) from the real
+  // embed_tokens tensor at the real token ids -- one cis2_download per
+  // row (cheap: H floats each), no full-vocab download needed.
+  std::vector<float> x_host((size_t)B_MAX * k);
+  for (int b = 0; b < B_MAX; ++b) {
+    uint32_t tid = ids[(size_t)b];
+    if ((int)tid >= V) { fprintf(stderr, "FATAL: token id %u out of vocab %d\n", tid, V); return 2; }
+    cis2_download_f(x_host.data() + (size_t)b * k, embed_dev + (size_t)tid * H, (size_t)H);
+  }
+
+  // Real weight matrix, downloaded to host once for int8 quantization
+  // (quantization itself runs host-side, deterministic; the arithmetic
+  // under test is the on-the-fly dequant matmul, not this step -- see
+  // module docstring).
+  std::vector<float> w_host((size_t)n * k);
+  cis2_download_f(w_host.data(), w_dev, (size_t)n * k);
+  std::vector<int8_t> w_i8_host((size_t)n * k);
+  std::vector<float> w_scale_host((size_t)n);
+  for (int j = 0; j < n; ++j) {
+    w_scale_host[(size_t)j] = cis2_quantize_row_i8(
+        w_host.data() + (size_t)j * k, k, w_i8_host.data() + (size_t)j * k);
+  }
+
+  float *x_dev = cis2_dev_alloc((size_t)B_MAX * k);
+  cis2_upload(x_dev, x_host.data(), (size_t)B_MAX * k);
+  int8_t *w_i8_dev = cis2_dev_alloc_i8((size_t)n * k);
+  cis2_upload_i8(w_i8_dev, w_i8_host.data(), (size_t)n * k);
+  float *w_scale_dev = cis2_dev_alloc((size_t)n);
+  cis2_upload(w_scale_dev, w_scale_host.data(), (size_t)n);
+
+  // ---- Anchor: batch1_fp32 (independent cis2_dot_seq, row 0 only) -----
+  float *anchor_dev = cis2_dev_alloc((size_t)n);
+  cis2_for_each(1, [=] CIS2_FN (int) {
+    for (int j = 0; j < n; ++j)
+      anchor_dev[j] = cis2_dot_seq(x_dev, w_dev + (size_t)j * k, k);
+  });
+  std::vector<float> anchor_host((size_t)n);
+  cis2_download_f(anchor_host.data(), anchor_dev, (size_t)n);
+  Cis2Sha256 ah; ah.update(anchor_host.data(), anchor_host.size() * sizeof(float));
+  unsigned char anchor_dig[32]; ah.finalize(anchor_dig);
+  {
+    std::string hexa = cis2_hex(anchor_dig, 32);
+    printf("SWEEP config=host_control_batch1_fp32 digest=%s vs_cpu_batch1=MATCH diffs=0/%d\n",
+           hexa.c_str(), n);
+  }
+
+  // ---- 9 configs: batch in {1,4,8} x kernel in {seq, grouped, int8} ---
+  const int batches[3] = {1, 4, 8};
+  for (int bi = 0; bi < 3; ++bi) {
+    int B = batches[bi];
+
+    float *out_seq_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_seq(B, n, k, x_dev, w_dev, out_seq_dev);
+    });
+    std::vector<float> out_seq_host((size_t)B * n);
+    cis2_download_f(out_seq_host.data(), out_seq_dev, (size_t)B * n);
+    char label[64];
+    snprintf(label, sizeof(label), "batch%d_fp32_seq", B);
+    report(label, out_seq_host.data(), out_seq_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    float *out_grp_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_grouped(B, n, k, x_dev, w_dev, out_grp_dev);
+    });
+    std::vector<float> out_grp_host((size_t)B * n);
+    cis2_download_f(out_grp_host.data(), out_grp_dev, (size_t)B * n);
+    snprintf(label, sizeof(label), "batch%d_fp32_grouped", B);
+    report(label, out_grp_host.data(), out_grp_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    float *out_i8_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_int8(B, n, k, x_dev, w_i8_dev, w_scale_dev, out_i8_dev);
+    });
+    std::vector<float> out_i8_host((size_t)B * n);
+    cis2_download_f(out_i8_host.data(), out_i8_dev, (size_t)B * n);
+    snprintf(label, sizeof(label), "batch%d_int8", B);
+    report(label, out_i8_host.data(), out_i8_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    cis2_dev_free(out_seq_dev);
+    cis2_dev_free(out_grp_dev);
+    cis2_dev_free(out_i8_dev);
+  }
+
+  printf("SWEEP_DONE weights=%s ids=%s layer=%d hidden_size=%d n_ids=%zu\n",
+         weights_path.c_str(), ids_path.c_str(), layer, H, ids.size());
+  return 0;
+}
