+// gpu/cis2_model.h — CIS-2 v0.3b forward pass as index-space kernels,
+// single-source CUDA-portable C++17.
+//
+// Mirrors src/main.rs statement for statement. See gpu/README.md §3 for the
+// op -> Rust-function -> reduction-order table and §4 for the twenty-five
+// places where the Rust's evaluation order is not obvious.
+//
+// KERNEL MODEL
+//   Every kernel is one lambda over an index space, dispatched through
+//   `cis2_for_each(n, f)`:
+//     * host build : a plain `for (int i = 0; i < n; ++i) f(i);`
+//     * nvcc build : a grid launch of `n` threads, one per index.
+//   The kernel bodies are the SAME source text in both builds; only the
+//   dispatcher differs. Index spaces are chosen so that each thread owns
+//   exactly one output element and performs that element's reduction
+//   serially, in the order §5.1/§5.3 pin — which is what makes the two
+//   builds bit-identical rather than merely close.
+//
+//   Reductions that the spec pins as a single strict left-to-right fold
+//   over the WHOLE vector (RMSNorm's sum of squares, softmax's max scan and
+//   denominator) are therefore one-thread kernels by construction. That is
+//   the intended cost of v0.3b's strict order, not an oversight.
+
+#ifndef CIS2_MODEL_H
+#define CIS2_MODEL_H
+
+#include "cis2_math.h"
+#include "cis2_sha256.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <string>
+#include <vector>
+
+// =====================================================================
+// 1. Index-space dispatch and device memory
+// =====================================================================
+
+#if defined(__CUDACC__)
+
+template <class F>
+__global__ void cis2_index_kernel(int n, F f) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) f(i);
+}
+
+// NOTE: never compiled on this box (no nvcc, no GPU). Requires
+// `--extended-lambda`; see gpu/Makefile's `cuda` target.
+template <class F>
+inline void cis2_for_each(int n, F f) {
+  if (n <= 0) return;
+  const int threads = 256;
+  const int blocks = (n + threads - 1) / threads;
+  cis2_index_kernel<<<blocks, threads>>>(n, f);
+  cudaError_t e = cudaDeviceSynchronize();
+  if (e != cudaSuccess) {
+    fprintf(stderr, "FATAL: kernel launch failed: %s\n", cudaGetErrorString(e));
+    exit(2);
+  }
+}
+
+inline float *cis2_dev_alloc(size_t n) {
+  float *p = nullptr;
+  if (cudaMalloc(&p, n * sizeof(float)) != cudaSuccess) {
+    fprintf(stderr, "FATAL: cudaMalloc(%zu floats) failed\n", n);
+    exit(2);
+  }
+  return p;
+}
+inline void cis2_dev_free(float *p) { cudaFree(p); }
+inline void cis2_upload(float *d, const float *h, size_t n) {
+  cudaMemcpy(d, h, n * sizeof(float), cudaMemcpyHostToDevice);
+}
+inline void cis2_download(float *h, const float *d, size_t n) {
+  cudaMemcpy(h, d, n * sizeof(float), cudaMemcpyDeviceToHost);
+}
+#define CIS2_DEVICE_IS_HOST 0
+
+#else  // ---------------- host build ----------------
+
+template <class F>
+inline void cis2_for_each(int n, F f) {
+  for (int i = 0; i < n; ++i) f(i);
+}
+
+inline float *cis2_dev_alloc(size_t n) {
+  float *p = (float *)malloc(n * sizeof(float));
+  if (!p) {
+    fprintf(stderr, "FATAL: malloc(%zu floats) failed\n", n);
+    exit(2);
+  }
+  return p;
+}
+inline void cis2_dev_free(float *p) { free(p); }
+// On the host build the "device" pointer IS the host pointer, so an upload
+// or download of a buffer onto itself is a no-op and the weights are never
+// duplicated in memory.
+inline void cis2_upload(float *d, const float *h, size_t n) {
+  if (d != h) memcpy(d, h, n * sizeof(float));
+}
+inline void cis2_download(float *h, const float *d, size_t n) {
+  if (h != d) memcpy(h, d, n * sizeof(float));
+}
+#define CIS2_DEVICE_IS_HOST 1
+
+#endif
+
+// =====================================================================
+// 2. Minimal JSON reader (config.json and the safetensors header)
+// =====================================================================
+// Enough of RFC 8259 for the two documents this program reads. Numbers go
+// through strtod, i.e. correctly-rounded decimal -> double, which is what
+// serde_json gives the Rust reference; the single narrowing to f32 then
+// happens at exactly one place, as in src/main.rs.
+
+struct Cis2Json {
+  enum Kind { NUL, BOOL, NUM, STR, ARR, OBJ } kind = NUL;
+  bool b = false;
+  double num = 0.0;
+  std::string str;
+  std::vector<Cis2Json> arr;
+  std::vector<std::pair<std::string, Cis2Json>> obj;
+
+  const Cis2Json *get(const char *key) const {
+    if (kind != OBJ) return nullptr;
+    for (size_t i = 0; i < obj.size(); ++i)
+      if (obj[i].first == key) return &obj[i].second;
+    return nullptr;
+  }
+};
+
+struct Cis2JsonParser {
+  const char *p;
+  const char *end;
+
+  void ws() {
+    while (p < end && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) ++p;
+  }
+  [[noreturn]] void die(const char *what) {
+    fprintf(stderr, "FATAL: JSON parse error: %s\n", what);
+    exit(2);
+  }
+  std::string parse_string() {
+    if (p >= end || *p != '"') die("expected string");
+    ++p;
+    std::string s;
+    while (p < end && *p != '"') {
+      if (*p == '\\') {
+        ++p;
+        if (p >= end) die("truncated escape");
+        char c = *p++;
+        switch (c) {
+          case 'n': s.push_back('\n'); break;
+          case 't': s.push_back('\t'); break;
+          case 'r': s.push_back('\r'); break;
+          case 'b': s.push_back('\b'); break;
+          case 'f': s.push_back('\f'); break;
+          case '/': s.push_back('/'); break;
+          case '"': s.push_back('"'); break;
+          case '\\': s.push_back('\\'); break;
+          case 'u': {
+            if (end - p < 4) die("truncated \\u");
+            unsigned v = 0;
+            for (int i = 0; i < 4; ++i) {
+              char h = p[i];
+              v <<= 4;
+              if (h >= '0' && h <= '9') v |= (unsigned)(h - '0');
+              else if (h >= 'a' && h <= 'f') v |= (unsigned)(h - 'a' + 10);
+              else if (h >= 'A' && h <= 'F') v |= (unsigned)(h - 'A' + 10);
+              else die("bad \\u digit");
+            }
+            p += 4;
+            // The two documents parsed here are ASCII; keep it simple and
+            // faithful for the BMP-below-0x80 case, replace the rest.
+            s.push_back(v < 0x80 ? (char)v : '?');
+            break;
+          }
+          default: die("bad escape");
+        }
+      } else {
+        s.push_back(*p++);
+      }
+    }
+    if (p >= end) die("unterminated string");
+    ++p;
+    return s;
+  }
+  Cis2Json parse() {
+    ws();
+    if (p >= end) die("unexpected end");
+    Cis2Json v;
+    if (*p == '{') {
+      v.kind = Cis2Json::OBJ;
+      ++p; ws();
+      if (p < end && *p == '}') { ++p; return v; }
+      for (;;) {
+        ws();
+        std::string k = parse_string();
+        ws();
+        if (p >= end || *p != ':') die("expected ':'");
+        ++p;
+        v.obj.push_back(std::make_pair(k, parse()));
+        ws();
+        if (p < end && *p == ',') { ++p; continue; }
+        if (p < end && *p == '}') { ++p; return v; }
+        die("expected ',' or '}'");
+      }
+    }
+    if (*p == '[') {
+      v.kind = Cis2Json::ARR;
+      ++p; ws();
+      if (p < end && *p == ']') { ++p; return v; }
+      for (;;) {
+        v.arr.push_back(parse());
+        ws();
+        if (p < end && *p == ',') { ++p; continue; }
+        if (p < end && *p == ']') { ++p; return v; }
+        die("expected ',' or ']'");
+      }
+    }
+    if (*p == '"') { v.kind = Cis2Json::STR; v.str = parse_string(); return v; }
+    if (end - p >= 4 && memcmp(p, "true", 4) == 0) {
+      v.kind = Cis2Json::BOOL; v.b = true; p += 4; return v;
+    }
+    if (end - p >= 5 && memcmp(p, "false", 5) == 0) {
+      v.kind = Cis2Json::BOOL; v.b = false; p += 5; return v;
+    }
+    if (end - p >= 4 && memcmp(p, "null", 4) == 0) { p += 4; return v; }
+    {
+      char *stop = nullptr;
+      // strtod stops at the first character that cannot extend the number;
+      // the buffer is NUL-terminated by the caller.
+      double d = strtod(p, &stop);
+      if (stop == p) die("expected value");
+      v.kind = Cis2Json::NUM;
+      v.num = d;
+      p = stop;
+      return v;
+    }
+  }
+};
+
+inline Cis2Json cis2_json_parse(const std::string &text) {
+  Cis2JsonParser ps;
+  ps.p = text.c_str();
+  ps.end = text.c_str() + text.size();
+  return ps.parse();
+}
+
+inline std::string cis2_read_file(const std::string &path) {
+  FILE *f = fopen(path.c_str(), "rb");
+  if (!f) { fprintf(stderr, "FATAL: cannot open %s\n", path.c_str()); exit(2); }
+  fseek(f, 0, SEEK_END);
+  long n = ftell(f);
+  fseek(f, 0, SEEK_SET);
+  std::string s;
+  s.resize((size_t)n);
+  if (n && fread(&s[0], 1, (size_t)n, f) != (size_t)n) {
+    fprintf(stderr, "FATAL: short read on %s\n", path.c_str());
+    exit(2);
+  }
+  fclose(f);
+  return s;
+}
+
+inline void cis2_sha256_file(const std::string &path, unsigned char out[32]) {
+  FILE *f = fopen(path.c_str(), "rb");
+  if (!f) { fprintf(stderr, "FATAL: cannot open %s\n", path.c_str()); exit(2); }
+  Cis2Sha256 h;
+  static unsigned char buf[1 << 20];
+  size_t n;
+  while ((n = fread(buf, 1, sizeof(buf), f)) > 0) h.update(buf, n);
+  fclose(f);
+  h.finalize(out);
+}
+
+// =====================================================================
+// 3. safetensors reader (bf16 -> f32 exactly as src/math.rs::widen_bf16)
+// =====================================================================
+
+struct Cis2TensorView {
+  std::string dtype;
+  std::vector<size_t> shape;
+  size_t begin = 0, end = 0;  // byte offsets into the data section
+};
+
+struct Cis2SafeTensors {
+  std::string blob;  // whole file
+  const unsigned char *data = nullptr;  // start of the data section
+  size_t data_len = 0;
+  std::vector<std::pair<std::string, Cis2TensorView>> tensors;
+
+  void open(const std::string &path) {
+    blob = cis2_read_file(path);
+    if (blob.size() < 8) { fprintf(stderr, "FATAL: safetensors too short\n"); exit(2); }
+    uint64_t hlen = 0;
+    for (int i = 0; i < 8; ++i)
+      hlen |= (uint64_t)(unsigned char)blob[i] << (8 * i);
+    if (8 + hlen > blob.size()) {
+      fprintf(stderr, "FATAL: safetensors header length out of range\n");
+      exit(2);
+    }
+    std::string header(blob.data() + 8, (size_t)hlen);
+    Cis2Json j = cis2_json_parse(header);
+    if (j.kind != Cis2Json::OBJ) { fprintf(stderr, "FATAL: safetensors header not an object\n"); exit(2); }
+    for (size_t i = 0; i < j.obj.size(); ++i) {
+      if (j.obj[i].first == "__metadata__") continue;
+      const Cis2Json &t = j.obj[i].second;
+      Cis2TensorView v;
+      const Cis2Json *dt = t.get("dtype");
+      const Cis2Json *sh = t.get("shape");
+      const Cis2Json *of = t.get("data_offsets");
+      if (!dt || !sh || !of) continue;
+      v.dtype = dt->str;
+      for (size_t k = 0; k < sh->arr.size(); ++k)
+        v.shape.push_back((size_t)sh->arr[k].num);
+      v.begin = (size_t)of->arr[0].num;
+      v.end = (size_t)of->arr[1].num;
+      tensors.push_back(std::make_pair(j.obj[i].first, v));
+    }
+    data = (const unsigned char *)blob.data() + 8 + hlen;
+    data_len = blob.size() - 8 - (size_t)hlen;
+  }
+
+  const Cis2TensorView *find(const std::string &name) const {
+    for (size_t i = 0; i < tensors.size(); ++i)
+      if (tensors[i].first == name) return &tensors[i].second;
+    return nullptr;
+  }
+
+  bool has(const std::string &name) const { return find(name) != nullptr; }
+
+  // Widen a BF16 tensor into a device buffer. §4.1: the widening is the
+  // exact bit shift, performed as pure bit manipulation (no arithmetic, so
+  // FTZ/DAZ does not enter into it) — identical to
+  // src/main.rs::load_f32_tensor.
+  float *load_bf16(const std::string &name, const std::vector<size_t> &expect) const {
+    const Cis2TensorView *v = find(name);
+    if (!v) { fprintf(stderr, "FATAL: tensor %s missing\n", name.c_str()); exit(2); }
+    if (v->dtype != "BF16") {
+      fprintf(stderr, "FATAL: tensor %s dtype %s, expected BF16\n", name.c_str(), v->dtype.c_str());
+      exit(2);
+    }
+    if (v->shape != expect) {
+      fprintf(stderr, "FATAL: tensor %s shape mismatch\n", name.c_str());
+      exit(2);
+    }
+    size_t nbytes = v->end - v->begin;
+    if (nbytes % 2 || v->end > data_len) {
+      fprintf(stderr, "FATAL: tensor %s byte range invalid\n", name.c_str());
+      exit(2);
+    }
+    size_t n = nbytes / 2;
+    size_t want = 1;
+    for (size_t i = 0; i < expect.size(); ++i) want *= expect[i];
+    if (n != want) { fprintf(stderr, "FATAL: tensor %s element count mismatch\n", name.c_str()); exit(2); }
+    const unsigned char *raw = data + v->begin;
+    float *dev = cis2_dev_alloc(n);
+#if CIS2_DEVICE_IS_HOST
+    float *host = dev;   // widen straight into the buffer; no second copy
+#else
+    std::vector<float> stage(n);
+    float *host = stage.data();
+#endif
+    for (size_t i = 0; i < n; ++i) {
+      uint16_t bits = (uint16_t)raw[2 * i] | ((uint16_t)raw[2 * i + 1] << 8);
+      host[i] = cis2_widen_bf16(bits);
+    }
+    cis2_upload(dev, host, n);
+    return dev;
+  }
+};
+
+// =====================================================================
+// 4. Model
+// =====================================================================
+
+struct Cis2Layer {
+  const float *input_layernorm;
+  const float *post_attention_layernorm;
+  const float *q_proj;
+  const float *k_proj;
+  const float *v_proj;
+  const float *o_proj;
+  const float *gate_proj;
+  const float *up_proj;
+  const float *down_proj;
+  const float *q_bias;  // nullptr when the checkpoint has no bias tensors
+  const float *k_bias;
+  const float *v_bias;
+};
+
+struct Cis2Model {
+  const float *embed_tokens = nullptr;
+  const float *lm_head = nullptr;  // nullptr => tied to embed_tokens
+  const float *final_norm = nullptr;
+  const float *inv_freq = nullptr;
+  std::vector<Cis2Layer> layers;
+  int hidden = 0, inter = 0, n_layers = 0, n_heads = 0, n_kv_heads = 0;
+  int head_dim = 0, vocab = 0;
+  float eps = 0.0f;
+  std::vector<float> inv_freq_host;
+  unsigned char inv_freq_table_digest[32];
+
+  int kv_dim() const { return n_kv_heads * head_dim; }
+  const float *lm_head_weights() const { return lm_head ? lm_head : embed_tokens; }
+};
+
+// §6.6 table digest — the same coefficients in the same declared order as
+// src/math.rs::table_digest(), fed as raw little-endian bytes.
+inline void cis2_table_digest(unsigned char out[32]) {
+  // Explicit qualification, NOT `using namespace cis2_hostconst;`: under
+  // __CUDACC__, cis2_hostconst holds its OWN distinct `static const`
+  // copies of these names (cis2_math.h re-includes cis2_consts.inc inside
+  // the namespace, since the global copies are __device__ __constant__ and
+  // not host-addressable). A `using namespace` here would therefore bring
+  // a second, distinct LOG_P0 (etc.) into scope alongside the global one
+  // already visible from cis2_math.h's top-level include, making every
+  // unqualified reference ambiguous (~28 "ambiguous" errors under real
+  // nvcc device compilation). Host-only builds don't hit this because
+  // cis2_hostconst::LOG_P0 there is a `using ::LOG_P0` alias for the same
+  // entity as ::LOG_P0, not a second copy.
+  namespace hc = cis2_hostconst;
+  Cis2Sha256 h;
+  const float f32s_a[3] = {hc::EXP_LOG2E, hc::EXP_C1, hc::EXP_C2};
+  for (int i = 0; i < 3; ++i) h.update_u32le(cis2_f32_bits(f32s_a[i]));
+  const float expp[6] = {hc::EXP_P0, hc::EXP_P1, hc::EXP_P2,
+                          hc::EXP_P3, hc::EXP_P4, hc::EXP_P5};
+  for (int i = 0; i < 6; ++i) h.update_u32le(cis2_f32_bits(expp[i]));
+  {
+    uint64_t b = cis2_f64_bits(hc::PI_2_F64);
+    unsigned char le[8];
+    for (int i = 0; i < 8; ++i) le[i] = (unsigned char)((b >> (8 * i)) & 0xFF);
+    h.update(le, 8);
+  }
+  const float sinc[3] = {hc::SIN_C0, hc::SIN_C1, hc::SIN_C2};
+  for (int i = 0; i < 3; ++i) h.update_u32le(cis2_f32_bits(sinc[i]));
+  const float cosc[3] = {hc::COS_C0, hc::COS_C1, hc::COS_C2};
+  for (int i = 0; i < 3; ++i) h.update_u32le(cis2_f32_bits(cosc[i]));
+  h.update_u32le(cis2_f32_bits(hc::LOG_SQRTHF));
+  h.update_u32le(cis2_f32_bits(hc::LOG_Q1));
+  h.update_u32le(cis2_f32_bits(hc::LOG_Q2));
+  const float logp[9] = {hc::LOG_P0, hc::LOG_P1, hc::LOG_P2, hc::LOG_P3, hc::LOG_P4,
+                         hc::LOG_P5, hc::LOG_P6, hc::LOG_P7, hc::LOG_P8};
+  for (int i = 0; i < 9; ++i) h.update_u32le(cis2_f32_bits(logp[i]));
+  h.finalize(out);
+}
+
+// §7.2 pinned RoPE inv_freq table, built with the route-(b) polynomials
+// only (src/main.rs, "§3.3(b)-pinned RoPE inv_freq"): no host powf, no std
+// exp/ln. `frac` is an integer product, two exact int->f32 conversions and
+// one correctly-rounded f32 divide.
+inline void cis2_build_inv_freq(Cis2Model &m, double rope_theta) {
+  float ln_theta = cis2_ln_pinned((float)rope_theta);
+  int half = m.head_dim / 2;
+  m.inv_freq_host.assign((size_t)half, 0.0f);
+  for (int i = 0; i < half; ++i) {
+    float frac = (float)(2 * i) / (float)m.head_dim;
+    float a = frac * ln_theta;
+    float neg_arg = -a;
+    m.inv_freq_host[(size_t)i] = cis2_exp_pinned(neg_arg);
+  }
+  // The digest hashes the f32 VALUE bytes (`v.to_le_bytes()` in the Rust),
+  // which for f32 are the bit-pattern bytes — see gpu/README.md §4.22.
+  Cis2Sha256 h;
+  for (int i = 0; i < half; ++i)
+    h.update_u32le(cis2_f32_bits(m.inv_freq_host[(size_t)i]));
+  h.finalize(m.inv_freq_table_digest);
+
+  float *dev = cis2_dev_alloc((size_t)half);
+  cis2_upload(dev, m.inv_freq_host.data(), (size_t)half);
+  m.inv_freq = dev;
+}
+
+// =====================================================================
+// 5. Trace hook (--trace); see gpu/README.md §5
+// =====================================================================
+
+struct Cis2Trace {
+  FILE *fp = nullptr;
+  std::vector<float> stage;
+
+  bool on() const { return fp != nullptr; }
+  void emit(int pos, int layer, const char *op, const float *dev, size_t n) {
+    if (!fp) return;
+    if (stage.size() < n) stage.resize(n);
+    cis2_download(stage.data(), dev, n);
+    unsigned char d[32];
+    cis2_sha256_f32_bits(stage.data(), n, d);
+    fprintf(fp, "pos=%d layer=%d op=%s sha256=%s\n", pos, layer, op,
+            cis2_hex(d, 32).c_str());
+  }
+};
+
+// =====================================================================
+// 6. Kernels — one lambda per index space
+// =====================================================================
+
+// Embedding gather: 1 thread per hidden index.
+inline void cis2_k_embed(const float *table, int token_id, int hidden, float *out) {
+  const float *row = table + (size_t)token_id * (size_t)hidden;
+  cis2_for_each(hidden, [=] CIS2_FN(int i) { out[i] = row[i]; });
+}
+
+// RMSNorm (src/main.rs::rmsnorm). Three kernels, because the middle one is
+// the spec's strict left-to-right fold over the whole vector and is
+// therefore a single thread.
+inline void cis2_rmsnorm(const float *x, const float *w, float eps, int n,
+                         float *sq, float *red, float *out) {
+  cis2_for_each(n, [=] CIS2_FN(int i) { sq[i] = x[i] * x[i]; });
+  cis2_for_each(1, [=] CIS2_FN(int) {
+    float ss = CIS2_SUM(sq, n);
+    float mean = ss / (float)n;
+    red[0] = cis2_rsqrt_cr(mean + eps);
+  });
+  cis2_for_each(n, [=] CIS2_FN(int i) {
+    float scaled = x[i] * red[0];
+    out[i] = scaled * w[i];  // (x*inv)*w, in this order — README §4.1
+  });
+}
+
+// matvec (src/main.rs::matvec): 1 thread per output feature, each running
+// the strict left-to-right dot product over in_features.
+inline void cis2_k_matvec(const float *w, const float *x, int out_f, int in_f,
+                          float *y) {
+  cis2_for_each(out_f, [=] CIS2_FN(int o) {
+    y[o] = CIS2_DOT(w + (size_t)o * (size_t)in_f, x, in_f);
+  });
+}
+
+// Optional per-output-feature bias (absent for SmolLM2-135M).
+inline void cis2_k_add_bias(float *x, const float *bias, int n) {
+  if (!bias) return;
+  cis2_for_each(n, [=] CIS2_FN(int i) { x[i] = x[i] + bias[i]; });
+}
+
+inline void cis2_k_add(const float *a, const float *b, int n, float *out) {
+  cis2_for_each(n, [=] CIS2_FN(int i) { out[i] = a[i] + b[i]; });
+}
+
+// RoPE rotate-half (src/main.rs::apply_rope_head): 1 thread per (head, i),
+// each computing its own cos/sin. In-place is safe because a thread owns
+// both i and i+half and reads both before writing either.
+inline void cis2_k_rope(float *x, int n_heads_local, int head_dim, int pos,
+                        const float *inv_freq) {
+  const int half = head_dim / 2;
+  cis2_for_each(n_heads_local * half, [=] CIS2_FN(int idx) {
+    int hh = idx / half;
+    int i = idx - hh * half;
+    float *head = x + (size_t)hh * (size_t)head_dim;
+    float angle = (float)pos * inv_freq[i];
+    float cos_v = cis2_cos_pinned(angle);
+    float sin_v = cis2_sin_pinned(angle);
+    float x1 = head[i];
+    float x2 = head[i + half];
+    float t1 = x1 * cos_v;
+    float t2 = (-x2) * sin_v;  // negate first — README §4.5
+    float o1 = t1 + t2;
+    float t3 = x2 * cos_v;
+    float t4 = x1 * sin_v;
+    float o2 = t3 + t4;
+    head[i] = o1;
+    head[i + half] = o2;
+  });
+}
+
+// Attention scores: 1 thread per (query head, key position).
+inline void cis2_k_scores(const float *q, const float *kcache, int n_heads,
+                          int group, int head_dim, int kv_dim, int pos,
+                          float scale, float *scores) {
+  const int len = pos + 1;
+  cis2_for_each(n_heads * len, [=] CIS2_FN(int idx) {
+    int qh = idx / len;
+    int j = idx - qh * len;
+    int kv_head = qh / group;
+    const float *q_head = q + (size_t)qh * (size_t)head_dim;
+    const float *kj = kcache + (size_t)j * (size_t)kv_dim +
+                      (size_t)kv_head * (size_t)head_dim;
+    float d = CIS2_DOT(q_head, kj, head_dim);
+    scores[(size_t)qh * (size_t)len + (size_t)j] = d * scale;  // scale AFTER
+  });
+}
+
+// Softmax: 1 thread per query head, running the whole sequential softmax
+// (max scan, pinned exp, sequential-sum denominator, divide) over its own
+// pos+1 scores — the order §10 pins.
+inline void cis2_k_softmax(float *scores, int n_heads, int pos) {
+  const int len = pos + 1;
+  cis2_for_each(n_heads, [=] CIS2_FN(int qh) {
+    CIS2_SOFTMAX(scores + (size_t)qh * (size_t)len, len);
+  });
+}
+
+// Attention weighted sum: 1 thread per (query head, head dim), serial over
+// key positions in position order.
+inline void cis2_k_attn_weighted_sum(const float *scores, const float *vcache,
+                                     int n_heads, int group, int head_dim,
+                                     int kv_dim, int pos, float *attn_out) {
+  const int len = pos + 1;
+  cis2_for_each(n_heads * head_dim, [=] CIS2_FN(int idx) {
+    int qh = idx / head_dim;
+    int d = idx - qh * head_dim;
+    int kv_head = qh / group;
+    const float *sc = scores + (size_t)qh * (size_t)len;
+    float acc = 0.0f;
+    for (int j = 0; j < len; ++j) {
+      float vj = vcache[(size_t)j * (size_t)kv_dim +
+                        (size_t)kv_head * (size_t)head_dim + (size_t)d];
+      float p = sc[j] * vj;
+      acc = acc + p;
+    }
+    attn_out[(size_t)qh * (size_t)head_dim + (size_t)d] = acc;
+  });
+}
+
+inline void cis2_k_silu_mul(const float *gate, const float *up, int n, float *out) {
+  cis2_for_each(n, [=] CIS2_FN(int i) {
+    out[i] = cis2_silu_pinned(gate[i]) * up[i];
+  });
+}
+
+// Copy one vector into a KV-cache slot (1 thread per element).
+inline void cis2_k_store_kv(const float *src, float *cache, int kv_dim, int pos) {
+  float *dst = cache + (size_t)pos * (size_t)kv_dim;
+  cis2_for_each(kv_dim, [=] CIS2_FN(int i) { dst[i] = src[i]; });
+}
+
+// =====================================================================
+// 7. Workspace + forward pass
+// =====================================================================
+
+struct Cis2Workspace {
+  float *h = nullptr, *h2 = nullptr, *ln = nullptr;
+  float *sq = nullptr, *red = nullptr;
+  float *q = nullptr, *k = nullptr, *v = nullptr;
+  float *attn_out = nullptr, *o = nullptr;
+  float *gate = nullptr, *up = nullptr, *hid = nullptr, *down = nullptr;
+  float *hn = nullptr, *logits = nullptr, *scores = nullptr;
+  std::vector<float *> kcache, vcache;
+  int max_pos = 0;
+
+  void alloc(const Cis2Model &m, int max_positions) {
+    max_pos = max_positions;
+    int hidden = m.hidden, inter = m.inter, kvd = m.kv_dim();
+    h = cis2_dev_alloc((size_t)hidden);
+    h2 = cis2_dev_alloc((size_t)hidden);
+    ln = cis2_dev_alloc((size_t)hidden);
+    sq = cis2_dev_alloc((size_t)hidden);
+    red = cis2_dev_alloc(1);
+    q = cis2_dev_alloc((size_t)hidden);
+    k = cis2_dev_alloc((size_t)kvd);
+    v = cis2_dev_alloc((size_t)kvd);
+    attn_out = cis2_dev_alloc((size_t)hidden);
+    o = cis2_dev_alloc((size_t)hidden);
+    gate = cis2_dev_alloc((size_t)inter);
+    up = cis2_dev_alloc((size_t)inter);
+    hid = cis2_dev_alloc((size_t)inter);
+    down = cis2_dev_alloc((size_t)hidden);
+    hn = cis2_dev_alloc((size_t)hidden);
+    logits = cis2_dev_alloc((size_t)m.vocab);
+    scores = cis2_dev_alloc((size_t)m.n_heads * (size_t)max_positions);
+    kcache.resize((size_t)m.n_layers);
+    vcache.resize((size_t)m.n_layers);
+    for (int l = 0; l < m.n_layers; ++l) {
+      kcache[(size_t)l] = cis2_dev_alloc((size_t)max_positions * (size_t)kvd);
+      vcache[(size_t)l] = cis2_dev_alloc((size_t)max_positions * (size_t)kvd);
+    }
+  }
+  void free_all() {
+    float *ps[] = {h, h2, ln, sq, red, q, k, v, attn_out, o,
+                   gate, up, hid, down, hn, logits, scores};
+    for (size_t i = 0; i < sizeof(ps) / sizeof(ps[0]); ++i) cis2_dev_free(ps[i]);
+    for (size_t l = 0; l < kcache.size(); ++l) {
+      cis2_dev_free(kcache[l]);
+      cis2_dev_free(vcache[l]);
+    }
+  }
+};
+
+// One decode step, mirroring src/main.rs::forward_token. Leaves the logits
+// for `pos` in `ws.logits` (device memory).
+inline void cis2_forward_token(const Cis2Model &m, Cis2Workspace &ws, int pos,
+                               uint32_t token_id, Cis2Trace *trace) {
+  const int hidden = m.hidden;
+  const int head_dim = m.head_dim;
+  const int n_heads = m.n_heads;
+  const int group = m.n_heads / m.n_kv_heads;
+  const int kvd = m.kv_dim();
+  const float scale = cis2_rsqrt_cr((float)head_dim);
+
+  cis2_k_embed(m.embed_tokens, (int)token_id, hidden, ws.h);
+  if (trace && trace->on()) trace->emit(pos, -1, "embedding", ws.h, (size_t)hidden);
+
+  for (int li = 0; li < m.n_layers; ++li) {
+    const Cis2Layer &L = m.layers[(size_t)li];
+
+    cis2_rmsnorm(ws.h, L.input_layernorm, m.eps, hidden, ws.sq, ws.red, ws.ln);
+    if (trace && trace->on()) trace->emit(pos, li, "norm1", ws.ln, (size_t)hidden);
+
+    cis2_k_matvec(L.q_proj, ws.ln, hidden, hidden, ws.q);
+    cis2_k_add_bias(ws.q, L.q_bias, hidden);
+    if (trace && trace->on()) trace->emit(pos, li, "q", ws.q, (size_t)hidden);
+    cis2_k_matvec(L.k_proj, ws.ln, kvd, hidden, ws.k);
+    cis2_k_add_bias(ws.k, L.k_bias, kvd);
+    if (trace && trace->on()) trace->emit(pos, li, "k", ws.k, (size_t)kvd);
+    cis2_k_matvec(L.v_proj, ws.ln, kvd, hidden, ws.v);
+    cis2_k_add_bias(ws.v, L.v_bias, kvd);
+    if (trace && trace->on()) trace->emit(pos, li, "v", ws.v, (size_t)kvd);
+
+    cis2_k_rope(ws.q, n_heads, head_dim, pos, m.inv_freq);
+    if (trace && trace->on()) trace->emit(pos, li, "rope_q", ws.q, (size_t)hidden);
+    cis2_k_rope(ws.k, m.n_kv_heads, head_dim, pos, m.inv_freq);
+    if (trace && trace->on()) trace->emit(pos, li, "rope_k", ws.k, (size_t)kvd);
+
+    // The cache stores post-RoPE keys and pre-RoPE values, and a cached key
+    // is never re-rotated at a later position (README §4.24).
+    cis2_k_store_kv(ws.k, ws.kcache[(size_t)li], kvd, pos);
+    cis2_k_store_kv(ws.v, ws.vcache[(size_t)li], kvd, pos);
+
+    cis2_k_scores(ws.q, ws.kcache[(size_t)li], n_heads, group, head_dim, kvd,
+                  pos, scale, ws.scores);
+    if (trace && trace->on())
+      trace->emit(pos, li, "scores", ws.scores, (size_t)n_heads * (size_t)(pos + 1));
+    cis2_k_softmax(ws.scores, n_heads, pos);
+    if (trace && trace->on())
+      trace->emit(pos, li, "softmax", ws.scores, (size_t)n_heads * (size_t)(pos + 1));
+
+    cis2_k_attn_weighted_sum(ws.scores, ws.vcache[(size_t)li], n_heads, group,
+                             head_dim, kvd, pos, ws.attn_out);
+    if (trace && trace->on()) trace->emit(pos, li, "attn_out", ws.attn_out, (size_t)hidden);
+
+    cis2_k_matvec(L.o_proj, ws.attn_out, hidden, hidden, ws.o);
+    if (trace && trace->on()) trace->emit(pos, li, "o_proj", ws.o, (size_t)hidden);
+    cis2_k_add(ws.h, ws.o, hidden, ws.h2);
+    { float *t = ws.h; ws.h = ws.h2; ws.h2 = t; }
+    if (trace && trace->on()) trace->emit(pos, li, "resid1", ws.h, (size_t)hidden);
+
+    cis2_rmsnorm(ws.h, L.post_attention_layernorm, m.eps, hidden, ws.sq, ws.red, ws.ln);
+    if (trace && trace->on()) trace->emit(pos, li, "norm2", ws.ln, (size_t)hidden);
+    cis2_k_matvec(L.gate_proj, ws.ln, m.inter, hidden, ws.gate);
+    if (trace && trace->on()) trace->emit(pos, li, "gate", ws.gate, (size_t)m.inter);
+    cis2_k_matvec(L.up_proj, ws.ln, m.inter, hidden, ws.up);
+    if (trace && trace->on()) trace->emit(pos, li, "up", ws.up, (size_t)m.inter);
+    cis2_k_silu_mul(ws.gate, ws.up, m.inter, ws.hid);
+    if (trace && trace->on()) trace->emit(pos, li, "silu_mul", ws.hid, (size_t)m.inter);
+    cis2_k_matvec(L.down_proj, ws.hid, hidden, m.inter, ws.down);
+    if (trace && trace->on()) trace->emit(pos, li, "down", ws.down, (size_t)hidden);
+    cis2_k_add(ws.h, ws.down, hidden, ws.h2);
+    { float *t = ws.h; ws.h = ws.h2; ws.h2 = t; }
+    if (trace && trace->on()) trace->emit(pos, li, "resid2", ws.h, (size_t)hidden);
+  }
+
+  cis2_rmsnorm(ws.h, m.final_norm, m.eps, hidden, ws.sq, ws.red, ws.hn);
+  if (trace && trace->on()) trace->emit(pos, -1, "final_norm", ws.hn, (size_t)hidden);
+  cis2_k_matvec(m.lm_head_weights(), ws.hn, m.vocab, hidden, ws.logits);
+  if (trace && trace->on()) trace->emit(pos, -1, "logits", ws.logits, (size_t)m.vocab);
+}
+
+// =====================================================================
+// 8. gpu-3 (QUEUE gpu-3): whole-model row-batched forward pass
+// =====================================================================
+// Extends gpu-2's row-batch matmul (cis2_matmul_batched_seq, case 1,
+// verified digest-identical to B sequential batch=1 calls on synthetic
+// data in gpu/test_batch.cpp) from a single matmul to the WHOLE forward
+// pass, CPU-only. Every projection (q/k/v/o, mlp gate/up/down, lm_head)
+// goes through cis2_matmul_batched_seq. Everything that is a REDUCTION in
+// the existing batch=1 path -- RMSNorm's sum-of-squares fold, softmax's
+// max-scan/sequential-sum, and the attention weighted sum -- is computed
+// by looping the SAME unmodified per-row kernel B times, never by a
+// shared/fused cross-row reduction that batch=1 does not have. The KV
+// cache is B independent arrays (kcache[b*n_layers+li]), never shared.
+// Bias-add and the two residual adds are also done per row, in a plain
+// loop over the SAME unmodified elementwise kernels, purely for
+// unambiguous parity with the per-row spec text -- these are ordinary
+// elementwise ops (no reduction, no cross-row state), so batching them
+// into one call over B*n would be provably equivalent, but looping avoids
+// any need to argue that.
+struct Cis2BatchWorkspace {
+  int B = 0, n_layers = 0, max_pos = 0;
+  float *h = nullptr, *h2 = nullptr, *ln = nullptr;
+  float *sq = nullptr, *red = nullptr;  // single-row scratch, reused per row
+  float *q = nullptr, *k = nullptr, *v = nullptr;
+  float *attn_out = nullptr, *o = nullptr;
+  float *gate = nullptr, *up = nullptr, *hid = nullptr, *down = nullptr;
+  float *hn = nullptr, *logits = nullptr, *scores = nullptr;
+  std::vector<float *> kcache, vcache;  // size B*n_layers
+
+  void alloc(const Cis2Model &m, int b, int max_positions) {
+    B = b;
+    n_layers = m.n_layers;
+    max_pos = max_positions;
+    int hidden = m.hidden, inter = m.inter, kvd = m.kv_dim();
+    h = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    h2 = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    ln = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    sq = cis2_dev_alloc((size_t)hidden);
+    red = cis2_dev_alloc(1);
+    q = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    k = cis2_dev_alloc((size_t)B * (size_t)kvd);
+    v = cis2_dev_alloc((size_t)B * (size_t)kvd);
+    attn_out = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    o = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    gate = cis2_dev_alloc((size_t)B * (size_t)inter);
+    up = cis2_dev_alloc((size_t)B * (size_t)inter);
+    hid = cis2_dev_alloc((size_t)B * (size_t)inter);
+    down = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    hn = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    logits = cis2_dev_alloc((size_t)B * (size_t)m.vocab);
+    scores = cis2_dev_alloc((size_t)B * (size_t)m.n_heads * (size_t)max_positions);
+    kcache.resize((size_t)B * (size_t)m.n_layers);
+    vcache.resize((size_t)B * (size_t)m.n_layers);
+    for (int bi = 0; bi < B; ++bi) {
+      for (int l = 0; l < m.n_layers; ++l) {
+        kcache[(size_t)bi * (size_t)m.n_layers + (size_t)l] =
+            cis2_dev_alloc((size_t)max_positions * (size_t)kvd);
+        vcache[(size_t)bi * (size_t)m.n_layers + (size_t)l] =
+            cis2_dev_alloc((size_t)max_positions * (size_t)kvd);
+      }
+    }
+  }
+  void free_all() {
+    float *ps[] = {h, h2, ln, sq, red, q, k, v, attn_out, o,
+                   gate, up, hid, down, hn, logits, scores};
+    for (size_t i = 0; i < sizeof(ps) / sizeof(ps[0]); ++i) cis2_dev_free(ps[i]);
+    for (size_t i = 0; i < kcache.size(); ++i) {
+      cis2_dev_free(kcache[i]);
+      cis2_dev_free(vcache[i]);
+    }
+  }
+};
+
+// One decode step, B rows at once. `token_ids` has B entries, one per row.
+// Leaves each row's logits in bws.logits + row*vocab.
+// Batched projection: B rows of x (each k long) against n weight rows.
+// Host build: literally cis2_matmul_batched_seq (the loop over b,j of
+// cis2_dot_seq that gpu-3 verified on box1), so host semantics are
+// untouched. Device build: one device thread per (b,j) output, each doing
+// the same sequential cis2_dot_seq over its row -- the same operation
+// order per output element, executed on the device. gpu-3k finding: the
+// batch path used to call cis2_matmul_batched_seq directly from host
+// code on cudaMalloc'd buffers, which segfaults under nvcc (every other
+// stage already dispatches through cis2_for_each).
+inline void cis2_k_matmul_batched(int B, int n, int k, const float *x,
+                                  const float *w, float *out) {
+#if CIS2_DEVICE_IS_HOST
+  cis2_matmul_batched_seq(B, n, k, x, w, out);
+#else
+  cis2_for_each(B * n, [=] CIS2_FN(int idx) {
+    const int b = idx / n;
+    const int j = idx - b * n;
+    out[idx] = cis2_dot_seq(x + (size_t)b * k, w + (size_t)j * k, k);
+  });
+#endif
+}
+
+inline void cis2_forward_token_batch(const Cis2Model &m, Cis2BatchWorkspace &bws,
+                                     int pos, const uint32_t *token_ids) {
+  const int B = bws.B;
+  const int hidden = m.hidden;
+  const int head_dim = m.head_dim;
+  const int n_heads = m.n_heads;
+  const int group = m.n_heads / m.n_kv_heads;
+  const int kvd = m.kv_dim();
+  const int inter = m.inter;
+  const int max_pos = bws.max_pos;
+  const float scale = cis2_rsqrt_cr((float)head_dim);
+
+  for (int b = 0; b < B; ++b)
+    cis2_k_embed(m.embed_tokens, (int)token_ids[b], hidden, bws.h + (size_t)b * hidden);
+
+  for (int li = 0; li < m.n_layers; ++li) {
+    const Cis2Layer &L = m.layers[(size_t)li];
+
+    for (int b = 0; b < B; ++b)
+      cis2_rmsnorm(bws.h + (size_t)b * hidden, L.input_layernorm, m.eps, hidden,
+                   bws.sq, bws.red, bws.ln + (size_t)b * hidden);
+
+    cis2_k_matmul_batched(B, hidden, hidden, bws.ln, L.q_proj, bws.q);
+    cis2_k_matmul_batched(B, kvd, hidden, bws.ln, L.k_proj, bws.k);
+    cis2_k_matmul_batched(B, kvd, hidden, bws.ln, L.v_proj, bws.v);
+    for (int b = 0; b < B; ++b) {
+      cis2_k_add_bias(bws.q + (size_t)b * hidden, L.q_bias, hidden);
+      cis2_k_add_bias(bws.k + (size_t)b * kvd, L.k_bias, kvd);
+      cis2_k_add_bias(bws.v + (size_t)b * kvd, L.v_bias, kvd);
+    }
+
+    for (int b = 0; b < B; ++b) {
+      cis2_k_rope(bws.q + (size_t)b * hidden, n_heads, head_dim, pos, m.inv_freq);
+      cis2_k_rope(bws.k + (size_t)b * kvd, m.n_kv_heads, head_dim, pos, m.inv_freq);
+    }
+
+    for (int b = 0; b < B; ++b) {
+      float *kc = bws.kcache[(size_t)b * (size_t)m.n_layers + (size_t)li];
+      float *vc = bws.vcache[(size_t)b * (size_t)m.n_layers + (size_t)li];
+      cis2_k_store_kv(bws.k + (size_t)b * kvd, kc, kvd, pos);
+      cis2_k_store_kv(bws.v + (size_t)b * kvd, vc, kvd, pos);
+      cis2_k_scores(bws.q + (size_t)b * hidden, kc, n_heads, group, head_dim, kvd,
+                    pos, scale, bws.scores + (size_t)b * n_heads * max_pos);
+      cis2_k_softmax(bws.scores + (size_t)b * n_heads * max_pos, n_heads, pos);
+      cis2_k_attn_weighted_sum(bws.scores + (size_t)b * n_heads * max_pos, vc,
+                               n_heads, group, head_dim, kvd, pos,
+                               bws.attn_out + (size_t)b * hidden);
+    }
+
+    cis2_k_matmul_batched(B, hidden, hidden, bws.attn_out, L.o_proj, bws.o);
+    for (int b = 0; b < B; ++b)
+      cis2_k_add(bws.h + (size_t)b * hidden, bws.o + (size_t)b * hidden, hidden,
+                bws.h2 + (size_t)b * hidden);
+    { float *t = bws.h; bws.h = bws.h2; bws.h2 = t; }
+
+    for (int b = 0; b < B; ++b)
+      cis2_rmsnorm(bws.h + (size_t)b * hidden, L.post_attention_layernorm, m.eps,
+                   hidden, bws.sq, bws.red, bws.ln + (size_t)b * hidden);
+
+    cis2_k_matmul_batched(B, inter, hidden, bws.ln, L.gate_proj, bws.gate);
+    cis2_k_matmul_batched(B, inter, hidden, bws.ln, L.up_proj, bws.up);
+    for (int b = 0; b < B; ++b)
+      cis2_k_silu_mul(bws.gate + (size_t)b * inter, bws.up + (size_t)b * inter,
+                      inter, bws.hid + (size_t)b * inter);
+
+    cis2_k_matmul_batched(B, hidden, inter, bws.hid, L.down_proj, bws.down);
+    for (int b = 0; b < B; ++b)
+      cis2_k_add(bws.h + (size_t)b * hidden, bws.down + (size_t)b * hidden, hidden,
+                bws.h2 + (size_t)b * hidden);
+    { float *t = bws.h; bws.h = bws.h2; bws.h2 = t; }
+  }
+
+  for (int b = 0; b < B; ++b)
+    cis2_rmsnorm(bws.h + (size_t)b * hidden, m.final_norm, m.eps, hidden, bws.sq,
+                 bws.red, bws.hn + (size_t)b * hidden);
+  cis2_k_matmul_batched(B, m.vocab, hidden, bws.hn, m.lm_head_weights(), bws.logits);
+}
+
+// Greedy argmax over the logits: sequential scan, strict `>`, so the FIRST
+// maximum wins (src/main.rs, "for (idx, &v) in logits.iter().enumerate()").
+inline uint32_t cis2_argmax(const float *logits_host, int n) {
+  int best_idx = 0;
+  float best_val = logits_host[0];
+  for (int i = 0; i < n; ++i) {
+    if (logits_host[i] > best_val) {
+      best_val = logits_host[i];
+      best_idx = i;
+    }
+  }
+  return (uint32_t)best_idx;
+}
+
+#endif  // CIS2_MODEL_H
diff --git a/gpu/kaggle_gpu3/overlay_staging/cis2_sass_probe.cu b/gpu/kaggle_gpu3/overlay_staging/cis2_sass_probe.cu
new file mode 100644
index 0000000..fee78f7
--- /dev/null
+++ b/gpu/kaggle_gpu3/overlay_staging/cis2_sass_probe.cu
@@ -0,0 +1,55 @@
+// gpu/cis2_sass_probe.cu — E18c: a minimal, self-contained CUDA
+// translation unit whose only purpose is to put the pinned reduction
+// kernels (§5.1/§5.3 sequential, and the v0.4 CANDIDATE tree variants)
+// through nvcc for real, so their SASS can be inspected for fused
+// multiply-add instructions. It depends on nothing but cis2_math.h — no
+// weights, no JSON, no safetensors, no host driver — specifically so
+// `nofma-cuda` stays cheap to compile and its SASS stays small enough to
+// read function-by-function.
+//
+// This file is NEVER LINKED into an executable and NEVER RUN: `make
+// nofma-cuda` compiles it to a relocatable device object (`nvcc -c`) and
+// disassembles that object directly with `cuobjdump`/`nvdisasm`. No
+// physical GPU is required for either step — only the offline compiler
+// and disassembler, both part of the CUDA toolkit. See gpu/README.md §8b.
+//
+// Six kernels, one per reduction primitive this leg cares about:
+//   k_dot_seq / k_sum_seq       — v0.3b's untouched sequential reduction
+//   k_dot_tree / k_sum_tree     — v0.4 CANDIDATE's pinned tree reduction
+//   k_softmax_seq / k_softmax_tree
+//     — softmax contains one genuine division (`logits[i] / denom`);
+//       -prec-div=true division on Turing (no hardware DIV instruction)
+//       is a MUFU.RCP + Newton-Raphson-refinement sequence that legally
+//       contains FFMA — the documented exception (see gpu/README.md §1,
+//       "-prec-div/-prec-sqrt internal FFMA"). The other four kernels
+//       contain NO division and NO sqrt, so they are held to a strict
+//       zero.
+
+#include "cis2_math.h"
+
+#define N 200  // > 6*CIS2_TREE_BLOCK: exercises multiple full blocks plus
+                // a ragged tail in every tree kernel below.
+
+extern "C" __global__ void k_dot_seq(const float *a, const float *b, float *out) {
+  *out = cis2_dot_seq(a, b, N);
+}
+
+extern "C" __global__ void k_sum_seq(const float *a, float *out) {
+  *out = cis2_sum_seq(a, N);
+}
+
+extern "C" __global__ void k_dot_tree(const float *a, const float *b, float *out) {
+  *out = cis2_tree_dot(a, b, N);
+}
+
+extern "C" __global__ void k_sum_tree(const float *a, float *out) {
+  *out = cis2_tree_sum(a, N);
+}
+
+extern "C" __global__ void k_softmax_seq(float *scores) {
+  cis2_softmax_seq(scores, N);
+}
+
+extern "C" __global__ void k_softmax_tree(float *scores) {
+  cis2_softmax_tree(scores, N);
+}
diff --git a/gpu/kaggle_gpu3/overlay_staging/cis2_sha256.h b/gpu/kaggle_gpu3/overlay_staging/cis2_sha256.h
new file mode 100644
index 0000000..2eb9d49
--- /dev/null
+++ b/gpu/kaggle_gpu3/overlay_staging/cis2_sha256.h
@@ -0,0 +1,114 @@
+// gpu/cis2_sha256.h — self-contained SHA-256 (FIPS 180-4), host-only.
+// Used for the CIS-2 §12 witness/receipt digests and the §6.6 table digest.
+// Plain integer arithmetic; not part of the pinned fp32 path.
+
+#ifndef CIS2_SHA256_H
+#define CIS2_SHA256_H
+
+#include <stdint.h>
+#include <string.h>
+#include <string>
+
+struct Cis2Sha256 {
+  uint32_t h[8];
+  uint64_t len;
+  unsigned char buf[64];
+  size_t buflen;
+
+  Cis2Sha256() { reset(); }
+  void reset() {
+    h[0] = 0x6a09e667; h[1] = 0xbb67ae85; h[2] = 0x3c6ef372; h[3] = 0xa54ff53a;
+    h[4] = 0x510e527f; h[5] = 0x9b05688c; h[6] = 0x1f83d9ab; h[7] = 0x5be0cd19;
+    len = 0; buflen = 0;
+  }
+  static uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+
+  void block(const unsigned char *p) {
+    static const uint32_t K[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,
+        0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,
+        0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,
+        0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,
+        0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,
+        0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,
+        0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,
+        0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,
+        0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    uint32_t w[64];
+    for (int i = 0; i < 16; ++i)
+      w[i] = ((uint32_t)p[4*i] << 24) | ((uint32_t)p[4*i+1] << 16) |
+             ((uint32_t)p[4*i+2] << 8) | (uint32_t)p[4*i+3];
+    for (int i = 16; i < 64; ++i) {
+      uint32_t s0 = rotr(w[i-15],7) ^ rotr(w[i-15],18) ^ (w[i-15] >> 3);
+      uint32_t s1 = rotr(w[i-2],17) ^ rotr(w[i-2],19) ^ (w[i-2] >> 10);
+      w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    uint32_t a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],hh=h[7];
+    for (int i = 0; i < 64; ++i) {
+      uint32_t S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
+      uint32_t ch = (e & f) ^ ((~e) & g);
+      uint32_t t1 = hh + S1 + ch + K[i] + w[i];
+      uint32_t S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
+      uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+      uint32_t t2 = S0 + maj;
+      hh=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d; h[4]+=e; h[5]+=f; h[6]+=g; h[7]+=hh;
+  }
+
+  void update(const void *data, size_t n) {
+    const unsigned char *p = (const unsigned char *)data;
+    len += n;
+    while (n) {
+      size_t take = 64 - buflen;
+      if (take > n) take = n;
+      memcpy(buf + buflen, p, take);
+      buflen += take; p += take; n -= take;
+      if (buflen == 64) { block(buf); buflen = 0; }
+    }
+  }
+  void update_u32le(uint32_t v) {
+    unsigned char b[4] = {(unsigned char)(v & 0xFF), (unsigned char)((v >> 8) & 0xFF),
+                          (unsigned char)((v >> 16) & 0xFF), (unsigned char)((v >> 24) & 0xFF)};
+    update(b, 4);
+  }
+  void finalize(unsigned char out[32]) {
+    uint64_t bits = len * 8;
+    unsigned char pad = 0x80;
+    update(&pad, 1);
+    unsigned char z = 0;
+    while (buflen != 56) update(&z, 1);
+    unsigned char lb[8];
+    for (int i = 0; i < 8; ++i) lb[i] = (unsigned char)((bits >> (56 - 8 * i)) & 0xFF);
+    update(lb, 8);
+    for (int i = 0; i < 8; ++i) {
+      out[4*i]   = (unsigned char)((h[i] >> 24) & 0xFF);
+      out[4*i+1] = (unsigned char)((h[i] >> 16) & 0xFF);
+      out[4*i+2] = (unsigned char)((h[i] >> 8) & 0xFF);
+      out[4*i+3] = (unsigned char)(h[i] & 0xFF);
+    }
+  }
+};
+
+inline std::string cis2_hex(const unsigned char *b, size_t n) {
+  static const char *d = "0123456789abcdef";
+  std::string s;
+  s.reserve(n * 2);
+  for (size_t i = 0; i < n; ++i) { s.push_back(d[b[i] >> 4]); s.push_back(d[b[i] & 15]); }
+  return s;
+}
+
+// SHA-256 over the raw little-endian f32 BIT PATTERNS of a slice — the
+// per-(layer, op) trace hash and the inv_freq table digest both use this.
+inline void cis2_sha256_f32_bits(const float *xs, size_t n, unsigned char out[32]) {
+  Cis2Sha256 h;
+  for (size_t i = 0; i < n; ++i) {
+    union { float f; uint32_t u; } c; c.f = xs[i];
+    h.update_u32le(c.u);
+  }
+  h.finalize(out);
+}
+
+#endif  // CIS2_SHA256_H
diff --git a/gpu/kaggle_gpu3/overlay_staging/cis2_sweep.cpp b/gpu/kaggle_gpu3/overlay_staging/cis2_sweep.cpp
new file mode 100644
index 0000000..e6e5f3a
--- /dev/null
+++ b/gpu/kaggle_gpu3/overlay_staging/cis2_sweep.cpp
@@ -0,0 +1,255 @@
+// gpu/cis2_sweep.cpp -- gpu2 (QUEUE gpu-2) BATCH_INT8_DESIGN.md steps 5-6:
+// batch={1,4,8} x {fp32-seq, fp32-grouped, int8} digest sweep run against
+// REAL cis2 model weights + real token embeddings already used by
+// E18/E18c (gpu/EXPECTED_DIGESTS.md's SmolLM2-135M checkpoint), not
+// synthetic xorshift32 data (that was steps 2-4's gpu/test_batch.cpp,
+// unchanged and still passing -- see BATCH_INT8_DESIGN.md).
+//
+// SCOPE, stated honestly up front: this is NOT a full forward pass /
+// generation run. It exercises ONE real weight matrix -- layer 0's
+// `self_attn.q_proj.weight`, shape [hidden_size, hidden_size]
+// (576x576 for SmolLM2-135M, BF16 widened to fp32 exactly as
+// cis2_host.cpp's own load_bf16 does, no new widening code) -- against
+// up to 8 REAL `model.embed_tokens.weight` rows selected by the ACTUAL
+// token ids in gate/ids_sweep20.txt, which plan.py builds at run time
+// by running the real cis2_host binary against the gate's
+// ids_16tok.txt (4 real prompt ids only -- the Rust --dump-ids file
+// never contains generated ids) with --gen-toks 16 and capturing its
+// stderr `[run1] step N: token_id=U` lines: 4 real prompt ids + 16 real
+// greedy-generated ids = 20 available ids, of which the first 8 are
+// used here. A full multi-layer batched forward
+// pass (attention, RoPE, softmax, MLP, KV-cache, all batched) is real
+// kernel-engineering work this branch's remaining budget does not cover;
+// BATCH_INT8_DESIGN.md's own next-steps list this as future work.
+// Reusing exactly one real weight tensor + real embeddings (rather than
+// synthetic data) is the given task's step-5 instruction: "wire the
+// batched/int8 functions into plan.py's digest table so the sweep runs
+// against the real cis2 test vectors/model weights already used by
+// E18" -- and it is within the 20 GB Kaggle working-directory cap (the
+// existing cis2-e18b-gpu dataset is ~215 MB total, see
+// gpu/kaggle/make_dataset.sh).
+//
+// Anchor ("vs_cpu_batch1" in every SWEEP line): row 0's output, computed
+// directly by the unmodified `cis2_dot_seq` for each of the n=hidden_size
+// output columns -- independent of any of the three batched kernels
+// below, and independent of B. Every other config's row-0 output slice
+// (n elements, the only row present at every tested batch size) is
+// compared against this same anchor; diffs=<k>/<n> counts bitwise
+// float-inequal elements in that row-0 slice.
+//
+// Device execution: when built with nvcc (CIS2_DEVICE_IS_HOST==0, see
+// cis2_model.h), every config below (including the anchor) runs inside a
+// single cis2_for_each(1, ...) device-lambda launch -- a real kernel
+// launch executing cis2_dot_seq / cis2_matmul_batched_{seq,grouped,int8}
+// (unmodified, same source as the CPU-only gpu/test_batch*.cpp checks)
+// on the GPU, with the same -fmad=false -ftz=true -prec-div=true
+// -prec-sqrt=true flags gpu/kaggle/e18b_gpu.py already established
+// reproduce host fp32 arithmetic bit-for-bit on this repo's CUDA path.
+// On a host build (g++/clang++, no __CUDACC__) cis2_for_each(1, f) is
+// just `f(0)` -- this is the CPU control this file reports as
+// host_control_batch1_fp32.
+
+#include "cis2_fpenv.h"
+#include "cis2_math.h"
+#include "cis2_model.h"
+#include "cis2_sha256.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <string>
+#include <vector>
+
+static std::vector<uint32_t> read_ids(const std::string &path) {
+  std::string text = cis2_read_file(path);
+  std::vector<uint32_t> ids;
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && (text[i] == '\n' || text[i] == '\r' ||
+                               text[i] == ' ' || text[i] == '\t' || text[i] == ','))
+      ++i;
+    if (i >= text.size()) break;
+    size_t j = i;
+    while (j < text.size() && text[j] >= '0' && text[j] <= '9') ++j;
+    if (j == i) { fprintf(stderr, "FATAL: %s: bad token id byte %zu\n", path.c_str(), i); exit(2); }
+    ids.push_back((uint32_t)strtoul(text.substr(i, j - i).c_str(), nullptr, 10));
+    i = j;
+  }
+  if (ids.empty()) { fprintf(stderr, "FATAL: %s: no token ids\n", path.c_str()); exit(2); }
+  return ids;
+}
+
+// int8 device buffer helpers -- mirror cis2_dev_alloc/cis2_upload's
+// CIS2_DEVICE_IS_HOST split (cis2_model.h) but for int8_t, which that
+// file does not provide (it only ever moves float buffers).
+#if CIS2_DEVICE_IS_HOST
+static int8_t *cis2_dev_alloc_i8(size_t n) {
+  int8_t *p = (int8_t *)malloc(n);
+  if (!p) { fprintf(stderr, "FATAL: malloc(%zu i8) failed\n", n); exit(2); }
+  return p;
+}
+static void cis2_upload_i8(int8_t *d, const int8_t *h, size_t n) { if (d != h) memcpy(d, h, n); }
+static void cis2_download_f(float *h, const float *d, size_t n) { if (h != d) memcpy(h, d, n * sizeof(float)); }
+#else
+static int8_t *cis2_dev_alloc_i8(size_t n) {
+  int8_t *p = nullptr;
+  if (cudaMalloc(&p, n) != cudaSuccess) { fprintf(stderr, "FATAL: cudaMalloc(%zu i8) failed\n", n); exit(2); }
+  return p;
+}
+static void cis2_upload_i8(int8_t *d, const int8_t *h, size_t n) { cudaMemcpy(d, h, n, cudaMemcpyHostToDevice); }
+static void cis2_download_f(float *h, const float *d, size_t n) { cudaMemcpy(h, d, n * sizeof(float), cudaMemcpyDeviceToHost); }
+#endif
+
+static void report(const char *config, const float *out, size_t total,
+                    const float *anchor_row0, int n, int rowstride,
+                    unsigned char anchor_dig[32]) {
+  Cis2Sha256 h;
+  h.update(out, total * sizeof(float));
+  unsigned char dig[32];
+  h.finalize(dig);
+  std::string hex = cis2_hex(dig, 32);
+
+  int diffs = 0;
+  for (int j = 0; j < n; ++j) {
+    if (out[j] != anchor_row0[j]) ++diffs;  // row 0 is out[0*rowstride + j]
+  }
+  bool full_match = (memcmp(dig, anchor_dig, 32) == 0);
+  printf("SWEEP config=%s digest=%s vs_cpu_batch1=%s diffs=%d/%d\n",
+         config, hex.c_str(), (diffs == 0 ? "MATCH" : "MISMATCH"), diffs, n);
+  (void)full_match; (void)rowstride;
+}
+
+int main(int argc, char **argv) {
+  cis2_fpenv_init();
+
+  std::string weights_dir = "weights";
+  std::string ids_path;
+  int layer = 0;
+  for (int i = 1; i < argc; ++i) {
+    std::string a = argv[i];
+    if (a == "--weights-dir" && i + 1 < argc) weights_dir = argv[++i];
+    else if (a == "--ids" && i + 1 < argc) ids_path = argv[++i];
+    else if (a == "--layer" && i + 1 < argc) layer = atoi(argv[++i]);
+    else { fprintf(stderr, "FATAL: unknown arg %s\n", a.c_str()); return 2; }
+  }
+  if (ids_path.empty()) { fprintf(stderr, "FATAL: --ids required\n"); return 2; }
+
+  const std::string weights_path = weights_dir + "/model.safetensors";
+  const std::string config_path = weights_dir + "/config.json";
+
+  Cis2Json cfg = cis2_json_parse(cis2_read_file(config_path));
+  auto need = [&](const char *k) -> const Cis2Json & {
+    const Cis2Json *v = cfg.get(k);
+    if (!v) { fprintf(stderr, "FATAL: config.json missing %s\n", k); exit(2); }
+    return *v;
+  };
+  const int H = (int)need("hidden_size").num;
+  const int V = (int)need("vocab_size").num;
+  const int n = H, k = H;  // q_proj is [H,H]
+
+  fprintf(stderr, "gpu2 sweep: real weights, layer=%d hidden_size=%d vocab=%d "
+                   "(CIS2_DEVICE_IS_HOST=%d)\n", layer, H, V, CIS2_DEVICE_IS_HOST);
+
+  Cis2SafeTensors st;
+  st.open(weights_path);
+  char qname[128];
+  snprintf(qname, sizeof(qname), "model.layers.%d.self_attn.q_proj.weight", layer);
+  float *w_dev = st.load_bf16(qname, {(size_t)H, (size_t)H});
+  float *embed_dev = st.load_bf16("model.embed_tokens.weight", {(size_t)V, (size_t)H});
+
+  std::vector<uint32_t> ids = read_ids(ids_path);
+  const int B_MAX = 8;
+  if ((int)ids.size() < B_MAX) {
+    fprintf(stderr, "FATAL: need >=%d token ids in %s, got %zu\n", B_MAX, ids_path.c_str(), ids.size());
+    return 2;
+  }
+
+  // Gather B_MAX real embedding rows (row-major x[B][k]) from the real
+  // embed_tokens tensor at the real token ids -- one cis2_download per
+  // row (cheap: H floats each), no full-vocab download needed.
+  std::vector<float> x_host((size_t)B_MAX * k);
+  for (int b = 0; b < B_MAX; ++b) {
+    uint32_t tid = ids[(size_t)b];
+    if ((int)tid >= V) { fprintf(stderr, "FATAL: token id %u out of vocab %d\n", tid, V); return 2; }
+    cis2_download_f(x_host.data() + (size_t)b * k, embed_dev + (size_t)tid * H, (size_t)H);
+  }
+
+  // Real weight matrix, downloaded to host once for int8 quantization
+  // (quantization itself runs host-side, deterministic; the arithmetic
+  // under test is the on-the-fly dequant matmul, not this step -- see
+  // module docstring).
+  std::vector<float> w_host((size_t)n * k);
+  cis2_download_f(w_host.data(), w_dev, (size_t)n * k);
+  std::vector<int8_t> w_i8_host((size_t)n * k);
+  std::vector<float> w_scale_host((size_t)n);
+  for (int j = 0; j < n; ++j) {
+    w_scale_host[(size_t)j] = cis2_quantize_row_i8(
+        w_host.data() + (size_t)j * k, k, w_i8_host.data() + (size_t)j * k);
+  }
+
+  float *x_dev = cis2_dev_alloc((size_t)B_MAX * k);
+  cis2_upload(x_dev, x_host.data(), (size_t)B_MAX * k);
+  int8_t *w_i8_dev = cis2_dev_alloc_i8((size_t)n * k);
+  cis2_upload_i8(w_i8_dev, w_i8_host.data(), (size_t)n * k);
+  float *w_scale_dev = cis2_dev_alloc((size_t)n);
+  cis2_upload(w_scale_dev, w_scale_host.data(), (size_t)n);
+
+  // ---- Anchor: batch1_fp32 (independent cis2_dot_seq, row 0 only) -----
+  float *anchor_dev = cis2_dev_alloc((size_t)n);
+  cis2_for_each(1, [=] CIS2_FN (int) {
+    for (int j = 0; j < n; ++j)
+      anchor_dev[j] = cis2_dot_seq(x_dev, w_dev + (size_t)j * k, k);
+  });
+  std::vector<float> anchor_host((size_t)n);
+  cis2_download_f(anchor_host.data(), anchor_dev, (size_t)n);
+  Cis2Sha256 ah; ah.update(anchor_host.data(), anchor_host.size() * sizeof(float));
+  unsigned char anchor_dig[32]; ah.finalize(anchor_dig);
+  {
+    std::string hexa = cis2_hex(anchor_dig, 32);
+    printf("SWEEP config=host_control_batch1_fp32 digest=%s vs_cpu_batch1=MATCH diffs=0/%d\n",
+           hexa.c_str(), n);
+  }
+
+  // ---- 9 configs: batch in {1,4,8} x kernel in {seq, grouped, int8} ---
+  const int batches[3] = {1, 4, 8};
+  for (int bi = 0; bi < 3; ++bi) {
+    int B = batches[bi];
+
+    float *out_seq_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_seq(B, n, k, x_dev, w_dev, out_seq_dev);
+    });
+    std::vector<float> out_seq_host((size_t)B * n);
+    cis2_download_f(out_seq_host.data(), out_seq_dev, (size_t)B * n);
+    char label[64];
+    snprintf(label, sizeof(label), "batch%d_fp32_seq", B);
+    report(label, out_seq_host.data(), out_seq_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    float *out_grp_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_grouped(B, n, k, x_dev, w_dev, out_grp_dev);
+    });
+    std::vector<float> out_grp_host((size_t)B * n);
+    cis2_download_f(out_grp_host.data(), out_grp_dev, (size_t)B * n);
+    snprintf(label, sizeof(label), "batch%d_fp32_grouped", B);
+    report(label, out_grp_host.data(), out_grp_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    float *out_i8_dev = cis2_dev_alloc((size_t)B * n);
+    cis2_for_each(1, [=] CIS2_FN (int) {
+      cis2_matmul_batched_int8(B, n, k, x_dev, w_i8_dev, w_scale_dev, out_i8_dev);
+    });
+    std::vector<float> out_i8_host((size_t)B * n);
+    cis2_download_f(out_i8_host.data(), out_i8_dev, (size_t)B * n);
+    snprintf(label, sizeof(label), "batch%d_int8", B);
+    report(label, out_i8_host.data(), out_i8_host.size(), anchor_host.data(), n, n, anchor_dig);
+
+    cis2_dev_free(out_seq_dev);
+    cis2_dev_free(out_grp_dev);
+    cis2_dev_free(out_i8_dev);
+  }
+
+  printf("SWEEP_DONE weights=%s ids=%s layer=%d hidden_size=%d n_ids=%zu\n",
+         weights_path.c_str(), ids_path.c_str(), layer, H, ids.size());
+  return 0;
+}
