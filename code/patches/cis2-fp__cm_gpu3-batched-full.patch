+// Batched matmul with the weight matrix stored as int8 + one scale per
+// output row (per BATCH_INT8_DESIGN.md step 4), dequantized ON-THE-FLY
+// per element inside the dot-product loop -- this is genuinely different
+// arithmetic from cis2_dot_seq's fp32*fp32 multiply, not just an I/O
+// change, so it is expected, a priori, to risk a digest MISMATCH against
+// the fp32 reference (quantization error, not merely reduction-order
+// non-associativity). The activation row x stays fp32 (weight-only
+// quantization, the common inference case); dequantized weight values
+// are computed with a single fp32 multiply (int8 -> float widening is
+// exact, then `w_i8[i] * scale` is one separately-rounded fp32 op,
+// consistent with this file's no-FMA rule), and the running dot product
+// uses the same strict left-to-right sequential accumulation as
+// cis2_dot_seq (acc = acc + p, separate mul then separate add) so that
+// any MISMATCH vs the fp32 reference is attributable to quantization
+// only, not to a second, independent reduction-order change.
+//
+// x:       [B][k]      row-major fp32 activations
+// w_i8:    [n][k]      row-major int8 quantized weights
+// w_scale: [n]         one fp32 scale per weight row (per-output-channel)
+// out:     [B][n]      row-major, out[b*n+j] = dot(x[b], dequant(w_i8[j]))
+CIS2_FN inline void cis2_matmul_batched_int8(int B, int n, int k,
+                                              const float *x,
+                                              const int8_t *w_i8,
+                                              const float *w_scale,
+                                              float *out) {
+  for (int b = 0; b < B; ++b) {
+    for (int j = 0; j < n; ++j) {
+      const float *xr = x + (size_t)b * k;
+      const int8_t *wr = w_i8 + (size_t)j * k;
+      float scale = w_scale[j];
+      float acc = 0.0f;
+      for (int i = 0; i < k; ++i) {
+        float wf = (float)wr[i] * scale;  // separate mul, exact int->float
+        float p = xr[i] * wf;             // separate mul
+        acc = acc + p;                    // separate add
+      }
+      out[b * n + j] = acc;
+    }
+  }
+}
