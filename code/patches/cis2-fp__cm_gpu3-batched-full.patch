+// stage already dispatches through cis2_for_each).
+inline void cis2_k_matmul_batched(int B, int n, int k, const float *x,
+                                  const float *w, float *out) {
+#if CIS2_DEVICE_IS_HOST
+  cis2_matmul_batched_seq(B, n, k, x, w, out);
+#else
+  cis2_for_each(B * n, [=] CIS2_FN(int idx) {
+    const int b = idx / n;
+    const int j = idx - b * n;
+    out[idx] = cis2_dot_seq(x + (size_t)b * k, w + (size_t)j * k, k);
+  });
+#endif
+}
