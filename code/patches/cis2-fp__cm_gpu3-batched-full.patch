+    o = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    gate = cis2_dev_alloc((size_t)B * (size_t)inter);
+    up = cis2_dev_alloc((size_t)B * (size_t)inter);
+    hid = cis2_dev_alloc((size_t)B * (size_t)inter);
+    down = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    hn = cis2_dev_alloc((size_t)B * (size_t)hidden);
+    logits = cis2_dev_alloc((size_t)B * (size_t)m.vocab);
+    scores = cis2_dev_alloc((size_t)B * (size_t)m.n_heads * (size_t)max_positions);
