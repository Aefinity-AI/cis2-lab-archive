diff --git a/gpu/cis2_host.cpp b/gpu/cis2_host.cpp
index adb49b6..5270c2b 100644
--- a/gpu/cis2_host.cpp
+++ b/gpu/cis2_host.cpp
@@ -46,6 +46,70 @@ static std::vector<uint32_t> read_ids(const std::string &path) {
   return ids;
 }
 
+// gpu-3 (QUEUE gpu-3): run ONE row through the existing, unmodified
+// batch=1 sequential path (cis2_forward_token) and return its witness +
+// argmax digest. Used as the standalone comparison point for each row of
+// a --batch run -- this is deliberately the SAME code path the existing
+// CPU gate already exercises, just factored out and called once per row
+// instead of appearing inline in main().
+struct Cis2RowDigest {
+  unsigned char witness[32];
+  unsigned char argmax[32];
+  std::vector<uint32_t> all_token_ids;
+};
+
+static Cis2RowDigest cis2_run_standalone(
+    const Cis2Model &model, const unsigned char weights_sha[32],
+    const unsigned char tokenizer_sha[32], const unsigned char config_sha[32],
+    const unsigned char table_dig[32], const std::vector<uint32_t> &prompt_ids,
+    int gen_toks) {
+  Cis2Workspace ws;
+  ws.alloc(model, (int)prompt_ids.size() + gen_toks);
+
+  Cis2Sha256 witness;
+  witness.update(weights_sha, 32);
+  witness.update(tokenizer_sha, 32);
+  witness.update(config_sha, 32);
+  witness.update(table_dig, 32);
+  witness.update(model.inv_freq_table_digest, 32);
+  for (size_t i = 0; i < prompt_ids.size(); ++i) witness.update_u32le(prompt_ids[i]);
+
+  std::vector<uint32_t> all_token_ids = prompt_ids;
+  std::vector<float> logits_host((size_t)model.vocab);
+
+  for (size_t pos = 0; pos < prompt_ids.size(); ++pos)
+    cis2_forward_token(model, ws, (int)pos, prompt_ids[pos], nullptr);
+  cis2_download(logits_host.data(), ws.logits, (size_t)model.vocab);
+
+  for (int step = 0; step < gen_toks; ++step) {
+    uint32_t next_id = cis2_argmax(logits_host.data(), model.vocab);
+    for (int i = 0; i < model.vocab; ++i)
+      witness.update_u32le(cis2_f32_bits(logits_host[(size_t)i]));
+    witness.update_u32le(next_id);
+    all_token_ids.push_back(next_id);
+    int pos = (int)prompt_ids.size() + step;
+    cis2_forward_token(model, ws, pos, next_id, nullptr);
+    cis2_download(logits_host.data(), ws.logits, (size_t)model.vocab);
+  }
+
+  Cis2RowDigest out;
+  witness.finalize(out.witness);
+  Cis2Sha256 ah;
+  for (size_t i = 0; i < all_token_ids.size(); ++i) ah.update_u32le(all_token_ids[i]);
+  ah.finalize(out.argmax);
+  out.all_token_ids = all_token_ids;
+  ws.free_all();
+  return out;
+}
+
+// gpu-3: SmolLM2-135M "Once upon a time" gen_toks=16, C++/CPU batch=1
+// pinned value (gpu/EXPECTED_DIGESTS.md `sequential.16` row). NEVER
+// rewritten by this program -- only compared against, and the comparison
+// result (MATCH/MISMATCH) is printed, never used to alter the digest
+// itself.
+static const char *CIS2_PINNED_ROW0_DIGEST =
+    "d82743059d1db929e710236fe4ec37f89e6f932524801345a006980f7c3cc9df";
+
 static std::string ids_debug(const std::vector<uint32_t> &v) {
   std::string s = "[";
   for (size_t i = 0; i < v.size(); ++i) {
@@ -68,6 +132,7 @@ int main(int argc, char **argv) {
   std::string trace_path;
   int gen_toks = 16;
   int prompt_idx = 0;
+  int batch_b = 0;  // gpu-3: 0 = disabled (unchanged batch=1 behaviour below)
 
   for (int i = 1; i < argc; ++i) {
     std::string a = argv[i];
@@ -76,6 +141,7 @@ int main(int argc, char **argv) {
     else if (a == "--gen-toks" && i + 1 < argc) gen_toks = atoi(argv[++i]);
     else if (a == "--trace" && i + 1 < argc) trace_path = argv[++i];
     else if (a == "--prompt-idx" && i + 1 < argc) prompt_idx = atoi(argv[++i]);
+    else if (a == "--batch" && i + 1 < argc) batch_b = atoi(argv[++i]);
     else { fprintf(stderr, "FATAL: unknown CLI argument: %s\n", a.c_str()); return 2; }
   }
   if (ids_path.empty()) {
@@ -167,6 +233,112 @@ int main(int argc, char **argv) {
   fprintf(stderr, "[prompt %d] token ids (%zu toks): %s\n", prompt_idx,
           prompt_ids.size(), ids_debug(prompt_ids).c_str());
 
+  // ---- gpu-3 (QUEUE gpu-3): --batch B whole-model row-batch check ------
+  if (batch_b > 0) {
+    const int B = batch_b;
+    // Row 0 = the pinned gate prompt as-is. Rows 1..B-1 = the SAME ids
+    // with the LAST id replaced by last_id + i (i = row index). Documented
+    // identically in RESULT.md and the commit message.
+    std::vector<std::vector<uint32_t>> rows(B, prompt_ids);
+    uint32_t last_id = prompt_ids.back();
+    for (int b = 1; b < B; ++b) rows[(size_t)b].back() = last_id + (uint32_t)b;
+
+    for (int b = 0; b < B; ++b)
+      fprintf(stderr, "[batch row %d] token ids (%zu toks): %s\n", b,
+              rows[(size_t)b].size(), ids_debug(rows[(size_t)b]).c_str());
+
+    const int prompt_len = (int)prompt_ids.size();
+    const int max_positions = prompt_len + gen_toks;
+
+    Cis2BatchWorkspace bws;
+    bws.alloc(model, B, max_positions);
+
+    std::vector<Cis2Sha256> witness(B);
+    for (int b = 0; b < B; ++b) {
+      witness[(size_t)b].update(weights_sha, 32);
+      witness[(size_t)b].update(tokenizer_sha, 32);
+      witness[(size_t)b].update(config_sha, 32);
+      witness[(size_t)b].update(table_dig, 32);
+      witness[(size_t)b].update(model.inv_freq_table_digest, 32);
+      for (size_t i = 0; i < rows[(size_t)b].size(); ++i)
+        witness[(size_t)b].update_u32le(rows[(size_t)b][i]);
+    }
+    std::vector<std::vector<uint32_t>> all_token_ids = rows;
+    std::vector<float> logits_batch((size_t)B * (size_t)model.vocab);
+    std::vector<uint32_t> step_ids(B);
+
+    // Prefill: every prompt position, populating each row's own KV cache.
+    for (int pos = 0; pos < prompt_len; ++pos) {
+      for (int b = 0; b < B; ++b) step_ids[(size_t)b] = rows[(size_t)b][(size_t)pos];
+      cis2_forward_token_batch(model, bws, pos, step_ids.data());
+    }
+    cis2_download(logits_batch.data(), bws.logits, (size_t)B * (size_t)model.vocab);
+
+    for (int step = 0; step < gen_toks; ++step) {
+      for (int b = 0; b < B; ++b) {
+        const float *row_logits = logits_batch.data() + (size_t)b * (size_t)model.vocab;
+        uint32_t next_id = cis2_argmax(row_logits, model.vocab);
+        for (int i = 0; i < model.vocab; ++i)
+          witness[(size_t)b].update_u32le(cis2_f32_bits(row_logits[(size_t)i]));
+        witness[(size_t)b].update_u32le(next_id);
+        all_token_ids[(size_t)b].push_back(next_id);
+        step_ids[(size_t)b] = next_id;
+      }
+      int pos = prompt_len + step;
+      cis2_forward_token_batch(model, bws, pos, step_ids.data());
+      cis2_download(logits_batch.data(), bws.logits, (size_t)B * (size_t)model.vocab);
+      fprintf(stderr, "[batch B=%d] step %d: token_ids=%s\n", B, step,
+              ids_debug(step_ids).c_str());
+    }
+
+    bws.free_all();
+
+    printf("==== gpu-3 --batch %d whole-model row-batch result ====\n", B);
+    int rc = 0;
+    for (int b = 0; b < B; ++b) {
+      unsigned char wdig[32];
+      witness[(size_t)b].finalize(wdig);
+      Cis2Sha256 ah;
+      for (size_t i = 0; i < all_token_ids[(size_t)b].size(); ++i)
+        ah.update_u32le(all_token_ids[(size_t)b][i]);
+      unsigned char adig[32];
+      ah.finalize(adig);
+      std::string wdig_hex = cis2_hex(wdig, 32);
+      std::string adig_hex = cis2_hex(adig, 32);
+
+      Cis2RowDigest standalone = cis2_run_standalone(
+          model, weights_sha, tokenizer_sha, config_sha, table_dig,
+          rows[(size_t)b], gen_toks);
+      std::string standalone_wdig_hex = cis2_hex(standalone.witness, 32);
+      std::string standalone_adig_hex = cis2_hex(standalone.argmax, 32);
+
+      bool vs_standalone_match = (wdig_hex == standalone_wdig_hex) &&
+                                  (adig_hex == standalone_adig_hex);
+      printf("row=%d prompt_tokens=%s batched_witness_digest=%s "
+             "batched_argmax_digest=%s\n",
+             b, ids_debug(rows[(size_t)b]).c_str(), wdig_hex.c_str(), adig_hex.c_str());
+      printf("row=%d standalone_batch1_witness_digest=%s standalone_batch1_argmax_digest=%s\n",
+             b, standalone_wdig_hex.c_str(), standalone_adig_hex.c_str());
+      printf("row=%d vs_standalone_batch1: %s\n", b,
+             vs_standalone_match ? "MATCH" : "MISMATCH");
+      if (!vs_standalone_match) rc = 1;
+
+      if (b == 0) {
+        bool vs_pinned_match = (standalone_wdig_hex == CIS2_PINNED_ROW0_DIGEST);
+        printf("row=0 vs_pinned_EXPECTED_DIGESTS_sequential_16 (%s): standalone_batch1 %s\n",
+               CIS2_PINNED_ROW0_DIGEST,
+               vs_pinned_match ? "MATCH" : "MISMATCH");
+        bool vs_pinned_batched_match = (wdig_hex == CIS2_PINNED_ROW0_DIGEST);
+        printf("row=0 vs_pinned_EXPECTED_DIGESTS_sequential_16 (%s): batched %s\n",
+               CIS2_PINNED_ROW0_DIGEST,
+               vs_pinned_batched_match ? "MATCH" : "MISMATCH");
+        if (!vs_pinned_match || !vs_pinned_batched_match) rc = 1;
+      }
+    }
+    printf("==== gpu-3 --batch %d: %s ====\n", B, rc == 0 ? "PASS" : "MISMATCH FOUND");
+    return rc;
+  }
+
   Cis2Workspace ws;
   ws.alloc(model, (int)prompt_ids.size() + gen_toks);
 
