+inline void cis2_forward_token_batch(const Cis2Model &m, Cis2BatchWorkspace &bws,
+                                     int pos, const uint32_t *token_ids) {
+  const int B = bws.B;
+  const int hidden = m.hidden;
+  const int head_dim = m.head_dim;
+  const int n_heads = m.n_heads;
+  const int group = m.n_heads / m.n_kv_heads;
+  const int kvd = m.kv_dim();
+  const int inter = m.inter;
+  const int max_pos = bws.max_pos;
+  const float scale = cis2_rsqrt_cr((float)head_dim);
+
+  for (int b = 0; b < B; ++b)
+    cis2_k_embed(m.embed_tokens, (int)token_ids[b], hidden, bws.h + (size_t)b * hidden);
+
+  for (int li = 0; li < m.n_layers; ++li) {
+    const Cis2Layer &L = m.layers[(size_t)li];
+
+    for (int b = 0; b < B; ++b)
+      cis2_rmsnorm(bws.h + (size_t)b * hidden, L.input_layernorm, m.eps, hidden,
+                   bws.sq, bws.red, bws.ln + (size_t)b * hidden);
+
+    cis2_k_matmul_batched(B, hidden, hidden, bws.ln, L.q_proj, bws.q);
+    cis2_k_matmul_batched(B, kvd, hidden, bws.ln, L.k_proj, bws.k);
+    cis2_k_matmul_batched(B, kvd, hidden, bws.ln, L.v_proj, bws.v);
+    for (int b = 0; b < B; ++b) {
+      cis2_k_add_bias(bws.q + (size_t)b * hidden, L.q_bias, hidden);
+      cis2_k_add_bias(bws.k + (size_t)b * kvd, L.k_bias, kvd);
+      cis2_k_add_bias(bws.v + (size_t)b * kvd, L.v_bias, kvd);
+    }
+
+    for (int b = 0; b < B; ++b) {
+      cis2_k_rope(bws.q + (size_t)b * hidden, n_heads, head_dim, pos, m.inv_freq);
+      cis2_k_rope(bws.k + (size_t)b * kvd, m.n_kv_heads, head_dim, pos, m.inv_freq);
+    }
+
+    for (int b = 0; b < B; ++b) {
+      float *kc = bws.kcache[(size_t)b * (size_t)m.n_layers + (size_t)li];
+      float *vc = bws.vcache[(size_t)b * (size_t)m.n_layers + (size_t)li];
+      cis2_k_store_kv(bws.k + (size_t)b * kvd, kc, kvd, pos);
+      cis2_k_store_kv(bws.v + (size_t)b * kvd, vc, kvd, pos);
+      cis2_k_scores(bws.q + (size_t)b * hidden, kc, n_heads, group, head_dim, kvd,
+                    pos, scale, bws.scores + (size_t)b * n_heads * max_pos);
+      cis2_k_softmax(bws.scores + (size_t)b * n_heads * max_pos, n_heads, pos);
+      cis2_k_attn_weighted_sum(bws.scores + (size_t)b * n_heads * max_pos, vc,
+                               n_heads, group, head_dim, kvd, pos,
+                               bws.attn_out + (size_t)b * hidden);
+    }
+
+    cis2_k_matmul_batched(B, hidden, hidden, bws.attn_out, L.o_proj, bws.o);
+    for (int b = 0; b < B; ++b)
+      cis2_k_add(bws.h + (size_t)b * hidden, bws.o + (size_t)b * hidden, hidden,
+                bws.h2 + (size_t)b * hidden);
+    { float *t = bws.h; bws.h = bws.h2; bws.h2 = t; }
+
+    for (int b = 0; b < B; ++b)
+      cis2_rmsnorm(bws.h + (size_t)b * hidden, L.post_attention_layernorm, m.eps,
+                   hidden, bws.sq, bws.red, bws.ln + (size_t)b * hidden);
+
+    cis2_k_matmul_batched(B, inter, hidden, bws.ln, L.gate_proj, bws.gate);
+    cis2_k_matmul_batched(B, inter, hidden, bws.ln, L.up_proj, bws.up);
+    for (int b = 0; b < B; ++b)
+      cis2_k_silu_mul(bws.gate + (size_t)b * inter, bws.up + (size_t)b * inter,
+                      inter, bws.hid + (size_t)b * inter);
+
+    cis2_k_matmul_batched(B, hidden, inter, bws.hid, L.down_proj, bws.down);
+    for (int b = 0; b < B; ++b)
+      cis2_k_add(bws.h + (size_t)b * hidden, bws.down + (size_t)b * hidden, hidden,
+                bws.h2 + (size_t)b * hidden);
+    { float *t = bws.h; bws.h = bws.h2; bws.h2 = t; }
+  }
+
+  for (int b = 0; b < B; ++b)
