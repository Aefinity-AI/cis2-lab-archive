@@ -0,0 +1,821 @@
+//! CIS-2 E23 — pinned-RNG deterministic sampled decode. See
+//! `docs/design/CIS2_SAMPLING_DESIGN.md` for the full design memo; this
+//! module is the literal implementation of that document's §2-4. Additive
+//! to the greedy-argmax path in `main.rs` — nothing here is called unless
+//! `--mode sampled` is passed, and the greedy `CIS2_REF` digest is
+//! untouched.
+//!
+//! Discipline carried over from `math.rs`: strict left-to-right sequential
+//! accumulation (no pairwise/tree reduction), no fused multiply-add call
+//! anywhere (the `no_fma_gate.sh` grep gate covers this file too), no host
+//! `pow`/`powf`.
+//! The only new primitive here (`rng_word`/`uniform01`) is pure integer
+//! arithmetic plus a single correctly-rounded `f64` multiply — see design
+//! memo §3 for why that stays cross-ISA-safe.
+
+use crate::math::{exp_pinned, sum_seq};
+
+const GOLDEN: u64 = 0x9E37_79B9_7F4A_7C15;
+
+/// One splitmix64 mixing round (Vigna 2015, public domain).
+#[inline]
+fn splitmix64_round(x: u64) -> u64 {
+    let mut z = x.wrapping_add(GOLDEN);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+/// Design memo §2 — counter-based: the random word for decode step
+/// `position` is a pure function of `(seed, position)`, reproducible
+/// without replaying any other step.
+#[inline]
+pub fn rng_word(seed: u64, position: u64) -> u64 {
+    let mixed_position = splitmix64_round(position);
+    splitmix64_round(seed ^ mixed_position)
+}
+
+/// Design memo §3 — top 53 bits of the word, scaled into `[0, 1)`. Exact
+/// `u64 -> f64` cast (53 bits fits an f64 mantissa exactly) then a single
+/// correctly-rounded `f64` multiply — no FMA.
+#[inline]
+pub fn uniform01(word: u64) -> f64 {
+    ((word >> 11) as f64) * (1.0f64 / (1u64 << 53) as f64)
+}
+
+/// Design memo §4. `logits` is the raw fp32 model output (pre-scale,
+/// pre-softmax) for the current step, `vocab` entries. Returns the sampled
+/// `next_token_id`. `temperature` must be > 0 (caller's job — `--mode
+/// greedy` is the degenerate-temperature path and is handled separately in
+/// `main.rs`, not here).
+pub fn sample_pinned(logits: &[f32], temperature: f32, top_p: f32, seed: u64, position: u64) -> u32 {
+    assert!(temperature > 0.0, "sample_pinned: temperature must be > 0");
+    assert!(
+        top_p > 0.0 && top_p <= 1.0,
+        "sample_pinned: top_p must be in (0, 1]"
+    );
+
+    // Step 1: temperature scale (sequential, index order, no FMA).
+    let mut scaled: Vec<f32> = Vec::with_capacity(logits.len());
+    for &v in logits {
+        scaled.push(v / temperature);
+    }
+
+    // Step 2: softmax — same pinned construction as the greedy path
+    // (max-subtract, exp_pinned, sum_seq, divide). Inlined here rather
+    // than calling math::softmax_seq so this function owns its own copy
+    // of `scaled` without an extra clone; identical arithmetic.
+    let mut max_v = scaled[0];
+    for &v in &scaled[1..] {
+        if v > max_v {
+            max_v = v;
+        }
+    }
+    for v in scaled.iter_mut() {
+        *v = exp_pinned(*v - max_v);
+    }
+    let denom = sum_seq(&scaled);
+    for v in scaled.iter_mut() {
+        *v = *v / denom;
+    }
+    let probs = scaled; // now normalized probabilities, still index order
+
+    // Step 3: pinned order — sort by probability descending, ties broken
+    // by index ascending, via an explicit composite comparator so the
+    // result does not depend on the sort algorithm's stability.
+    let mut order: Vec<u32> = (0..probs.len() as u32).collect();
+    order.sort_by(|&a, &b| {
+        probs[b as usize]
+            .partial_cmp(&probs[a as usize])
+            .expect("logits must not be NaN")
+            .then(a.cmp(&b))
+    });
+
+    // Step 4: nucleus selection — sequential f32 accumulation over the
+    // pinned order until cum >= top_p.
+    let mut cum = 0.0f32;
+    let mut nucleus_len = order.len();
+    for (i, &idx) in order.iter().enumerate() {
+        cum = cum + probs[idx as usize];
+        if cum >= top_p {
+            nucleus_len = i + 1;
+            break;
+        }
+    }
+    let nucleus = &order[..nucleus_len];
+
+    // Step 5: renormalize — clean sequential sum over just the nucleus.
+    let mut total = 0.0f32;
+    for &idx in nucleus {
+        total = total + probs[idx as usize];
+    }
+
+    // Step 6: draw and select.
+    let u = uniform01(rng_word(seed, position));
+    let mut cdf = 0.0f32;
+    for &idx in nucleus {
+        let p = probs[idx as usize] / total;
+        cdf = cdf + p;
+        if (cdf as f64) > u {
+            return idx;
+        }
+    }
+    // Rounding guard: renormalized cdf landed a few ULP under 1.0 before
+    // crossing `u`. Never fall off the end — take the last nucleus member,
+    // mirroring the argmax scan's own "never leave best_idx unset" shape.
+    *nucleus.last().expect("nucleus must be non-empty (top_p > 0)")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rng_word_is_deterministic_and_position_sensitive() {
+        let a = rng_word(42, 0);
+        let b = rng_word(42, 0);
+        assert_eq!(a, b, "same (seed, position) must reproduce the same word");
+        let c = rng_word(42, 1);
+        assert_ne!(a, c, "different position must (overwhelmingly likely) differ");
+        let d = rng_word(43, 0);
+        assert_ne!(a, d, "different seed must (overwhelmingly likely) differ");
+    }
+
+    #[test]
+    fn rng_word_is_position_addressable_not_sequential() {
+        // Design memo §1's whole point: step 5's word must not depend on
+        // having computed steps 0..4 first.
+        let direct = rng_word(7, 5);
+        // simulate "replaying" steps 0..=5 and only keeping the last —
+        // rng_word ignores everything but its own (seed, position) args,
+        // so this is trivially true by construction, but assert it anyway
+        // as a regression guard against someone later threading hidden
+        // state through.
+        for p in 0..5u64 {
+            let _ = rng_word(7, p);
+        }
+        assert_eq!(direct, rng_word(7, 5));
+    }
+
+    #[test]
+    fn uniform01_is_in_unit_interval() {
+        for seed in [0u64, 1, 42, u64::MAX, 0x1234_5678_9abc_def0] {
+            for pos in 0..8u64 {
+                let u = uniform01(rng_word(seed, pos));
+                assert!((0.0..1.0).contains(&u), "u={u} out of [0,1)");
+            }
+        }
+    }
+
+    #[test]
+    fn sample_pinned_is_deterministic_same_seed_position() {
+        let logits: Vec<f32> = (0..64).map(|i| (i as f32) * 0.01).collect();
+        let a = sample_pinned(&logits, 0.8, 0.95, 123, 0);
+        let b = sample_pinned(&logits, 0.8, 0.95, 123, 0);
+        assert_eq!(a, b);
+    }
+
+    #[test]
+    fn sample_pinned_top_p_near_zero_picks_argmax() {
+        // A tiny top_p forces the nucleus down to (usually) just the top
+        // token, since the first pinned-order element alone must already
+        // reach cum >= top_p for any top_p small enough. With nucleus =
+        // {argmax}, the draw is forced regardless of u.
+        let mut logits = vec![0.0f32; 32];
+        logits[7] = 50.0; // dominant logit -> softmax prob ~1.0 at idx 7
+        let picked = sample_pinned(&logits, 1.0, 1e-6, 999, 3);
+        assert_eq!(picked, 7);
+    }
+
+    #[test]
+    fn sample_pinned_top_p_one_never_panics_and_stays_in_range() {
+        let logits: Vec<f32> = (0..128).map(|i| ((i * 37) % 17) as f32 * 0.3).collect();
+        for seed in 0..16u64 {
+            let picked = sample_pinned(&logits, 0.8, 1.0, seed, seed);
+            assert!((picked as usize) < logits.len());
+        }
+    }
+
+    #[test]
+    fn pinned_order_tie_break_is_index_ascending() {
+        // Four equal-probability logits (all zero -> uniform softmax).
+        // top_p small enough that only the FIRST pinned-order element
+        // survives the nucleus; the tie-break must pick index 0, not
+        // whatever order an unstable sort would otherwise return.
+        let logits = vec![0.0f32; 4];
+        let picked = sample_pinned(&logits, 1.0, 1e-6, 0, 0);
+        assert_eq!(picked, 0, "tie-break must be index-ascending");
+    }
+}
+
+// ============================================================================
+// Moat-2: tamper-selftest for sampling receipts
+// ============================================================================
+//
+// Design memo §5: a sampled-mode receipt binds seed, temperature, top_p into
+// the witness digest BEFORE any per-step loop. This test constructs valid
+// receipts and a battery of 30+ structured corruption attacks (wrong seed,
+// tampered logits, truncated nucleus, PRNG substitution, mode-downgrade,
+// off-by-one CDF boundaries), verifying each is REJECTED by a receipt verifier
+// with a specific, correct error. Plus confirm a known-good receipt is still
+// accepted.
+//
+// The test does NOT verify the full forward-pass or model numerics — it is
+// purely about receipt integrity. Logits are synthetic; only the sampling
+// path (sample_pinned + witness construction) is exercised.
+
+#[cfg(test)]
+mod tamper_selftest {
+    use super::*;
+    use sha2::{Digest, Sha256};
+
+    /// Mock receipt structure: the witness chain components that a verifier
+    /// would use to check a receipt. This is a subset of what main.rs prints,
+    /// focused purely on the sampling parameters and per-step data.
+    struct SamplingReceipt {
+        seed: u64,
+        temperature: f32,
+        top_p: f32,
+        weights_sha256: [u8; 32],
+        tokenizer_sha256: [u8; 32],
+        config_sha256: [u8; 32],
+        table_digest: [u8; 32],
+        inv_freq_table_digest: [u8; 32],
+        prompt_ids: Vec<u32>,
+        // Per-step data: (logits, next_token_id)
+        steps: Vec<(Vec<f32>, u32)>,
+        // Expected witness digest (the receipt's claimed digest)
+        witness_digest: [u8; 32],
+    }
+
+    /// Compute the witness digest for a receipt, following design memo §5
+    /// and main.rs lines 619-709 exactly.
+    fn compute_witness_digest(
+        seed: u64,
+        temperature: f32,
+        top_p: f32,
+        weights_sha256: [u8; 32],
+        tokenizer_sha256: [u8; 32],
+        config_sha256: [u8; 32],
+        table_digest: [u8; 32],
+        inv_freq_table_digest: [u8; 32],
+        prompt_ids: &[u32],
+        steps: &[(Vec<f32>, u32)],
+    ) -> [u8; 32] {
+        let mut witness = Sha256::new();
+
+        // Domain-separation tag + sampling parameters (design memo §5)
+        witness.update(b"CIS2_SAMPLE_V1");
+        witness.update(seed.to_le_bytes());
+        witness.update(temperature.to_bits().to_le_bytes());
+        witness.update(top_p.to_bits().to_le_bytes());
+
+        // Artifact digests (main.rs lines 625-629)
+        witness.update(weights_sha256);
+        witness.update(tokenizer_sha256);
+        witness.update(config_sha256);
+        witness.update(table_digest);
+        witness.update(inv_freq_table_digest);
+
+        // Prompt token IDs (main.rs lines 630-631)
+        for &t in prompt_ids {
+            witness.update(t.to_le_bytes());
+        }
+
+        // Per-step loop: logits (f32 bits LE) + next_id (u32 LE)
+        // (main.rs lines 701-709)
+        for (logits, next_id) in steps {
+            let mut step_bytes = Vec::with_capacity(logits.len() * 4);
+            for &v in logits {
+                step_bytes.extend_from_slice(&v.to_bits().to_le_bytes());
+            }
+            witness.update(&step_bytes);
+            witness.update(next_id.to_le_bytes());
+        }
+
+        witness.finalize().into()
+    }
+
+    /// Verify a receipt's witness digest. Returns (is_valid, error_msg).
+    /// If is_valid is false, error_msg describes what was wrong.
+    fn verify_receipt(receipt: &SamplingReceipt) -> (bool, String) {
+        let computed = compute_witness_digest(
+            receipt.seed,
+            receipt.temperature,
+            receipt.top_p,
+            receipt.weights_sha256,
+            receipt.tokenizer_sha256,
+            receipt.config_sha256,
+            receipt.table_digest,
+            receipt.inv_freq_table_digest,
+            &receipt.prompt_ids,
+            &receipt.steps,
+        );
+
+        if computed == receipt.witness_digest {
+            (true, "OK".to_string())
+        } else {
+            (
+                false,
+                format!(
+                    "witness mismatch: expected {}, got {}",
+                    hex::encode(receipt.witness_digest),
+                    hex::encode(computed)
+                ),
+            )
+        }
+    }
+
+    // Tiny hex encoder for error messages
+    mod hex {
+        pub fn encode(bytes: impl AsRef<[u8]>) -> String {
+            let mut s = String::new();
+            for b in bytes.as_ref() {
+                s.push_str(&format!("{:02x}", b));
+            }
+            s
+        }
+    }
