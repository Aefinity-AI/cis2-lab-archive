+        // This simulates a subtle off-by-one in the CDF boundary check.
+        // In the real sampling code, if (cdf as f64) > u, select i.
+        // A verifier would detect if someone used >= instead (both logits
+        // and token change). We can't easily test this without re-implementing
+        // sample_pinned, but we can test that any token change is caught.
+        let mut receipt = make_valid_receipt();
+        if let Some((_, token_id)) = receipt.steps.get_mut(0) {
+            *token_id = (*token_id + 1) % 256; // simulate a different token
+        }
