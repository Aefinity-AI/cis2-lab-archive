+name: E23 cross-ISA CIS-2 pinned sampling
+
+on:
+  push:
+    branches: [cm/e23-pinned-sampling]
+  workflow_dispatch: {}
+
+env:
+  # Pre-registered on penguin (x86_64), two independent process runs,
+  # bit-identical (see docs/E23_SAMPLING_RESULT.md). --mode sampled
+  # --seed 12345 --temperature 0.8 --top-p 0.95 --gen-toks 16.
+  TARGET_SAMPLE_DIGEST: c8c1d5a69696aff092d46b0a80f0d2575f49191128185fdd0422282578f04d33
+
+jobs:
+  run:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-latest
+            arch_label: x86_64
+          - os: ubuntu-24.04-arm
+            arch_label: aarch64
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: uname (assert matches expected arch)
+        run: |
+          U=$(uname -m)
+          echo "uname -m = $U"
+          if [ "${{ matrix.arch_label }}" = "x86_64" ]; then
+            [ "$U" = "x86_64" ] || { echo "expected x86_64, got $U"; exit 1; }
+          else
+            [ "$U" = "aarch64" ] || { echo "expected aarch64, got $U"; exit 1; }
+          fi
+
+      - name: Install Rust
+        run: |
+          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
+          echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"
+
+      - name: rustc version
+        run: rustc -V
+
+      - name: Fetch SmolLM2-135M weights (public HF resolve, no auth)
+        run: |
+          mkdir -p weights
+          curl -sSf -L --retry 6 --retry-delay 10 --retry-all-errors -o weights/config.json     https://huggingface.co/HuggingFaceTB/SmolLM2-135M/resolve/main/config.json
+          curl -sSf -L --retry 6 --retry-delay 10 --retry-all-errors -o weights/tokenizer.json  https://huggingface.co/HuggingFaceTB/SmolLM2-135M/resolve/main/tokenizer.json
+          curl -sSf -L --retry 6 --retry-delay 10 --retry-all-errors -o weights/model.safetensors https://huggingface.co/HuggingFaceTB/SmolLM2-135M/resolve/main/model.safetensors
+          sha256sum weights/model.safetensors weights/config.json weights/tokenizer.json
+          echo "80521b40281d6ce74e35c9282c22539e75aa0ac8578892b2a59955ef78d55da1  weights/model.safetensors" | sha256sum -c - || { echo "weights download corrupt/empty"; exit 1; }
+
+      - name: cargo test --release (unit tests + FMA grep gate)
+        run: cargo test --release
+
+      - name: no_fma_gate.sh
+        run: ./scripts/no_fma_gate.sh
+
+      - name: Build release
+        run: cargo build --release
+
+      - name: Run sampled decode, assert digest matches pre-registered target
+        run: |
+          OUT=$(nice -n 10 ./target/release/cis2_ref --mode sampled --seed 12345 --temperature 0.8 --top-p 0.95 --gen-toks 16 2>&1)
+          echo "$OUT"
+          LINE=$(echo "$OUT" | grep -E '^CIS2_SAMPLE digest=' | head -1)
+          DIGEST=$(echo "$LINE" | sed -n 's/.*digest=\([0-9a-f]*\).*/\1/p')
+          RUNS_IDENTICAL=$(echo "$OUT" | grep -E '^prompt_idx=0 runs_identical=' | sed -n 's/.*runs_identical=\(.*\)/\1/p')
+          echo "got digest=$DIGEST target=$TARGET_SAMPLE_DIGEST"
+          echo "got runs_identical=$RUNS_IDENTICAL"
+          if [ "$RUNS_IDENTICAL" != "true" ]; then
+            echo "FAIL: in-process run1/run2 were not bit-identical on ${{ matrix.arch_label }}"
+            exit 1
+          fi
+          if [ "$DIGEST" != "$TARGET_SAMPLE_DIGEST" ]; then
+            echo "MISMATCH: CIS2_SAMPLE digest does not match pre-registered target on ${{ matrix.arch_label }}"
+            exit 1
+          fi
+          echo "PASS on ${{ matrix.arch_label }}: sampled-decode digest matches pre-registered target"
