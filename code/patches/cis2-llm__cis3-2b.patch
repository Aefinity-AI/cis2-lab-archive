+{
+  "name": "eu-ai-act",
+  "title": "EU AI Act (Regulation (EU) 2024/1689) — Art. 12/13/14/15 record-keeping slice",
+  "description": "Vectors that produce evidence relevant to Art. 12 (logging), 13 (transparency), 14 (human oversight), 15 (accuracy/robustness/consistency), scoped strictly to the record-keeping/reproducibility slice CIS-2 actually covers. See compliance/CROSSWALK.md rows 1-9 for the full honest coverage table this profile is a machine-checkable subset of.",
+  "vectors": [
+    {
+      "id": "receipt_schema",
+      "crosswalk_control": "CROSSWALK.md row 1 (Art. 12(1) automatic event logging)",
+      "rationale": "A schema-valid receipt with a witness digest is the concrete artifact that IS the 'automatic recording of events' Art. 12(1) asks for, for the model-execution slice."
+    },
+    {
+      "id": "chain_integrity",
+      "crosswalk_control": "CROSSWALK.md row 1 (Art. 12(1)) and row 2 (Art. 12(2) risk/incident identification)",
+      "rationale": "Hash-chained, independently re-verifiable logs are what makes the log tamper-evident, which is what makes it usable for post-hoc risk/incident review (Art. 12(2))."
+    },
+    {
+      "id": "replay_tamper",
+      "crosswalk_control": "CROSSWALK.md row 2 (Art. 12(2)) and row 6 (Art. 15(1) consistent performance)",
+      "rationale": "A digest mismatch on replay/tamper is the concrete 'risk situation' detection signal cited in row 2, and demonstrates the log's tamper-evidence supporting Art. 15's consistency claim."
+    },
+    {
+      "id": "wrong_model_binding",
+      "crosswalk_control": "CROSSWALK.md row 1 (Art. 12(1)) — binding of the log entry to the system that produced it",
+      "rationale": "Art. 12 logging is only meaningful if the record can be shown to bind to the actual model instance that ran. NOT COVERED by the current v0.1 scaffold — see vector detail."
+    },
+    {
