@@ -0,0 +1,69 @@
+"""Config-driven tool allow/deny list for gateway/gateway.py (cis3-2b).
+
+Loads gateway/tools.yaml once (cached) and exposes `is_allowed(tool)`.
+Fails closed on any loading/parsing problem: if the policy file is
+missing, malformed, or unreadable, every tool is denied rather than every
+tool being silently allowed -- consistent with the rest of the gateway's
+fail-closed posture (gateway/README.md).
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+DEFAULT_POLICY_PATH = Path(__file__).resolve().parent / "tools.yaml"
+
+
+class ToolPolicy:
+    def __init__(self, path: str | Path = DEFAULT_POLICY_PATH):
+        self.path = Path(path)
+        self._mode: str = "allow_list"
+        self._allow: set[str] = set()
+        self._deny: set[str] = set()
+        self._load_error: str | None = None
+        self._load()
+
+    def _load(self) -> None:
+        try:
+            raw: Any = yaml.safe_load(self.path.read_text())
+            if not isinstance(raw, dict):
+                raise ValueError(f"tools.yaml must be a mapping, got {type(raw).__name__}")
+            mode = raw.get("mode", "allow_list")
+            if mode not in ("allow_list", "deny_list"):
+                raise ValueError(f"unknown mode {mode!r}, expected allow_list or deny_list")
+            self._mode = mode
+            self._allow = set(raw.get("allow") or [])
+            self._deny = set(raw.get("deny") or [])
+        except Exception as e:  # fail closed: bad config -> deny everything
+            self._load_error = f"failed to load tool policy from {self.path}: {e!r}"
+            self._mode = "allow_list"
+            self._allow = set()
+            self._deny = set()
+
+    def is_allowed(self, tool: str) -> tuple[bool, str]:
+        """Returns (allowed, reason). reason is always populated -- either
+        why it's allowed, or why it's denied."""
+        if self._load_error:
+            return False, self._load_error
+        if not tool or not isinstance(tool, str):
+            return False, "missing or non-string tool name"
+        if self._mode == "allow_list":
+            if tool in self._allow:
+                return True, f"tool {tool!r} is on the allow list"
+            return False, f"tool {tool!r} is not on the allow list (tools.yaml mode=allow_list)"
+        # deny_list mode
+        if tool in self._deny:
+            return False, f"tool {tool!r} is on the deny list"
+        return True, f"tool {tool!r} is not on the deny list (tools.yaml mode=deny_list)"
+
+
+_default_policy: ToolPolicy | None = None
+
+
+def default_policy() -> ToolPolicy:
+    global _default_policy
+    if _default_policy is None:
+        _default_policy = ToolPolicy()
+    return _default_policy
