+# The gateway checks the `tool` name a caller submits against this policy
+# BEFORE (in addition to) the receipt verify_fn check -- a tool name that
+# isn't explicitly allowed is DENYed regardless of how good the receipt is.
+# See gateway/tool_policy.py for the loader/matcher and
+# gateway/gateway.py's Gateway.submit() for where this is enforced.
+#
+# Format:
+#   mode: allow_list   # only `allow` entries are permitted, everything else DENYs
+#     - or -
+#   mode: deny_list     # only `deny` entries are refused, everything else is allowed
+#
+# This repo ships allow_list mode: fail-closed by default (an unlisted tool
+# is refused, not silently permitted), consistent with the rest of the
+# gateway's fail-closed posture (see gateway/README.md).
+
+mode: allow_list
+
+allow:
+  - toolA
+  - conf-tool
+  - read_file
+  - search
+
+deny: []
