+// w6 scoring-mode patch: compile-time exp substitution for the libm-hazard
+// lab. Default build (no define) is the pinned polynomial, unchanged. Host
+// builds only; every call site of cis2_exp_pinned (softmax, SiLU, RoPE table)
+// goes through the substitution.
+#if defined(CIS2_W6_EXP_GLIBC) && defined(CIS2_W6_EXP_CORE)
+#error "CIS2_W6_EXP_GLIBC and CIS2_W6_EXP_CORE are exclusive"
+#endif
+#if defined(CIS2_W6_EXP_GLIBC) || defined(CIS2_W6_EXP_CORE)
+#ifdef __CUDACC__
+#error "w6 exp substitution is a host-only build"
+#endif
+#include <math.h>
+extern "C" float cr_expf(float);
+#endif
+
 CIS2_FN inline float cis2_exp_pinned(float x) {
+#if defined(CIS2_W6_EXP_GLIBC)
+  return expf(x);
+#elif defined(CIS2_W6_EXP_CORE)
+  return cr_expf(x);
+#endif
